  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">RumbleServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Ragdoll Rumble server: lobby -> match (rounds) -> results -> lobby.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Maps = require(Shared:WaitForChild("Maps"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Arena = require(script:WaitForChild("Arena"))
local Combat = require(script:WaitForChild("Combat"))
local Bots = require(script:WaitForChild("Bots"))
local Data = require(script:WaitForChild("Data"))
local Crates = require(script:WaitForChild("Crates"))
local Admin = require(script:WaitForChild("Admin"))
local Lobby = require(script:WaitForChild("Lobby"))
local Spawner = require(script:WaitForChild("Spawner"))

Players.CharacterAutoLoads = false
workspace.Gravity = Config.GRAVITY

local Event = Remotes.Event
local State = Remotes.State
local Request = Remotes.Request

local rng = Util.rng(os.time())

local function now(): number
	return workspace:GetServerTimeNow()
end

local function sendAll(msg: any)
	Event:FireAllClients(msg)
end

-------------------------------------------------------------------------------
-- participants

type Entry = {
	fid: number,
	player: Player?,
	name: string,
	colorIndex: number,
	isBot: boolean,
	isDummy: boolean,
	sparring: boolean,
	loaded: boolean,
	inMatch: boolean,
	wins: number,
	kills: number,
	finisher: string,
	spawnFx: string,
	home: Vector3?,
}

local entries: { [number]: Entry } = {}
local byPlayer: { [Player]: Entry } = {}
local nextFid = 1

local function allocFid(): number
	for _ = 1, 255 do
		local id = nextFid
		nextFid = nextFid % 250 + 1
		if not entries[id] then
			return id
		end
	end
	error("out of fighter ids")
end

local function freeColor(): number
	local used = {}
	for _, e in entries do
		if not e.isDummy then
			used[e.colorIndex] = true
		end
	end
	for i = 1, #Config.COLORS do
		if not used[i] then
			return i
		end
	end
	return rng:int(1, #Config.COLORS)
end

local function randomCosmetic(kind: string): string
	local pool = {}
	for _, it in Cosmetics.ofKind(kind) do
		if it.rarity <= 3 then
			table.insert(pool, it.id)
		end
	end
	return pool[rng:int(1, #pool)]
end

local function newEntry(player: Player?, name: string, isBot: boolean, isDummy: boolean?): Entry
	local e: Entry = {
		fid = allocFid(),
		player = player,
		name = name,
		colorIndex = 0,
		isBot = isBot,
		isDummy = isDummy == true,
		sparring = false,
		loaded = isBot,
		inMatch = false,
		wins = 0,
		kills = 0,
		finisher = if isBot then randomCosmetic("finisher") else Cosmetics.DEFAULT.finisher,
		spawnFx = if isBot then randomCosmetic("spawn") else Cosmetics.DEFAULT.spawn,
		home = nil,
	}
	e.colorIndex = if isDummy then 8 else freeColor()
	entries[e.fid] = e
	if player then
		byPlayer[player] = e
	end
	return e
end

local function who(e: Entry): Spawner.Who
	return { fid = e.fid, name = e.name, colorIndex = e.colorIndex, player = e.player, isBot = e.isBot }
end

local function humans(): { Entry }
	local out = {}
	for _, e in entries do
		if not e.isBot and e.loaded and e.player and e.player.Parent then
			table.insert(out, e)
		end
	end
	return out
end

local function scoreTable(matchOnly: boolean?): { any }
	local out = {}
	for _, e in entries do
		if not e.isDummy and not e.sparring and (not matchOnly or e.inMatch) then
			table.insert(out, {
				fid = e.fid,
				name = e.name,
				color = e.colorIndex,
				wins = e.wins,
				kills = e.kills,
				bot = e.isBot,
				inMatch = e.inMatch,
				userId = if e.player then e.player.UserId else 0,
			})
		end
	end
	table.sort(out, function(a: any, b: any)
		return a.fid < b.fid
	end)
	return out
end

-------------------------------------------------------------------------------
-- state

local phase = "lobby" -- lobby | match | results
local phaseEnd = 0
local intermission = false
local roundState = "none" -- none | countdown | fight | roundEnd
local roundTimer = 0
local mapIndex = 0
local nextMap: number? = nil
local roundNumber = 0
local roundStart = now()
local fightTime = 0
local sdStart = math.huge
local suddenDeath = false
local nextWeaponAt = 0
local lastMaps: { number } = {}

local function setAttr(k: string, v: any)
	workspace:SetAttribute(k, v)
end

local function roundInfo(): any
	return {
		map = mapIndex,
		round = roundNumber,
		start = roundStart,
		fight = fightTime,
		state = roundState,
		phase = phase,
		suddenDeath = suddenDeath,
	}
end

local function spawnInLobby(e: Entry)
	local x, y = Lobby.spawnPoint()
	Spawner.spawn(who(e), "lobby", x, y, false)
end

-------------------------------------------------------------------------------
-- combat hooks

Combat.hooks.active = function(): boolean
	return phase ~= "lobby" and (roundState == "fight" or roundState == "roundEnd")
end

Combat.hooks.finisherOf = function(fid: number): string?
	local e = entries[fid]
	if not e then
		return nil
	end
	if e.player then
		return Data.equipped(e.player, "finisher")
	end
	return e.finisher
end

Combat.hooks.onDeath = function(f: Combat.F, killer: number, _cause: string)
	local ke = entries[killer]
	if f.zone == "arena" and phase == "match" then
		if ke and killer ~= f.fid then
			ke.kills += 1
			if ke.player then
				Data.addCoins(ke.player, Config.COINS_KO, "KO")
				Data.stat(ke.player, "kills", 1)
			end
		end
		return
	end
	-- lobby deaths respawn
	local e = entries[f.fid]
	if not e then
		return
	end
	if e.isDummy or e.sparring then
		task.delay(Config.DUMMY_RESPAWN, function()
			if entries[e.fid] == e and e.home then
				Spawner.spawn(who(e), "lobby", e.home.X, e.home.Y, false, true)
			end
		end)
	elseif e.player then
		task.delay(Config.LOBBY_RESPAWN, function()
			if entries[e.fid] == e and e.player and e.player.Parent then
				local cur = Combat.fighters[e.fid]
				if not cur or not cur.alive then
					spawnInLobby(e)
				end
			end
		end)
	end
end

Spawner.onSpawned = function(f: Combat.F)
	local e = entries[f.fid]
	if not e then
		return
	end
	if e.sparring then
		(f :: any).sparring = true
	end
	if f.zone == "arena" then
		local id = if e.player then Data.equipped(e.player, "spawn") else e.spawnFx
		task.delay(0.35, function()
			if f.model.Parent then
				local p = f.root.Position
				sendAll({ t = "SpawnFx", fid = f.fid, id = id, x = p.X, y = p.Y })
			end
		end)
	end
end

Crates.onRare = function(_player: Player, item: Cosmetics.Item)
	Lobby.celebrate(Cosmetics.rarity(item).color)
end

-------------------------------------------------------------------------------
-- bots

local function syncBots()
	local inMatch = 0
	for _, e in humans() do
		if e.inMatch or phase == "lobby" then
			inMatch += 1
		end
	end
	local want = if Config.BOTS_ENABLED then math.clamp(Config.TARGET_FIGHTERS - inMatch, 0, Config.MAX_FIGHTERS - inMatch) else 0
	local bots = {}
	for _, e in entries do
		if e.isBot and not e.isDummy and not e.sparring then
			table.insert(bots, e)
		end
	end
	while #bots > want do
		local e = table.remove(bots) :: Entry
		entries[e.fid] = nil
		Spawner.cancel(e.fid)
	end
	local used = {}
	for _, e in entries do
		used[e.name] = true
	end
	while #bots < want do
		local name = Config.BOT_NAMES[rng:int(1, #Config.BOT_NAMES)]
		for _ = 1, 12 do
			if not used[name] then
				break
			end
			name = Config.BOT_NAMES[rng:int(1, #Config.BOT_NAMES)]
		end
		used[name] = true
		table.insert(bots, newEntry(nil, name, true))
	end
end

-------------------------------------------------------------------------------
-- match flow

local function pickMap(): number
	if nextMap then
		local m = nextMap
		nextMap = nil
		return m
	end
	local n = #Maps.list
	for _ = 1, 30 do
		local i = rng:int(1, n)
		if not table.find(lastMaps, i) then
			table.insert(lastMaps, i)
			while #lastMaps > math.min(3, n - 1) do
				table.remove(lastMaps, 1)
			end
			return i
		end
	end
	return rng:int(1, n)
end

local endMatch: () -> ()

local function startRound()
	roundNumber += 1
	mapIndex = pickMap()
	local map = Maps.get(mapIndex)
	Combat.reset("arena")
	for _, f in Combat.fighters do
		if f.zone == "arena" then
			Combat.unregister(f.fid)
		end
	end
	Arena.build("arena", map)
	roundStart = now() + 0.2
	fightTime = roundStart + Config.LOAD_TIME + Config.COUNTDOWN
	sdStart = fightTime + Config.SUDDEN_DEATH_AT
	suddenDeath = false
	nextWeaponAt = fightTime + rng:range(1, 2.5)
	roundState = "countdown"
	setAttr("RoundStart", roundStart)
	setAttr("FightTime", fightTime)
	setAttr("MapIndex", mapIndex)
	setAttr("Round", roundNumber)
	setAttr("RoundState", roundState)
	setAttr("InkStart", 0)
	local spawns = Util.shuffle(table.clone(map.spawns), rng)
	local order = {}
	for _, e in entries do
		if e.inMatch and (e.isBot or (e.player and e.player.Parent)) then
			table.insert(order, e)
		end
	end
	table.sort(order, function(a: Entry, b: Entry)
		return a.fid < b.fid
	end)
	for i, e in order do
		if i > Config.MAX_FIGHTERS then
			break
		end
		local sp = spawns[((i - 1) % #spawns) + 1]
		Spawner.spawn(who(e), "arena", sp[1] + (if i > #spawns then rng:range(-2, 2) else 0), sp[2], true)
	end
	sendAll({ t = "RoundStart", info = roundInfo(), scores = scoreTable(true) })
end

local function startMatch(): (boolean, string?)
	if phase ~= "lobby" then
		return false, "a match is already running"
	end
	local hs = humans()
	if #hs == 0 then
		return false, "nobody to play"
	end
	phase = "match"
	intermission = false
	setAttr("Phase", phase)
	roundNumber = 0
	for _, e in entries do
		e.inMatch = false
		e.wins = 0
		e.kills = 0
	end
	for _, e in hs do
		e.inMatch = true
	end
	syncBots()
	for _, e in entries do
		if e.isBot and not e.isDummy and not e.sparring then
			e.inMatch = true
		end
	end
	sendAll({ t = "MatchStart" })
	startRound()
	return true, "match started"
end

local function endRound(winner: Combat.F?)
	if roundState == "roundEnd" then
		return
	end
	roundState = "roundEnd"
	roundTimer = Config.ROUND_END_DELAY
	setAttr("RoundState", roundState)
	local wfid = 0
	if winner then
		wfid = winner.fid
		local e = entries[wfid]
		if e then
			e.wins += 1
			if e.player then
				Data.addCoins(e.player, Config.COINS_ROUND_WIN, "Round win")
				Data.stat(e.player, "rounds", 1)
			end
		end
		winner.model:SetAttribute("Victory", true)
	end
	sendAll({ t = "RoundEnd", winner = wfid, scores = scoreTable(true) })
end

endMatch = function()
	if phase ~= "match" then
		return
	end
	phase = "results"
	phaseEnd = now() + Config.RESULTS_TIME
	roundState = "none"
	setAttr("Phase", phase)
	setAttr("PhaseEnd", phaseEnd)
	setAttr("RoundState", roundState)
	local list = {}
	for _, e in entries do
		if e.inMatch then
			table.insert(list, e)
		end
	end
	table.sort(list, function(a: Entry, b: Entry)
		if a.wins ~= b.wins then
			return a.wins > b.wins
		end
		return a.kills > b.kills
	end)
	local placements = {}
	for i, e in list do
		table.insert(placements, { fid = e.fid, name = e.name, color = e.colorIndex, wins = e.wins, kills = e.kills, userId = if e.player then e.player.UserId else 0, bot = e.isBot })
		if e.player and e.player.Parent then
			Data.addCoins(e.player, Config.COINS_PLAYED, "Match played")
			Data.stat(e.player, "matches", 1)
			if i == 1 and e.wins > 0 then
				Data.addCoins(e.player, Config.COINS_MATCH_WIN, "Match win!")
				Data.stat(e.player, "wins", 1)
			end
		end
	end
	sendAll({ t = "Results", placements = placements, ends = phaseEnd })
end

local function backToLobby()
	phase = "lobby"
	setAttr("Phase", phase)
	Combat.reset("arena")
	Arena.clear("arena")
	mapIndex = 0
	setAttr("MapIndex", 0)
	for _, e in entries do
		e.inMatch = false
		e.wins = 0
		e.kills = 0
	end
	for _, e in humans() do
		spawnInLobby(e)
	end
	intermission = false
	sendAll({ t = "Lobby", scores = scoreTable() })
end

-------------------------------------------------------------------------------
-- admin api

Admin.init({
	startMatch = startMatch,
	endMatch = function(): (boolean, string?)
		if phase ~= "match" then
			return false, "no match running"
		end
		endMatch()
		return true, "match ended"
	end,
	skipRound = function(): (boolean, string?)
		if phase ~= "match" or roundState == "roundEnd" then
			return false, "no round to skip"
		end
		endRound(nil)
		return true, "round skipped"
	end,
	setNextMap = function(i: number)
		nextMap = i
	end,
	suddenDeath = function(): (boolean, string?)
		if phase ~= "match" or roundState ~= "fight" then
			return false, "only during a fight"
		end
		sdStart = now()
		return true, "here comes the ink"
	end,
	setIntermission = function(sec: number): (boolean, string?)
		if phase ~= "lobby" then
			return false, "only in the lobby"
		end
		intermission = true
		phaseEnd = now() + sec
		setAttr("PhaseEnd", phaseEnd)
		return true, string.format("match starts in %ds", sec)
	end,
	syncBots = syncBots,
	spawnTestBot = function(player: Player): (boolean, string?)
		local f = Combat.forPlayer(player)
		if not f then
			return false, "spawn in first"
		end
		local name = Config.BOT_NAMES[rng:int(1, #Config.BOT_NAMES)] .. " (sparring)"
		local e = newEntry(nil, name, true, true)
		e.sparring = true
		e.colorIndex = freeColor()
		local p = f.root.Position
		e.home = Vector3.new(p.X + 8, p.Y - 3, 0)
		Spawner.spawn(who(e), f.zone, p.X + 8, p.Y - 3, false, true)
		return true, "spawned a sparring bot"
	end,
})

-------------------------------------------------------------------------------
-- remotes

local function fighterOf(player: Player): Combat.F?
	local e = byPlayer[player]
	if not e then
		return nil
	end
	local f = Combat.fighters[e.fid]
	if f and f.player == player and f.model == player.Character then
		return f
	end
	return nil
end

Event.OnServerEvent:Connect(function(player: Player, msg: any)
	if type(msg) ~= "table" or type(msg.t) ~= "string" then
		return
	end
	local e = byPlayer[player]
	if not e then
		return
	end
	if msg.t == "Ready" then
		Event:FireClient(player, {
			t = "Welcome",
			fid = e.fid,
			info = roundInfo(),
			scores = scoreTable(phase ~= "lobby"),
			isAdmin = Admin.isAdmin(player),
			profile = Data.public(player),
		})
		return
	end
	local f = fighterOf(player)
	if not f then
		return
	end
	if msg.t == "Act" then
		Combat.onAct(f, msg)
	elseif msg.t == "Hit" then
		Combat.onHit(f, msg)
	elseif msg.t == "Shoot" then
		Combat.onShoot(f, msg)
	elseif msg.t == "Launch" then
		Combat.onLaunch(f, msg)
	elseif msg.t == "Throw" then
		Combat.onThrow(f, msg)
	end
end)

State.OnServerEvent:Connect(function(player: Player, aimByte: any, flags: any)
	if type(aimByte) ~= "number" or type(flags) ~= "number" then
		return
	end
	local f = fighterOf(player)
	if f then
		Combat.onState(f, (math.clamp(aimByte, 0, 255) / 255) * 2 * math.pi - math.pi, math.floor(flags) % 256)
	end
end)

Request.OnServerInvoke = function(player: Player, kind: any, args: any): any
	if kind == "roll" then
		return Crates.roll(player, if type(args) == "table" then args.kind else "")
	elseif kind == "equip" then
		local ok, msg = Data.equip(player, if type(args) == "table" and type(args.id) == "string" then args.id else "")
		return { ok = ok, msg = msg }
	elseif kind == "ready" then
		Lobby.uiReady[player] = type(args) == "table" and args.on == true
		return { ok = true }
	elseif kind == "profile" then
		return { ok = true, profile = Data.public(player) }
	elseif kind == "admin" then
		if type(args) ~= "table" then
			return { ok = false, msg = "bad request" }
		end
		return Admin.handle(player, args.action, args.args)
	end
	return { ok = false, msg = "unknown request" }
end

-------------------------------------------------------------------------------
-- players

Players.PlayerAdded:Connect(function(player)
	local e = newEntry(player, player.DisplayName, false)
	player:SetAttribute("Admin", Admin.isAdmin(player))
	task.spawn(function()
		Data.load(player)
		if not player.Parent then
			return
		end
		e.loaded = true
		spawnInLobby(e)
		sendAll({ t = "Scores", scores = scoreTable(phase ~= "lobby") })
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	local e = byPlayer[player]
	byPlayer[player] = nil
	Data.release(player)
	if not e then
		return
	end
	entries[e.fid] = nil
	Spawner.cancel(e.fid)
	local f = Combat.fighters[e.fid]
	if f then
		Combat.unregister(e.fid)
		sendAll({ t = "Left", fid = e.fid })
	end
	sendAll({ t = "Scores", scores = scoreTable(phase ~= "lobby") })
end)

-------------------------------------------------------------------------------
-- boot

Lobby.build()
for i, d in Maps.lobby.stations.dummies do
	local e = newEntry(nil, "Dummy " .. i, true, true)
	e.home = Vector3.new(d[1], d[2], 0)
	Spawner.spawn(who(e), "lobby", d[1], d[2], false, true)
end
setAttr("Phase", phase)
setAttr("PhaseEnd", 0)
setAttr("RoundState", roundState)
setAttr("MapIndex", 0)

for _, p in Players:GetPlayers() do
	task.spawn(function()
		if not byPlayer[p] then
			local e = newEntry(p, p.DisplayName, false)
			p:SetAttribute("Admin", Admin.isAdmin(p))
			Data.load(p)
			e.loaded = true
			spawnInLobby(e)
		end
	end)
end

-------------------------------------------------------------------------------
-- main loop

local stateAcc = 0

local function broadcastStates()
	local list = {}
	for _, f in Combat.fighters do
		table.insert(list, f)
	end
	local b = buffer.create(1 + #list * 3)
	buffer.writeu8(b, 0, #list)
	for i, f in list do
		local o = 1 + (i - 1) * 3
		buffer.writeu8(b, o, f.fid)
		buffer.writeu8(b, o + 1, math.floor(((f.aim + math.pi) / (2 * math.pi)) * 255 + 0.5) % 256)
		buffer.writeu8(b, o + 2, (if f.blocking then 1 else 0) + (if f.crouch then 2 else 0))
	end
	State:FireAllClients(b)
end

RunService.Heartbeat:Connect(function(dt)
	local t = now()
	local motionT = t - roundStart
	Arena.update(motionT)
	Combat.update(dt, motionT)
	local frozenArena = roundState == "countdown" or phase == "results"
	for _, f in Combat.fighters do
		if f.brain then
			Bots.think(f, dt, f.zone == "arena" and frozenArena and not (f :: any).sparring)
		end
	end
	Lobby.update(dt)

	if phase == "lobby" then
		local hs = humans()
		local readyCount = 0
		for _, e in hs do
			if e.player and Lobby.ready[e.player] then
				readyCount += 1
			end
		end
		setAttr("ReadyCount", readyCount)
		setAttr("HumanCount", #hs)
		if #hs == 0 then
			intermission = false
			setAttr("PhaseEnd", 0)
		else
			if not intermission then
				intermission = true
				phaseEnd = t + (if #hs == 1 then Config.SOLO_INTERMISSION else Config.INTERMISSION)
				setAttr("PhaseEnd", phaseEnd)
			end
			if readyCount == #hs and phaseEnd - t > Config.READY_SHORTCUT then
				phaseEnd = t + Config.READY_SHORTCUT
				setAttr("PhaseEnd", phaseEnd)
			end
			if t >= phaseEnd then
				startMatch()
			end
		end
	elseif phase == "match" then
		if roundState == "countdown" and t >= fightTime then
			roundState = "fight"
			setAttr("RoundState", roundState)
			for _, f in Combat.fighters do
				if f.zone == "arena" then
					f.humanoid.WalkSpeed = Config.WALK_SPEED
					f.humanoid.JumpPower = Config.JUMP_POWER
				end
			end
			sendAll({ t = "Fight" })
		elseif roundState == "fight" then
			local zone = Arena.zones.arena
			if zone and t >= nextWeaponAt then
				nextWeaponAt = t + rng:range(Config.WEAPON_SPAWN_MIN, Config.WEAPON_SPAWN_MAX)
				if Combat.groundWeaponCount("arena") < Config.MAX_GROUND_WEAPONS then
					local w = Weapons.pick(rng:next())
					local map = zone.map
					local x = rng:range(map.weaponX[1], map.weaponX[2])
					Combat.spawnPickup(w.id, Vector3.new(x, map.weaponY, 0), Vector3.new(rng:range(-4, 4), -10, 0))
					sendAll({ t = "Drop", wid = w.id, x = x, y = map.weaponY })
				end
			end
			if zone and t > sdStart then
				if not suddenDeath then
					suddenDeath = true
					setAttr("InkStart", sdStart)
					sendAll({ t = "SuddenDeath" })
				end
				Arena.setInk("arena", zone.map.killY + (t - sdStart) * Config.SUDDEN_DEATH_SPEED)
			end
			local total, alive, last = 0, 0, nil
			for _, f in Combat.fighters do
				if f.zone == "arena" then
					total += 1
					if f.alive then
						alive += 1
						last = f
					end
				end
			end
			local humansIn = 0
			for _, e in humans() do
				if e.inMatch then
					humansIn += 1
				end
			end
			if humansIn == 0 then
				endMatch()
			elseif total >= 2 and alive <= 1 then
				endRound(last)
			elseif total <= 1 and t > fightTime + 5 then
				endRound(last)
			end
		elseif roundState == "roundEnd" then
			roundTimer -= dt
			if roundTimer <= 0 then
				local top = 0
				for _, e in entries do
					if e.inMatch then
						top = math.max(top, e.wins)
					end
				end
				if top >= Config.WINS_TO_MATCH or roundNumber >= Config.MAX_ROUNDS then
					endMatch()
				else
					startRound()
				end
			end
		end
	elseif phase == "results" then
		if t >= phaseEnd then
			backToLobby()
		end
	end

	stateAcc += dt
	if stateAcc >= 1 / Config.STATE_RATE then
		stateAcc = 0
		broadcastStates()
	end
end)

print("[Ragdoll Rumble] server ready")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Admin</string>
          <string name="Source"><![CDATA[--!strict
-- Admin actions. Every request is permission-checked here on the server.
-- Admins: everyone while testing in Studio, the game owner (or group rank 250+), Config.ADMINS.

local LogService = game:GetService("LogService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Maps = require(Shared:WaitForChild("Maps"))

local Combat = require(script.Parent:WaitForChild("Combat"))
local Bots = require(script.Parent:WaitForChild("Bots"))
local Data = require(script.Parent:WaitForChild("Data"))

local Admin = {}

local flow: any = nil -- set by the main script (match control functions)
local logs: { { t: number, kind: string, msg: string } } = {}

LogService.MessageOut:Connect(function(msg, kind)
	if kind == Enum.MessageType.MessageError or kind == Enum.MessageType.MessageWarning then
		table.insert(logs, { t = os.time(), kind = if kind == Enum.MessageType.MessageError then "error" else "warn", msg = msg })
		if #logs > 60 then
			table.remove(logs, 1)
		end
	end
end)

function Admin.isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if table.find(Config.ADMINS, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return (player :: any):GetRankInGroupAsync(game.CreatorId)
	end)
	if not ok then
		ok, rank = pcall(function()
			return (player :: any):GetRankInGroup(game.CreatorId)
		end)
	end
	return ok and type(rank) == "number" and rank >= 250
end

function Admin.init(api: any)
	flow = api
end

local function target(player: Player, args: any): Player
	if type(args) == "table" and type(args.userId) == "number" then
		local p = Players:GetPlayerByUserId(args.userId)
		if p then
			return p
		end
	end
	return player
end

local function num(v: any, d: number, lo: number, hi: number): number
	if type(v) ~= "number" or v ~= v then
		return d
	end
	return math.clamp(v, lo, hi)
end

local actions: { [string]: any } = {}

-- match ---------------------------------------------------------------------------
actions["match.start"] = function()
	return flow.startMatch()
end
actions["match.end"] = function()
	return flow.endMatch()
end
actions["round.skip"] = function()
	return flow.skipRound()
end
actions["round.map"] = function(_p, a)
	local i = math.floor(num(a and a.map, 1, 1, #Maps.list))
	flow.setNextMap(i)
	return true, "next map: " .. Maps.get(i).name
end
actions["suddendeath"] = function()
	return flow.suddenDeath()
end
actions["intermission"] = function(_p, a)
	return flow.setIntermission(num(a and a.seconds, 10, 0, 300))
end

-- bots -----------------------------------------------------------------------------
actions["bots.target"] = function(_p, a)
	Config.TARGET_FIGHTERS = math.floor(num(a and a.count, 4, 1, Config.MAX_FIGHTERS))
	flow.syncBots()
	return true, "matches fill up to " .. Config.TARGET_FIGHTERS .. " fighters"
end
actions["bots.enabled"] = function(_p, a)
	Config.BOTS_ENABLED = a and a.on == true
	flow.syncBots()
	return true, if Config.BOTS_ENABLED then "bots on" else "bots off"
end
actions["bots.difficulty"] = function(_p, a)
	Bots.difficulty = num(a and a.value, 1, 0.2, 1.6)
	return true, string.format("bot difficulty x%.1f", Bots.difficulty)
end
actions["bots.passive"] = function(_p, a)
	Bots.passive = a and a.on == true
	return true, if Bots.passive then "bots won't attack" else "bots fight back"
end
actions["bots.spawn"] = function(player)
	return flow.spawnTestBot(player)
end

-- players --------------------------------------------------------------------------
actions["player.kill"] = function(player, a)
	local f = Combat.forPlayer(target(player, a))
	if not f then
		return false, "no fighter"
	end
	Combat.kill(f, "admin")
	return true, "KO'd " .. f.name
end
actions["player.heal"] = function(player, a)
	local f = Combat.forPlayer(target(player, a))
	if not f or not f.alive then
		return false, "no living fighter"
	end
	f.humanoid.Health = f.humanoid.MaxHealth
	return true, "healed " .. f.name
end
actions["player.god"] = function(player, a)
	local f = Combat.forPlayer(target(player, a))
	if not f then
		return false, "no fighter"
	end
	f.god = a and a.on == true
	return true, f.name .. (if f.god then " is invincible" else " can be hurt again")
end
actions["player.ragdoll"] = function(player, a)
	local f = Combat.forPlayer(target(player, a))
	if not f or not f.alive then
		return false, "no living fighter"
	end
	Combat.knock(f, Vector3.new(0, 40, 0), 2)
	return true, "flop!"
end
actions["player.weapon"] = function(player, a)
	local f = Combat.forPlayer(target(player, a))
	local w = Weapons.get(math.floor(num(a and a.wid, 1, 1, #Weapons.list)))
	if not f or not f.alive or not w then
		return false, "no living fighter"
	end
	Combat.equip(f, w.id)
	return true, "gave " .. w.name
end
actions["player.coins"] = function(player, a)
	local p = target(player, a)
	local n = math.floor(num(a and a.amount, 1000, -1e7, 1e7))
	Data.addCoins(p, n, "admin")
	return true, string.format("%+d coins to %s", n, p.DisplayName)
end
actions["weapon.drop"] = function(player, a)
	local f = Combat.forPlayer(player)
	local w = Weapons.get(math.floor(num(a and a.wid, 1, 1, #Weapons.list)))
	if not f or not w then
		return false, "spawn in first"
	end
	Combat.spawnPickup(w.id, f.root.Position + Vector3.new(0, 10, 0), Vector3.new(0, -5, 0))
	return true, "dropped a " .. w.name
end

-- crates / data --------------------------------------------------------------------
actions["crate.force"] = function(player, a)
	local p = Data.get(player)
	if not p then
		return false, "no profile"
	end
	p.forceRarity = math.floor(num(a and a.rarity, 1, 1, 8))
	Data.push(player)
	return true, "your next roll is forced"
end
actions["crate.luck"] = function(player, a)
	local p = Data.get(player)
	if not p then
		return false, "no profile"
	end
	p.luck = num(a and a.value, 1, 1, 100000)
	Data.push(player)
	return true, string.format("luck x%g", p.luck)
end
actions["crate.free"] = function(player, a)
	local p = Data.get(player)
	if not p then
		return false, "no profile"
	end
	p.freeRolls = a and a.on == true
	Data.push(player)
	return true, if p.freeRolls then "rolls are free" else "rolls cost coins again"
end
actions["data.reset"] = function(player)
	Data.reset(player)
	return true, "profile reset"
end

-- info -------------------------------------------------------------------------------
actions["state"] = function()
	local list = {}
	for _, pl in Players:GetPlayers() do
		local f = Combat.forPlayer(pl)
		table.insert(list, { userId = pl.UserId, name = pl.DisplayName, zone = if f then f.zone else "-", god = f ~= nil and f.god })
	end
	return true, nil, {
		players = list,
		botsEnabled = Config.BOTS_ENABLED,
		target = Config.TARGET_FIGHTERS,
		difficulty = Bots.difficulty,
		passive = Bots.passive,
		saving = Data.saving,
		phase = workspace:GetAttribute("Phase"),
	}
end
actions["logs"] = function()
	return true, nil, logs
end

function Admin.handle(player: Player, action: any, args: any): any
	if not Admin.isAdmin(player) then
		return { ok = false, msg = "admins only" }
	end
	local fn = if type(action) == "string" then actions[action] else nil
	if not fn then
		return { ok = false, msg = "unknown action" }
	end
	local ok, res, msg, data = pcall(fn, player, args)
	if not ok then
		warn("[Ragdoll Rumble] admin action failed:", action, res)
		return { ok = false, msg = tostring(res) }
	end
	return { ok = res, msg = msg, data = data }
end

return Admin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[--!strict
-- Builds zones (the lobby + the current match arena) from the 2D layouts in Maps.luau.
-- Moving platforms are real physics bodies so they carry avatars. Props are tagged
-- "RumbleSkin" so clients can dress them with the Blender meshes (fallback parts stay
-- visible if mesh APIs are unavailable).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Motion = require(Shared:WaitForChild("Motion"))
local Util = require(Shared:WaitForChild("Util"))

local Arena = {}

local DEPTH = 18

export type Zone = {
	name: string,
	map: any,
	folder: Folder,
	geometry: Folder,
	movers: { { part: BasePart, ap: AlignPosition, ao: AlignOrientation, def: any } },
	hazards: { any },
	inkPart: BasePart?,
	inkY: number,
}

Arena.zones = {} :: { [string]: Zone }

local function c3(hex: number): Color3
	local r, g, b = Util.hexToRGB(hex)
	return Color3.fromRGB(r, g, b)
end
Arena.c3 = c3

local function part(props: { [string]: any }, parent: Instance?): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	if parent then
		p.Parent = parent
	end
	return p
end
Arena.part = part

local function deco(props: { [string]: any }, parent: Instance): BasePart
	local p = part(props, parent)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end
Arena.deco = deco

-- invisible anchor that clients replace with a Blender mesh
function Arena.skinAnchor(name: string, cf: CFrame, scale: number?, parent: Instance): BasePart
	local a = deco({ Name = "Skin_" .. name, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = cf, Transparency = 1 }, parent)
	a:SetAttribute("Skin", name)
	a:SetAttribute("SkinScale", scale or 1)
	CollectionService:AddTag(a, "RumbleSkin")
	return a
end

local function material(name: string?): Enum.Material
	local ok, m = pcall(function()
		return (Enum.Material :: any)[name or "SmoothPlastic"]
	end)
	return if ok and m then m else Enum.Material.SmoothPlastic
end

-------------------------------------------------------------------------------
-- backdrop

local function buildBackdrop(map: any, f: Folder)
	local th = map.theme
	local b = map.bounds
	local cx, cy = (b.left + b.right) * 0.5, (b.bottom + b.top) * 0.5
	local rng = Util.rng(#map.name * 977 + 13)
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = f

	local sky = deco({ Name = "Sky", Size = Vector3.new(1600, 800, 2), CFrame = CFrame.new(cx, cy + 40, -330), Color = c3(th.skyBottom) }, decor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 1
	gui.LightInfluence = 0
	gui.Parent = sky
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c3(th.skyTop)),
		ColorSequenceKeypoint.new(0.6, c3(th.skyTop):Lerp(c3(th.skyBottom), 0.65)),
		ColorSequenceKeypoint.new(1, c3(th.skyBottom)),
	})
	grad.Parent = frame

	local sunCol = c3(th.accent):Lerp(Color3.new(1, 1, 1), 0.35)
	local sun = deco({ Name = "Sun", Shape = Enum.PartType.Ball, Size = Vector3.new(80, 80, 80), Color = sunCol, Material = Enum.Material.Neon }, decor)
	sun.CFrame = CFrame.new(cx + rng:range(-70, 70), cy + 45, -300)

	local kind = th.kind
	local far = c3(th.skyBottom):Lerp(c3(th.block), 0.6)
	local near = c3(th.block):Lerp(Color3.new(0, 0, 0), 0.3)
	local ground = b.bottom - 25

	local function block(x: number, w: number, h: number, z: number, d: number, col: Color3, mat: Enum.Material?, angle: number?)
		return deco({
			Size = Vector3.new(w, h, d),
			CFrame = CFrame.new(x, ground + h * 0.5, z) * CFrame.Angles(0, 0, math.rad(angle or 0)),
			Color = col,
			Material = mat or Enum.Material.SmoothPlastic,
		}, decor)
	end

	if kind == "city" or kind == "lobby" then
		for i = 1, 28 do
			block(cx - 220 + i * 16 + rng:range(-4, 4), rng:range(10, 18), rng:range(40, 110), -220, 20, far)
		end
		for i = 1, 18 do
			local x = cx - 160 + i * 18 + rng:range(-5, 5)
			local h, w = rng:range(30, 85), rng:range(10, 15)
			block(x, w, h, -120, 16, near, Enum.Material.Concrete)
			for _ = 1, 7 do
				if rng:next() < 0.65 then
					deco({ Size = Vector3.new(1.4, 1.8, 0.4), CFrame = CFrame.new(x + rng:range(-w * 0.35, w * 0.35), ground + rng:range(5, h - 3), -111.8), Color = c3(th.accent), Material = Enum.Material.Neon }, decor)
				end
			end
		end
	elseif kind == "carnival" then
		for i = 1, 9 do
			local s = rng:range(26, 40)
			local col = if i % 2 == 0 then c3(th.edge):Lerp(far, 0.45) else c3(th.ledge):Lerp(far, 0.45)
			deco({ Size = Vector3.new(s, s, 20), CFrame = CFrame.new(cx - 170 + i * 38, ground + 2, -170) * CFrame.Angles(0, 0, math.rad(45)), Color = col, Material = Enum.Material.Fabric }, decor)
		end
		for i = 0, 50 do
			local x = cx - 110 + i * 4.4
			local y = cy + 36 - math.sin(i / 50 * math.pi * 3) ^ 2 * 7
			deco({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(x, y, -60), Color = Color3.fromHSV((i * 0.13) % 1, 0.6, 1), Material = Enum.Material.Neon }, decor)
		end
	elseif kind == "factory" then
		for i = 1, 10 do
			block(cx - 160 + i * 32 + rng:range(-6, 6), rng:range(6, 10), rng:range(60, 120), -180, 8, far, Enum.Material.Brick)
		end
		for i = 1, 4 do
			local r = rng:range(12, 20)
			deco({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, r * 2, r * 2), CFrame = CFrame.new(cx - 100 + i * 48, cy + rng:range(-8, 22), -110) * CFrame.Angles(0, math.pi / 2, 0), Color = near, Material = Enum.Material.Metal }, decor)
		end
	elseif kind == "temple" then
		for i = 0, 7 do
			deco({ Size = Vector3.new(150 - i * 18, 10, 40), CFrame = CFrame.new(cx, ground + 5 + i * 10, -220), Color = far:Lerp(Color3.new(0, 0, 0), i * 0.03), Material = Enum.Material.Slate }, decor)
		end
		for i = 1, 12 do
			local x = cx - 140 + i * 24
			block(x, 5, rng:range(45, 80), -110, 5, near, Enum.Material.Slate)
		end
	elseif kind == "arctic" then
		for i = 1, 12 do
			local s = rng:range(24, 44)
			deco({ Size = Vector3.new(s, s, s), CFrame = CFrame.new(cx - 170 + i * 30, ground - 4, rng:range(-200, -130)) * CFrame.Angles(0, 0, math.rad(rng:range(20, 70))), Color = c3(0xd9efff):Lerp(far, 0.25), Material = Enum.Material.Glacier }, decor)
		end
		deco({ Name = "Water", Size = Vector3.new(1200, 4, 400), CFrame = CFrame.new(cx, map.killY + 6, -150), Color = c3(0x1d4e89), Material = Enum.Material.Glass, Transparency = 0.2 }, decor)
		local emitter = deco({ Size = Vector3.new(240, 1, 80), CFrame = CFrame.new(cx, b.top + 25, -20), Transparency = 1 }, decor)
		local pe = Instance.new("ParticleEmitter")
		pe.EmissionDirection = Enum.NormalId.Bottom
		pe.Rate = 70
		pe.Lifetime = NumberRange.new(8, 12)
		pe.Speed = NumberRange.new(6, 10)
		pe.SpreadAngle = Vector2.new(25, 25)
		pe.Size = NumberSequence.new(0.35)
		pe.LightEmission = 0.4
		pe.Parent = emitter
	elseif kind == "lab" then
		for i = 1, 14 do
			deco({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(500, 1.6, 1.6), CFrame = CFrame.new(cx, cy - 32 + i * 6.5, -120 - (i % 3) * 12), Color = far, Material = Enum.Material.Metal }, decor)
		end
		for i = 1, 8 do
			deco({ Size = Vector3.new(12, 7, 0.6), CFrame = CFrame.new(cx - 125 + i * 31, cy + rng:range(-10, 30), -95), Color = c3(th.edge), Material = Enum.Material.Neon, Transparency = 0.45 }, decor)
		end
	elseif kind == "desert" then
		for i = 1, 8 do
			local x = cx - 160 + i * 40 + rng:range(-8, 8)
			local w, h = rng:range(26, 44), rng:range(20, 44)
			block(x, w, h, -200, 40, far, Enum.Material.Sandstone)
			block(x, w * 0.7, h + 8, -205, 30, far:Lerp(Color3.new(0, 0, 0), 0.1), Enum.Material.Sandstone)
		end
	elseif kind == "neon" then
		for i = -16, 16 do
			deco({ Size = Vector3.new(0.4, 0.4, 300), CFrame = CFrame.new(cx + i * 16, b.bottom - 6, -160), Color = c3(th.ledge), Material = Enum.Material.Neon, Transparency = 0.3 }, decor)
		end
		for i = 1, 10 do
			deco({ Size = Vector3.new(700, 0.4, 0.4), CFrame = CFrame.new(cx, b.bottom - 6, -10 - i * i * 3), Color = c3(th.edge), Material = Enum.Material.Neon, Transparency = 0.3 }, decor)
		end
	end
	if kind == "lobby" then
		-- back wall of the arcade hall with neon strips
		deco({ Size = Vector3.new(164, 44, 2), CFrame = CFrame.new(0, 1019, -10), Color = c3(0x1c1834), Material = Enum.Material.SmoothPlastic }, decor)
		for i = 0, 3 do
			deco({ Size = Vector3.new(164, 0.4, 0.3), CFrame = CFrame.new(0, 1003 + i * 9, -8.9), Color = if i % 2 == 0 then c3(th.edge) else c3(th.accent), Material = Enum.Material.Neon }, decor)
		end
	end
end

-------------------------------------------------------------------------------
-- geometry

local function buildBlock(zone: Zone, def: any, index: number)
	local th = zone.map.theme
	local depth = def.depth or DEPTH
	local style = def.style
	local col = c3(if style == "ledge" or style == "cabin" or style == "lift" then th.ledge else th.block)
	local p = part({
		Name = "Block" .. index,
		Size = Vector3.new(def.w, def.h, depth),
		CFrame = CFrame.new(def.x, def.y, 0) * CFrame.Angles(0, 0, math.rad(def.angle or 0)),
		Color = col,
		Material = material(th.material),
	}, zone.geometry)
	local edgeH = math.min(0.6, def.h * 0.45)
	local edge = deco({
		Name = "Edge",
		Size = Vector3.new(def.w + 0.1, edgeH, depth + 0.1),
		CFrame = p.CFrame * CFrame.new(0, def.h * 0.5 - edgeH * 0.5 + 0.02, 0),
		Color = c3(th.edge),
		Material = if th.kind == "neon" or th.kind == "lab" or th.kind == "lobby" then Enum.Material.Neon else material(th.material),
	}, p)
	if style == "ice" then
		p.Material = Enum.Material.Glacier
		edge.Material = Enum.Material.Snow
		edge.Color = Color3.new(1, 1, 1)
	elseif style == "crate" then
		p.Material = Enum.Material.WoodPlanks
		p.Color = c3(0x8a5a2b)
		edge.Color = c3(0xa8743f)
		edge.Material = Enum.Material.WoodPlanks
	elseif style == "spinner" then
		p.Material = Enum.Material.Neon
		p.Color = c3(th.accent)
		edge.Transparency = 1
	elseif style == "belt" then
		p.Color = c3(0x2a2420)
		edge.Material = Enum.Material.DiamondPlate
		edge.Color = c3(0x3a3530)
		p.AssemblyLinearVelocity = Vector3.new(def.conveyor or 0, 0, 0)
		p:SetAttribute("Conveyor", def.conveyor or 0)
		for i = 0, math.floor(def.w / 3) do
			deco({ Size = Vector3.new(1.2, def.h * 0.6, 0.2), CFrame = CFrame.new(def.x - def.w * 0.5 + i * 3 + 1, def.y - 0.4, depth * 0.5 + 0.1) * CFrame.Angles(0, 0, math.rad(30)), Color = c3(th.edge), Material = Enum.Material.Neon }, p)
		end
	elseif style == "lift" or style == "cabin" then
		edge.Material = Enum.Material.Neon
		if style == "cabin" then
			edge.Color = Color3.fromHSV((index * 0.17) % 1, 0.65, 1)
		end
	end
	if def.motion then
		local w = Instance.new("WeldConstraint")
		w.Part0 = p
		w.Part1 = edge
		edge.Anchored = false
		edge.Massless = true
		w.Parent = p
		p.Anchored = false
		p.CustomPhysicalProperties = PhysicalProperties.new(5, 0.6, 0, 1, 1)
		local att = Instance.new("Attachment")
		att.Parent = p
		local ap = Instance.new("AlignPosition")
		ap.Mode = Enum.PositionAlignmentMode.OneAttachment
		ap.Attachment0 = att
		ap.RigidityEnabled = true
		ap.Position = p.Position
		ap.Parent = p
		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.RigidityEnabled = true
		ao.CFrame = p.CFrame.Rotation
		ao.Parent = p
		table.insert(zone.movers, { part = p, ap = ap, ao = ao, def = def })
		pcall(function()
			p:SetNetworkOwner(nil)
		end)
	end
end

local function buildHazard(zone: Zone, def: any, index: number)
	local f = zone.folder
	if def.kind == "saw" then
		local r = def.r
		local saw = deco({
			Name = "Saw" .. index,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1, r * 2, r * 2),
			CFrame = CFrame.new(def.x, def.y, 0) * CFrame.Angles(0, math.pi / 2, 0),
			Color = c3(0xaab2bf),
			Material = Enum.Material.Metal,
		}, f)
		saw:SetAttribute("SawIndex", index)
		saw:SetAttribute("Radius", r)
		saw:SetAttribute("Fallback", true)
		local n = math.max(8, math.floor(r * 3))
		for i = 1, n do
			local a = i / n * math.pi * 2
			local tooth = deco({
				Size = Vector3.new(0.6, r * 0.34, r * 0.34),
				CFrame = saw.CFrame * CFrame.new(0, math.cos(a) * r, math.sin(a) * r) * CFrame.Angles(a + math.pi / 4, 0, 0),
				Color = c3(0xe6ebf2),
				Material = Enum.Material.Metal,
			}, saw)
			tooth:SetAttribute("Fallback", true)
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = saw
			wc.Part1 = tooth
			wc.Parent = tooth
			tooth.Anchored = false
			tooth.Massless = true
		end
		-- the Blender saw mesh is modeled facing the camera (radius 1)
		local anchor = Arena.skinAnchor("saw", CFrame.new(def.x, def.y, 0), r, saw)
		anchor.Anchored = false
		local wc = Instance.new("WeldConstraint")
		wc.Part0 = saw
		wc.Part1 = anchor
		wc.Parent = anchor
		table.insert(zone.hazards, { kind = "saw", def = def, part = saw })
	elseif def.kind == "spikes" then
		local holder = Instance.new("Model")
		holder.Name = "Spikes" .. index
		holder.Parent = f
		deco({ Size = Vector3.new(def.w, def.h * 1.2, DEPTH - 2), CFrame = CFrame.new(def.x, def.y - def.h * 0.4, 0), Color = c3(0x3a1f24) }, holder)
		local n = math.max(1, math.floor(def.w / 1.3))
		local step = def.w / n
		for i = 1, n do
			for k = -2, 2 do
				local x, z = def.x - def.w * 0.5 + step * (i - 0.5), k * 3.2
				local d = deco({
					Size = Vector3.new(step * 0.7, step * 0.7, step * 0.7),
					CFrame = CFrame.new(x, def.y, z) * CFrame.Angles(0, math.rad(45), math.rad(45)),
					Color = c3(0xd8dde6),
					Material = Enum.Material.Metal,
				}, holder)
				d:SetAttribute("Fallback", true)
				Arena.skinAnchor("spike", CFrame.new(x, def.y - def.h * 0.5, z), step * 0.9, holder)
			end
		end
		table.insert(zone.hazards, { kind = "spikes", def = def })
	end
end

-------------------------------------------------------------------------------

function Arena.clear(name: string)
	local z = Arena.zones[name]
	if z then
		z.folder:Destroy()
		Arena.zones[name] = nil
	end
end

function Arena.build(name: string, map: any): Zone
	Arena.clear(name)
	local f = Instance.new("Folder")
	f.Name = if name == "lobby" then "Lobby" else "Arena"
	f:SetAttribute("Zone", name)
	f.Parent = workspace
	local geo = Instance.new("Folder")
	geo.Name = "Geometry"
	geo.Parent = f
	local zone: Zone = { name = name, map = map, folder = f, geometry = geo, movers = {}, hazards = {}, inkPart = nil, inkY = -math.huge }
	Arena.zones[name] = zone
	buildBackdrop(map, f)
	for i, def in map.blocks do
		buildBlock(zone, def, i)
	end
	for i, def in map.hazards do
		buildHazard(zone, def, i)
	end
	local th = map.theme
	if map.wheel then
		local w = map.wheel
		deco({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 5, 5), CFrame = CFrame.new(w.x, w.y, -6) * CFrame.Angles(0, math.pi / 2, 0), Color = c3(th.accent), Material = Enum.Material.Neon }, f)
		for _, s in { -1, 1 } do
			local hgt = w.y - map.bounds.bottom + 12
			deco({ Size = Vector3.new(2, hgt, 2), CFrame = CFrame.new(w.x + s * 5, w.y - hgt * 0.5, -7) * CFrame.Angles(0, 0, math.rad(s * 12)), Color = c3(th.block), Material = Enum.Material.Metal }, f)
		end
	end
	for _, def in map.blocks do
		local m = def.motion
		if m and m.type == "pendulum" then
			deco({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), CFrame = CFrame.new(m.px, m.py, -2), Color = c3(th.accent), Material = Enum.Material.Metal }, f)
		end
	end
	if name ~= "lobby" then
		local ink = deco({ Name = "Ink", Size = Vector3.new(1400, 200, 200), Color = c3(th.ink), Material = Enum.Material.Neon, Transparency = 0.25 }, f)
		zone.inkPart = ink
		Arena.setInk(name, map.killY)
	end
	Arena.update(0)
	return zone
end

function Arena.setInk(name: string, y: number)
	local z = Arena.zones[name]
	if not z then
		return
	end
	z.inkY = y
	if z.inkPart then
		z.inkPart.CFrame = CFrame.new(0, y - 100, -60)
	end
end

function Arena.update(t: number)
	for _, z in Arena.zones do
		for _, m in z.movers do
			local d = m.def
			local x, y, a = Motion.pose(d.motion, d.x, d.y, math.rad(d.angle or 0), t)
			m.ap.Position = Vector3.new(x, y, 0)
			m.ao.CFrame = CFrame.Angles(0, 0, a)
		end
	end
end

function Arena.hazardAt(name: string, pos: Vector3, radius: number, t: number): (string?, Vector3)
	local z = Arena.zones[name]
	if not z then
		return nil, Vector3.zero
	end
	for _, h in z.hazards do
		local d = h.def
		if h.kind == "saw" then
			local x, y = Motion.pose(d.motion, d.x, d.y, 0, t)
			local dx, dy = pos.X - x, pos.Y - y
			if math.sqrt(dx * dx + dy * dy) < d.r + radius then
				local nx, ny = Util.norm(dx, dy)
				if nx == 0 and ny == 0 then
					ny = 1
				end
				return "saw", Vector3.new(nx, ny, 0)
			end
		elseif h.kind == "spikes" then
			if math.abs(pos.X - d.x) < d.w * 0.5 + radius and math.abs(pos.Y - d.y) < d.h * 0.5 + radius then
				return "spikes", Vector3.new(0, 1, 0)
			end
		end
	end
	return nil, Vector3.zero
end

function Arena.zone(name: string): Zone?
	return Arena.zones[name]
end

function Arena.spawnCFrame(name: string, x: number, y: number): CFrame
	local z = Arena.zones[name]
	local cx = if z then (z.map.bounds.left + z.map.bounds.right) * 0.5 else 0
	local facing = if x > cx then -1 else 1
	return CFrame.new(x, y + 3.4, 0) * CFrame.Angles(0, if facing > 0 then -math.pi / 2 else math.pi / 2, 0)
end

-- which zone is this point in (lobby sits far above the arenas)
function Arena.zoneAt(pos: Vector3): string
	return if pos.Y > 600 then "lobby" else "arena"
end

return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Bots</string>
          <string name="Source"><![CDATA[--!strict
-- Bot fighters: colorful custom mannequin avatars + a scrappy platform-fighter brain.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Rig = require(Shared:WaitForChild("Rig"))
local Util = require(Shared:WaitForChild("Util"))
local Arena = require(script.Parent:WaitForChild("Arena"))
local Combat = require(script.Parent:WaitForChild("Combat"))

local Bots = {}

-- admin-tweakable
Bots.passive = false -- bots don't attack (handy for testing)
Bots.difficulty = 1 -- multiplies bot skill (0.3 .. 1.6)

local templates: { [number]: Model } = {}
local templateFolder: Folder? = nil

local function getFolder(): Folder
	if not templateFolder then
		local f = Instance.new("Folder")
		f.Name = "RumbleBotTemplates"
		f.Parent = ServerStorage
		templateFolder = f
	end
	return templateFolder :: Folder
end

-- build (once per color) an R15 mannequin in that fighter color
function Bots.template(colorIndex: number): Model?
	if templates[colorIndex] then
		return templates[colorIndex]
	end
	local c = Config.COLORS[colorIndex] or Config.COLORS[1]
	local desc = Instance.new("HumanoidDescription")
	local skin = c.main:Lerp(Color3.new(1, 1, 1), 0.55)
	desc.HeadColor = skin
	desc.LeftArmColor = c.main
	desc.RightArmColor = c.main
	desc.TorsoColor = c.main
	desc.LeftLegColor = c.dark
	desc.RightLegColor = c.dark
	local ok, model = pcall(function()
		return (Players :: any):CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return (Players :: any):CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
	end
	if not ok or not model then
		warn("[Ragdoll Rumble] could not build a bot avatar:", model)
		return nil
	end
	local m = model :: Model
	-- glowing headband so bots are easy to tell apart
	local head = m:FindFirstChild("Head") :: BasePart?
	if head then
		local band = Instance.new("Part")
		band.Name = "Headband"
		band.Shape = Enum.PartType.Cylinder
		band.Size = Vector3.new(0.35, head.Size.Y * 1.02, head.Size.Y * 1.02)
		band.Color = c.main
		band.Material = Enum.Material.Neon
		band.CanCollide = false
		band.CanQuery = false
		band.CanTouch = false
		band.Massless = true
		band.CFrame = head.CFrame * CFrame.new(0, head.Size.Y * 0.18, 0) * CFrame.Angles(0, 0, math.pi / 2)
		band.Parent = m
		local wc = Instance.new("WeldConstraint")
		wc.Part0 = head
		wc.Part1 = band
		wc.Parent = band
	end
	local animate = m:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	Rig.setup(m)
	m.Parent = getFolder()
	templates[colorIndex] = m
	return m
end

export type Brain = {
	rng: Util.Rng,
	skill: number,
	targetFid: number,
	retarget: number,
	attackCd: number,
	jumpCd: number,
	blockUntil: number,
	react: number,
	aimErr: number,
	aimErrT: number,
	hand: string,
	djumpUsed: boolean,
	stuckT: number,
	lastX: number,
	idleDir: number,
	idleT: number,
}

function Bots.newBrain(seed: number, skill: number): Brain
	return {
		rng = Util.rng(seed),
		skill = skill,
		targetFid = 0,
		retarget = 0,
		attackCd = 0.5,
		jumpCd = 0,
		blockUntil = 0,
		react = 0,
		aimErr = 0,
		aimErrT = 0,
		hand = "R",
		djumpUsed = false,
		stuckT = 0,
		lastX = 0,
		idleDir = 1,
		idleT = 0,
	}
end

local paramsCache: { [string]: RaycastParams } = {}
local function geoParams(zoneName: string): RaycastParams
	local zone = Arena.zones[zoneName]
	local rp = paramsCache[zoneName]
	if not rp then
		rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		paramsCache[zoneName] = rp
	end
	local r = rp :: RaycastParams
	r.FilterDescendantsInstances = if zone then { zone.geometry } else {}
	return r
end

local function groundBelow(rp: RaycastParams, x: number, y: number, depth: number): boolean
	return workspace:Raycast(Vector3.new(x, y, 0), Vector3.new(0, -depth, 0), rp) ~= nil
end

function Bots.think(f: Combat.F, dt: number, frozen: boolean)
	local b = f.brain :: Brain
	local hum = f.humanoid
	local idle = f.isDummy and not (f :: any).sparring
	if not f.alive or Combat.isRagdoll(f) or frozen or idle then
		hum:Move(Vector3.zero, false)
		f.blocking = false
		if idle and f.alive and not Combat.isRagdoll(f) then
			-- dummies just turn to face whoever is closest
			local best, bestD = nil, 30
			for _, o in Combat.fighters do
				if o ~= f and o.zone == f.zone and o.alive then
					local d = (o.root.Position - f.root.Position).Magnitude
					if d < bestD then
						best, bestD = o, d
					end
				end
			end
			if best then
				local fo = f.root:FindFirstChild("Facing") :: AlignOrientation?
				if fo then
					fo.CFrame = Rig.facingCFrame(if best.root.Position.X >= f.root.Position.X then 1 else -1)
				end
			end
		end
		return
	end
	local zone = Arena.zones[f.zone]
	local map = if zone then zone.map else nil
	local rng = b.rng
	local now = os.clock()
	local root = f.root
	local pos = root.Position
	local rp = geoParams(f.zone)
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	if grounded then
		b.djumpUsed = false
	end
	b.retarget -= dt
	b.attackCd -= dt
	b.jumpCd -= dt
	b.react -= dt
	b.aimErrT -= dt
	if b.aimErrT <= 0 then
		b.aimErrT = rng:range(0.3, 0.8)
		local skill = math.clamp(b.skill * Bots.difficulty, 0.05, 1)
		b.aimErr = rng:range(-1, 1) * (1 - skill) * 0.3
	end

	-- target
	local target = Combat.fighters[b.targetFid]
	if b.retarget <= 0 or not target or not target.alive then
		b.retarget = rng:range(0.7, 1.5)
		local best, bestD = nil, math.huge
		for _, o in Combat.fighters do
			if o ~= f and o.alive and o.model.Parent and o.zone == f.zone and not o.isDummy then
				local d = (o.root.Position - pos).Magnitude * rng:range(0.8, 1.25)
				if d < bestD then
					best, bestD = o, d
				end
			end
		end
		target = best
		b.targetFid = if best then best.fid else 0
	end

	-- weapon hunting
	local w = Weapons.get(f.wid)
	local goal = pos
	local wantWeapon = false
	local dist = math.huge
	if target then
		dist = (target.root.Position - pos).Magnitude
	end
	if not w then
		local pickups = workspace:FindFirstChild("Pickups")
		local best, bestD = nil, 30
		if pickups then
			for _, m in pickups:GetChildren() do
				if m:IsA("Model") and m.PrimaryPart then
					local pp = m.PrimaryPart.Position
					local d = (pp - pos).Magnitude
					if d < bestD and pp.Y > (if map then map.killY + 5 else -1e9) and math.abs(pp.Y - pos.Y) < 200 then
						best, bestD = pp, d
					end
				end
			end
		end
		if best and (bestD < dist * 1.3 or bestD < 9) then
			goal = best
			wantWeapon = true
		end
	end
	if not wantWeapon and target then
		goal = target.root.Position
	end

	local prefer = 2.6
	if w and (w.kind == "gun" or w.kind == "launcher") then
		prefer = if w.key == "scatter" then 9 else 18
	elseif w and w.kind == "throwable" then
		prefer = 14
	elseif w and w.kind == "melee" then
		prefer = 3.2
	end
	if wantWeapon then
		prefer = 0
	end

	local dx = goal.X - pos.X
	local move = 0
	if math.abs(dx) > prefer + 0.8 then
		move = Util.sign(dx)
	elseif not wantWeapon and math.abs(dx) < prefer - 4 then
		move = -Util.sign(dx)
	end

	-- don't walk off ledges unless it's a jumpable gap toward the goal
	if grounded and move ~= 0 then
		if not groundBelow(rp, pos.X + move * 3, pos.Y, 16) then
			local gapOk = false
			for k = 5, 16, 2 do
				if groundBelow(rp, pos.X + move * k, pos.Y + 4, 14) then
					gapOk = true
					break
				end
			end
			if gapOk and (goal.Y > pos.Y - 8 or wantWeapon) then
				if b.jumpCd <= 0 then
					hum.Jump = true
					b.jumpCd = 0.6
				end
			elseif goal.Y < pos.Y - 4 and groundBelow(rp, pos.X + move * 3, pos.Y, 40) then
				-- safe drop
			else
				move = 0
			end
		end
	end

	-- recovery: off stage -> head back to the middle, double jump
	local bnd = if map then map.bounds else { left = -50, right = 50 }
	if not grounded and not groundBelow(rp, pos.X, pos.Y, 60) then
		move = Util.sign((bnd.left + bnd.right) * 0.5 - pos.X)
		if not b.djumpUsed and root.AssemblyLinearVelocity.Y < 4 then
			b.djumpUsed = true
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, Config.DOUBLE_JUMP_VELOCITY, 0)
			Combat.act(f, "djump")
		end
	end

	-- jump at walls / higher goals
	if grounded and b.jumpCd <= 0 then
		local dir = if move ~= 0 then move else Combat.facing(f)
		local wall = workspace:Raycast(pos, Vector3.new(dir * 3, 0, 0), rp)
		local higher = goal.Y > pos.Y + 4 and math.abs(dx) < 16
		if (wall and move ~= 0) or higher then
			hum.Jump = true
			b.jumpCd = rng:range(0.5, 0.9)
		end
	end
	-- stuck
	if math.abs(pos.X - b.lastX) < 0.02 and move ~= 0 then
		b.stuckT += dt
		if b.stuckT > 0.7 then
			hum.Jump = true
			b.stuckT = 0
		end
	else
		b.stuckT = 0
	end
	b.lastX = pos.X

	if not target and not wantWeapon then
		b.idleT -= dt
		if b.idleT <= 0 then
			b.idleT = rng:range(1, 2.5)
			b.idleDir = if rng:next() < 0.5 then -1 else 1
		end
		move = b.idleDir
		if grounded and not groundBelow(rp, pos.X + move * 3, pos.Y, 16) then
			b.idleDir = -b.idleDir
			move = 0
		end
	end

	-- block incoming swings
	f.blocking = now < b.blockUntil
	if target and dist < 7 and b.react <= 0 then
		local la = math.max(target.lastAction.punch or 0, target.lastAction.swing or 0)
		if now - la < 0.12 then
			b.react = rng:range(0.25, 0.5)
			if rng:next() < b.skill * 0.55 then
				b.blockUntil = now + rng:range(0.25, 0.45)
				f.blockStart = now
				f.blocking = true
			end
		end
	end
	local speed = if f.blocking then Config.BLOCK_SPEED else 1
	hum:Move(Vector3.new(move * speed, 0, 0), false)

	-- aim + facing
	local aimAt = if target then (target.model:FindFirstChild("UpperTorso") or target.root) :: BasePart else nil
	if aimAt then
		local sh = Combat.shoulder(f)
		local to = aimAt.Position - sh
		local extra = 0
		if w and w.kind == "throwable" then
			extra = math.clamp(to.Magnitude * 0.025, 0, 0.6)
		end
		f.aim = math.atan2(to.Y, to.X) + b.aimErr + extra * Util.sign(to.X)
		if extra > 0 and to.X < 0 then
			f.aim = math.atan2(to.Y, to.X) + b.aimErr - extra
		end
	elseif move ~= 0 then
		f.aim = if move > 0 then 0 else math.pi
	end
	local facingObj = root:FindFirstChild("Facing") :: AlignOrientation?
	if facingObj then
		facingObj.CFrame = Rig.facingCFrame(if math.cos(f.aim) >= 0 then 1 else -1)
	end

	if not target or f.blocking or Bots.passive then
		return
	end

	-- attack
	if b.attackCd <= 0 then
		if not w then
			if dist < 4.6 then
				b.hand = if b.hand == "R" then "L" else "R"
				Combat.botPunch(f, b.hand)
				b.attackCd = Config.PUNCH_COOLDOWN + rng:range(0.05, 0.35) * (1.4 - b.skill)
			end
		elseif w.kind == "melee" then
			if dist < w.length + 3 then
				Combat.botSwing(f)
				b.attackCd = w.rate + rng:range(0.05, 0.3)
			end
		else
			local sh = Combat.shoulder(f)
			local dir = Vector3.new(math.cos(f.aim), math.sin(f.aim), 0)
			local blocked = workspace:Raycast(sh, dir * math.min(dist, 80), rp)
			if not blocked and dist < (if w.kind == "gun" then math.min(w.range, 70) else 45) then
				if w.kind == "gun" then
					Combat.botShoot(f)
					b.attackCd = w.rate + (if w.auto then 0 else rng:range(0.1, 0.45) * (1.3 - b.skill))
				elseif dist > 7 then
					Combat.botLaunch(f)
					b.attackCd = w.rate + rng:range(0.2, 0.6)
				end
			end
		end
	end
end

return Bots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative combat: health, knockback, ragdolls, weapons, pickups, projectiles.
-- Players detect their own hits (snappy feel) and the server validates them; bots and
-- projectiles are resolved fully on the server.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Rig = require(Shared:WaitForChild("Rig"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Arena = require(script.Parent:WaitForChild("Arena"))

local Combat = {}

export type F = {
	fid: number,
	name: string,
	colorIndex: number,
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	player: Player?,
	isBot: boolean,
	isDummy: boolean,
	zone: string,
	god: boolean,
	alive: boolean,
	wid: number,
	ammo: number,
	aim: number,
	blocking: boolean,
	crouch: boolean,
	blockStart: number,
	stagger: number,
	lastHitBy: number,
	lastHitTime: number,
	ragdollUntil: number,
	knockUntil: number,
	knockLV: LinearVelocity?,
	deathCause: string,
	hazardCd: number,
	lastAction: { [string]: number },
	lastShot: number,
	meleeHits: { [number]: number },
	discardAt: number,
	hitBudget: number,
	brain: any,
	lastKnock: Vector3,
}

type Pickup = {
	model: Model,
	handle: BasePart,
	wid: number,
	ammo: number,
	born: number,
	thrownBy: number,
	thrownAt: number,
	dangerous: boolean,
	zone: string,
}

type Proj = {
	part: BasePart,
	kind: string,
	wid: number,
	owner: number,
	born: number,
	fuse: number,
	last: Vector3,
}

Combat.fighters = {} :: { [number]: F }
local pickups: { Pickup } = {}
local projectiles: { Proj } = {}
local Event = Remotes.Event

Combat.hooks = {
	onDeath = function(_f: F, _killer: number, _cause: string) end,
	active = function(): boolean
		return true
	end,
	roundTime = function(): number
		return 0
	end,
	finisherOf = function(_fid: number): string?
		return nil
	end,
}

local function sendAll(msg: any)
	Event:FireAllClients(msg)
end

local function sendOthers(player: Player?, msg: any)
	for _, p in Players:GetPlayers() do
		if p ~= player then
			Event:FireClient(p, msg)
		end
	end
end
Combat.sendAll = sendAll
Combat.sendOthers = sendOthers

local function clock(): number
	return os.clock()
end

local function folder(name: string): Folder
	local f = workspace:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = workspace
	end
	return f :: Folder
end

-------------------------------------------------------------------------------
-- geometry helpers

function Combat.facing(f: F): number
	return if f.root.CFrame.LookVector.X >= 0 then 1 else -1
end

function Combat.aimDir(f: F): Vector3
	return Vector3.new(math.cos(f.aim), math.sin(f.aim), 0)
end

function Combat.shoulder(f: F): Vector3
	local ut = f.model:FindFirstChild("UpperTorso") or f.model:FindFirstChild("Torso")
	if ut and ut:IsA("BasePart") then
		return ut.Position + Vector3.new(0, ut.Size.Y * 0.3, 0)
	end
	return f.root.Position + Vector3.new(0, 1.5, 0)
end

local BODY = { "HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso" }

function Combat.distToBody(f: F, p: Vector3): number
	local best = math.huge
	for _, n in BODY do
		local part = f.model:FindFirstChild(n)
		if part and part:IsA("BasePart") then
			local d = (part.Position - p).Magnitude
			if d < best then
				best = d
			end
		end
	end
	return best
end

function Combat.isRagdoll(f: F): boolean
	return f.model:GetAttribute("Ragdoll") == true
end

function Combat.fromModel(inst: Instance?): F?
	local m = inst
	while m and m ~= workspace do
		if m:IsA("Model") and m:GetAttribute("Fid") then
			return Combat.fighters[m:GetAttribute("Fid") :: number]
		end
		m = m.Parent
	end
	return nil
end

function Combat.rayParams(exclude: { Instance }): RaycastParams
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local list = table.clone(exclude)
	table.insert(list, folder("Pickups"))
	table.insert(list, folder("Projectiles"))
	rp.FilterDescendantsInstances = list
	rp.IgnoreWater = true
	return rp
end

-------------------------------------------------------------------------------
-- weapon models

-- weapon space (+X barrel, +Y up) -> right hand space (arm points along -Y)
local GRIP = CFrame.fromMatrix(Vector3.new(0, -0.25, 0), Vector3.new(0, -1, 0), Vector3.new(0, 0, -1))

function Combat.buildWeaponModel(w: Weapons.Weapon, physical: boolean): (Model, BasePart)
	local m = Instance.new("Model")
	m.Name = "Weapon"
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = if physical then Vector3.new(math.max(1, w.length + 0.4), 0.8, 1.2) else Vector3.new(0.3, 0.3, 0.3)
	handle.Transparency = 1
	handle.CanCollide = physical
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = not physical
	handle.CFrame = CFrame.new(0, 1000, 0)
	handle.Parent = m
	if physical then
		handle.CustomPhysicalProperties = PhysicalProperties.new(1.2, 0.6, 0.35, 1, 1)
	end
	m.PrimaryPart = handle
	for i, d in w.parts do
		local p = Instance.new("Part")
		p.Name = "P" .. i
		local shape = d.shape
		if shape == "cyl" then
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(d.w, d.h, d.h)
		elseif shape == "ball" then
			p.Shape = Enum.PartType.Ball
			p.Size = Vector3.new(d.w, d.w, d.w)
		else
			p.Size = Vector3.new(d.w, d.h, d.d or 0.4)
		end
		local r, g, b = Util.hexToRGB(d.color)
		p.Color = Color3.fromRGB(r, g, b)
		p.Material = if d.neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.CFrame = handle.CFrame * CFrame.new(d.x, d.y, d.z or 0)
		p.Parent = m
		local wc = Instance.new("WeldConstraint")
		wc.Part0 = handle
		wc.Part1 = p
		wc.Parent = p
	end
	-- tip marker so clients can attach slash trails / muzzle flashes
	local tip = Instance.new("Attachment")
	tip.Name = "Tip"
	tip.Position = Vector3.new(w.length, 0, 0)
	tip.Parent = handle
	local base = Instance.new("Attachment")
	base.Name = "Base"
	base.Position = Vector3.new(math.min(0.6, w.length * 0.3), 0, 0)
	base.Parent = handle
	m:SetAttribute("Wid", w.id)
	-- clients swap the box parts for the Blender mesh
	for _, d in m:GetChildren() do
		if d:IsA("BasePart") and d ~= handle then
			d:SetAttribute("Fallback", true)
		end
	end
	handle:SetAttribute("Skin", w.key)
	handle:SetAttribute("SkinScale", 1)
	CollectionService:AddTag(handle, "RumbleSkin")
	return m, handle
end

local function hand(f: F): BasePart?
	local h = f.model:FindFirstChild("RightHand") or f.model:FindFirstChild("Right Arm")
	return if h and h:IsA("BasePart") then h else nil
end

function Combat.unequip(f: F, drop: boolean, vel: Vector3?)
	local old = f.model:FindFirstChild("Weapon")
	local wid, ammo = f.wid, f.ammo
	if old then
		old:Destroy()
	end
	f.wid = 0
	f.ammo = 0
	f.discardAt = 0
	f.model:SetAttribute("Wid", 0)
	f.model:SetAttribute("Ammo", 0)
	if drop and wid ~= 0 then
		local h = hand(f)
		local pos = if h then h.Position else f.root.Position
		local w = Weapons.get(wid)
		if w and (ammo > 0 or w.kind == "melee") then
			Combat.spawnPickup(wid, pos, vel or Vector3.new(0, 20, 0), ammo, f.fid)
		end
	end
	sendAll({ t = "Unequip", fid = f.fid })
end

function Combat.equip(f: F, wid: number, ammo: number?)
	local w = Weapons.get(wid)
	if not w then
		return
	end
	local old = f.model:FindFirstChild("Weapon")
	if old then
		old:Destroy()
	end
	f.wid = wid
	f.ammo = ammo or w.ammo
	f.discardAt = 0
	f.model:SetAttribute("Wid", wid)
	f.model:SetAttribute("Ammo", f.ammo)
	local h = hand(f)
	if not h then
		return
	end
	local m, handle = Combat.buildWeaponModel(w, false)
	m:PivotTo(h.CFrame * GRIP)
	local weld = Instance.new("Weld")
	weld.Part0 = h
	weld.Part1 = handle
	weld.C0 = GRIP
	weld.Parent = handle
	m.Parent = f.model
	sendAll({ t = "Equip", fid = f.fid, wid = wid })
end

local function setAmmo(f: F, ammo: number)
	f.ammo = ammo
	f.model:SetAttribute("Ammo", ammo)
	local w = Weapons.get(f.wid)
	if ammo <= 0 and w and w.kind ~= "melee" and w.kind ~= "throwable" then
		f.discardAt = clock() + 0.45
	end
end

-------------------------------------------------------------------------------
-- pickups

function Combat.spawnPickup(wid: number, pos: Vector3, vel: Vector3, ammo: number?, thrownBy: number?)
	local w = Weapons.get(wid)
	if not w then
		return
	end
	local m, handle = Combat.buildWeaponModel(w, true)
	m.Name = "Pickup_" .. w.key
	m:PivotTo(CFrame.new(pos.X, pos.Y, 0) * CFrame.Angles(0, 0, math.random() * math.pi * 2))
	if not thrownBy then
		local hl = Instance.new("Highlight")
		hl.FillTransparency = 0.85
		hl.FillColor = Color3.new(1, 1, 1)
		hl.OutlineColor = Color3.fromRGB(255, 240, 160)
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = m
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 240, 160)
		light.Range = 10
		light.Brightness = 1.5
		light.Parent = handle
	end
	m:SetAttribute("Pickup", true)
	m.Parent = folder("Pickups")
	handle.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y, 0)
	handle.AssemblyAngularVelocity = Vector3.new(0, 0, (math.random() - 0.5) * 16)
	pcall(function()
		handle:SetNetworkOwner(nil)
	end)
	table.insert(pickups, {
		model = m,
		handle = handle,
		wid = wid,
		ammo = if ammo then ammo else w.ammo,
		born = clock(),
		thrownBy = thrownBy or 0,
		thrownAt = if thrownBy then clock() else 0,
		dangerous = thrownBy ~= nil and vel.Magnitude > 30,
		zone = Arena.zoneAt(pos),
	})
end

function Combat.groundWeaponCount(zone: string?): number
	local n = 0
	for _, p in pickups do
		if p.thrownBy == 0 and (zone == nil or p.zone == zone) then
			n += 1
		end
	end
	return n
end

local function lockBody(part: BasePart)
	local p = part.Position
	local cf = part.CFrame
	local tilted = math.abs(cf.LookVector.Z) < 0.97
	if math.abs(p.Z) > 0.05 or tilted then
		local rv = cf.RightVector
		local a = math.atan2(rv.Y, rv.X)
		part.CFrame = CFrame.new(p.X, p.Y, 0) * CFrame.Angles(0, 0, a)
	end
	local v = part.AssemblyLinearVelocity
	local w = part.AssemblyAngularVelocity
	if math.abs(v.Z) > 0.01 or math.abs(w.X) > 0.01 or math.abs(w.Y) > 0.01 then
		part.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, 0)
		part.AssemblyAngularVelocity = Vector3.new(0, 0, w.Z)
	end
end

local function updatePickups(_dt: number)
	local now = clock()
	for i = #pickups, 1, -1 do
		local p = pickups[i]
		local z = Arena.zones[p.zone]
		local map = if z then z.map else nil
		local h = p.handle
		if not p.model.Parent or not h.Parent then
			table.remove(pickups, i)
			continue
		end
		lockBody(h)
		local pos = h.Position
		local speed = h.AssemblyLinearVelocity.Magnitude
		local w = Weapons.get(p.wid)
		local expired = now - p.born > Config.WEAPON_DESPAWN or (map and pos.Y < map.killY - 15)
		if p.ammo <= 0 and w and w.kind ~= "melee" and now - p.born > 1.5 then
			expired = true
		end
		if expired then
			p.model:Destroy()
			table.remove(pickups, i)
			continue
		end
		-- thrown weapons hurt
		if p.dangerous then
			if speed < 28 then
				p.dangerous = false
			else
				for _, f in Combat.fighters do
					if f.alive and (f.fid ~= p.thrownBy or now - p.thrownAt > 0.45) and Combat.distToBody(f, pos) < 2.6 then
						local v = h.AssemblyLinearVelocity
						local s = math.clamp(speed / 80, 0.5, 1.3)
						Combat.damage(f, p.thrownBy, {
							damage = Weapons.THROWN.damage * s,
							dir = Vector3.new(v.X, v.Y, 0).Unit,
							knock = Weapons.THROWN.knock * s,
							up = 0.35,
							ragdoll = Weapons.THROWN.ragdoll,
							kind = "thrown",
							pos = pos,
						})
						h.AssemblyLinearVelocity = Vector3.new(-v.X * 0.25, math.abs(v.Y) * 0.2 + 14, 0)
						p.dangerous = false
						break
					end
				end
			end
		end
		-- auto pickup for empty hands
		if not p.dangerous and (p.ammo > 0 or (w and w.kind == "melee")) then
			for _, f in Combat.fighters do
				if f.alive and f.wid == 0 and not Combat.isRagdoll(f) and (f.fid ~= p.thrownBy or now - p.thrownAt > 0.7) then
					if (f.root.Position - pos).Magnitude < Config.PICKUP_RADIUS + 0.8 then
						Combat.equip(f, p.wid, p.ammo)
						sendAll({ t = "Picked", fid = f.fid, wid = p.wid })
						p.model:Destroy()
						table.remove(pickups, i)
						break
					end
				end
			end
		end
	end
end

-------------------------------------------------------------------------------
-- damage + knockback

function Combat.knock(f: F, vel: Vector3, ragdoll: number)
	f.lastKnock = vel
	if ragdoll > 0 and f.alive then
		Rig.setRagdoll(f.model, true)
		f.ragdollUntil = math.max(f.ragdollUntil, clock() + ragdoll)
	end
	local floppy = ragdoll > 0 or not f.alive or Combat.isRagdoll(f)
	if f.player then
		Event:FireClient(f.player, { t = "Knock", vx = vel.X, vy = vel.Y, ragdoll = ragdoll, floppy = floppy })
	else
		if floppy then
			if f.alive then
				f.humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			end
			Rig.fling(f.model, vel, (math.random() - 0.5) * 14)
		elseif f.knockLV then
			f.knockLV.VectorVelocity = vel
			f.knockLV.Enabled = true
			f.knockUntil = clock() + Config.KNOCK_TIME
		end
	end
end

export type HitInfo = {
	damage: number,
	dir: Vector3,
	knock: number,
	up: number?,
	ragdoll: number?,
	kind: string,
	pos: Vector3?,
	headshot: boolean?,
	wid: number?,
}

function Combat.damage(victim: F, attackerFid: number, info: HitInfo)
	if victim.zone == "arena" and not Combat.hooks.active() then
		return
	end
	local dir = info.dir
	if dir.Magnitude < 1e-3 then
		dir = Vector3.new(0, 1, 0)
	end
	local damage, knock, ragdoll = info.damage, info.knock, info.ragdoll or 0
	local kind = info.kind
	local blocked, parried, deflected = false, false, false
	local facing = Combat.facing(victim)
	local fromFront = dir.X * facing < 0.2

	if victim.alive and victim.blocking and fromFront and not Combat.isRagdoll(victim) then
		if kind == "punch" or kind == "melee" or kind == "thrown" then
			blocked = true
			damage *= (1 - Config.BLOCK_REDUCTION)
			knock *= 0.35
			ragdoll = 0
			parried = kind ~= "thrown" and clock() - victim.blockStart < Config.PARRY_WINDOW
		elseif kind == "bullet" then
			local w = Weapons.get(victim.wid)
			if w and w.deflect then
				deflected = true
				damage, knock, ragdoll = 0, knock * 0.2, 0
			end
		end
	end

	local pos = info.pos or victim.root.Position
	-- lobby: everyone can shove each other around, only training dummies take damage
	if victim.zone == "lobby" and not victim.isDummy then
		damage = 0
		knock *= 0.6
		ragdoll = math.min(ragdoll, 0.6)
	end
	if victim.god then
		damage = 0
	end
	if not victim.alive then
		Combat.knock(victim, dir * knock + Vector3.new(0, (info.up or 0.35) * knock, 0), 0)
		return
	end

	local hp = math.max(0, victim.humanoid.Health - damage)
	if damage > 0 and attackerFid ~= victim.fid and attackerFid ~= 0 then
		victim.lastHitBy = attackerFid
		victim.lastHitTime = clock()
	end
	victim.stagger += damage
	if victim.stagger >= Config.STAGGER_LIMIT and ragdoll == 0 and not blocked then
		ragdoll = 0.9
		victim.stagger = 0
	end
	local vel = dir * knock + Vector3.new(0, (info.up or 0.35) * knock, 0)
	if hp <= 0 then
		victim.deathCause = kind
		victim.lastKnock = vel
	end
	Combat.knock(victim, vel, if hp <= 0 then 0 else ragdoll)

	if parried then
		local att = Combat.fighters[attackerFid]
		if att and att.alive then
			Combat.knock(att, Vector3.new(-dir.X * 45, 30, 0), 0.9)
			sendAll({ t = "Parry", fid = victim.fid, attacker = attackerFid })
		end
	end
	if deflected then
		sendAll({ t = "Deflect", fid = victim.fid, x = pos.X, y = pos.Y })
		local att = Combat.fighters[attackerFid]
		if att and att.alive and att ~= victim and info.wid then
			-- the bullet comes right back at the shooter
			task.delay(0.08, function()
				if att.alive then
					Combat.damage(att, victim.fid, { damage = info.damage * 0.5, dir = -dir, knock = info.knock, up = 0.25, kind = "deflected", pos = Combat.shoulder(att) })
				end
			end)
		end
	end

	sendAll({
		t = "Hit",
		fid = victim.fid,
		attacker = attackerFid,
		x = pos.X,
		y = pos.Y,
		damage = math.floor(damage + 0.5),
		hp = math.floor(hp + 0.5),
		blocked = blocked,
		parried = parried,
		deflected = deflected,
		headshot = info.headshot == true,
		kind = kind,
		kx = vel.X,
		ky = vel.Y,
		ragdoll = ragdoll,
	})
	victim.humanoid.Health = hp
end

function Combat.kill(f: F, cause: string)
	if not f.alive then
		return
	end
	f.deathCause = cause
	f.humanoid.Health = 0
end

-- called from Humanoid.Died
function Combat.onDied(f: F)
	if not f.alive then
		return
	end
	f.alive = false
	f.model:SetAttribute("Alive", false)
	Rig.setRagdoll(f.model, true)
	local vel = f.lastKnock or Vector3.new(0, 30, 0)
	if f.wid ~= 0 then
		Combat.unequip(f, true, vel * 0.5 + Vector3.new(0, 15, 0))
	end
	Combat.knock(f, vel, 0)
	local killer = if clock() - f.lastHitTime < 5 then f.lastHitBy else 0
	local finisher = if killer ~= 0 and killer ~= f.fid then Combat.hooks.finisherOf(killer) else nil
	sendAll({ t = "Died", fid = f.fid, killer = killer, cause = f.deathCause, finisher = finisher, zone = f.zone })
	Combat.hooks.onDeath(f, killer, f.deathCause)
end

function Combat.explode(pos: Vector3, w: Weapons.Weapon, ownerFid: number)
	sendAll({ t = "Boom", x = pos.X, y = pos.Y, r = w.radius, wid = w.id })
	for _, f in Combat.fighters do
		local d = Combat.distToBody(f, pos)
		if d < w.radius then
			local fall = 1 - (d / w.radius) * 0.7
			local to = f.root.Position - pos
			local dir = Vector3.new(to.X, to.Y + 1.5, 0)
			dir = if dir.Magnitude > 1e-3 then dir.Unit else Vector3.new(0, 1, 0)
			Combat.damage(f, ownerFid, {
				damage = w.damage * fall * (if f.fid == ownerFid then 0.5 else 1),
				dir = dir,
				knock = w.knock * fall,
				up = 0.3,
				ragdoll = w.ragdoll * fall,
				kind = "explosion",
				pos = pos,
			})
		end
	end
	for _, p in pickups do
		local to = p.handle.Position - pos
		if to.Magnitude < w.radius then
			p.handle.AssemblyLinearVelocity += Vector3.new(to.X, to.Y + 3, 0).Unit * 60
		end
	end
end

-------------------------------------------------------------------------------
-- projectiles

function Combat.launch(f: F, w: Weapons.Weapon, aim: number)
	local dir = Vector3.new(math.cos(aim), math.sin(aim), 0)
	local origin = Combat.shoulder(f) + dir * 2.2
	local hit = workspace:Raycast(Combat.shoulder(f), dir * 2.4, Combat.rayParams({ f.model }))
	if hit then
		origin = hit.Position - dir * 0.4
	end
	local p = Instance.new("Part")
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	local kind = if w.kind == "launcher" then "rocket" else "grenade"
	if kind == "rocket" then
		p.Name = "Rocket"
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(1.8, 0.7, 0.7)
		p.Color = Color3.fromRGB(76, 107, 58)
		p.CanCollide = false
		p.CFrame = CFrame.new(origin) * CFrame.Angles(0, 0, aim)
		local att = Instance.new("Attachment")
		att.Parent = p
		local lv = Instance.new("LinearVelocity")
		lv.Attachment0 = att
		lv.MaxForce = 1e7
		lv.VectorVelocity = dir * w.speed
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.Parent = p
		local nose = Instance.new("Part")
		nose.Shape = Enum.PartType.Ball
		nose.Size = Vector3.new(0.75, 0.75, 0.75)
		nose.Color = Color3.fromRGB(255, 77, 94)
		nose.Material = Enum.Material.Neon
		nose.CanCollide = false
		nose.CanQuery = false
		nose.Massless = true
		nose.CFrame = p.CFrame * CFrame.new(0.9, 0, 0)
		nose.Parent = p
		local wc = Instance.new("WeldConstraint")
		wc.Part0 = p
		wc.Part1 = nose
		wc.Parent = nose
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 160, 80)
		light.Range = 12
		light.Brightness = 3
		light.Parent = p
		p.AssemblyLinearVelocity = dir * w.speed
	else
		p.Name = "Grenade"
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(1.1, 1.1, 1.1)
		p.Color = Color3.fromRGB(47, 158, 68)
		p.Material = Enum.Material.SmoothPlastic
		p.CustomPhysicalProperties = PhysicalProperties.new(2, 0.5, 0.55, 1, 1)
		p.CFrame = CFrame.new(origin)
		local spark = Instance.new("ParticleEmitter")
		spark.Rate = 40
		spark.Lifetime = NumberRange.new(0.2, 0.4)
		spark.Speed = NumberRange.new(3, 6)
		spark.SpreadAngle = Vector2.new(60, 60)
		spark.Size = NumberSequence.new(0.25, 0)
		spark.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
		spark.LightEmission = 1
		spark.Parent = p
		local v = f.root.AssemblyLinearVelocity
		p.AssemblyLinearVelocity = dir * w.speed + Vector3.new(v.X * 0.4, 12, 0)
		p.AssemblyAngularVelocity = Vector3.new(0, 0, -f.aim * 10)
	end
	p.Parent = folder("Projectiles")
	pcall(function()
		p:SetNetworkOwner(nil)
	end)
	table.insert(projectiles, { part = p, kind = kind, wid = w.id, owner = f.fid, born = clock(), fuse = w.fuse, last = origin })
	sendAll({ t = "Launch", fid = f.fid, wid = w.id, kind = kind, x = origin.X, y = origin.Y })
end

local function updateProjectiles(dt: number)
	local now = clock()
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local p = pr.part
		if not p.Parent then
			table.remove(projectiles, i)
			continue
		end
		local w = Weapons.get(pr.wid) :: Weapons.Weapon
		local pos = p.Position
		local boom: Vector3? = nil
		if pr.kind == "rocket" then
			local owner = Combat.fighters[pr.owner]
			local ex = { p }
			if owner and now - pr.born < 0.3 then
				table.insert(ex, owner.model)
			end
			local delta = pos - pr.last
			if delta.Magnitude > 0.01 then
				local hit = workspace:Raycast(pr.last, delta, Combat.rayParams(ex))
				if hit then
					local victim = Combat.fromModel(hit.Instance)
					if not victim or victim.fid ~= pr.owner or now - pr.born > 0.3 then
						boom = hit.Position
					end
				end
			end
			if not boom then
				for _, f in Combat.fighters do
					if f.alive and (f.fid ~= pr.owner or now - pr.born > 0.3) and Combat.distToBody(f, pos) < 2.2 then
						boom = pos
						break
					end
				end
			end
			if now - pr.born > 5 then
				boom = pos
			end
			-- keep it in the plane
			if math.abs(pos.Z) > 0.05 then
				p.CFrame = CFrame.new(pos.X, pos.Y, 0) * p.CFrame.Rotation
			end
		else
			lockBody(p)
			pr.fuse -= dt
			if pr.fuse <= 0 then
				boom = pos
			end
		end
		pr.last = p.Position
		local z = Arena.zones[Arena.zoneAt(pos)]
		local map = if z then z.map else nil
		if map and pos.Y < map.killY - 20 then
			p:Destroy()
			table.remove(projectiles, i)
			continue
		end
		if boom then
			p:Destroy()
			table.remove(projectiles, i)
			Combat.explode(boom, w, pr.owner)
		end
	end
end

-------------------------------------------------------------------------------
-- attacks (shared by bots and validated player requests)

local function act(f: F, kind: string, extra: any?)
	f.lastAction[kind] = clock()
	local msg = { t = "Act", fid = f.fid, kind = kind }
	if extra then
		for k, v in extra do
			msg[k] = v
		end
	end
	sendOthers(f.player, msg)
end
Combat.act = act

local function meleeKnockDir(att: F, victim: F, aimDir: Vector3): Vector3
	local dx = victim.root.Position.X - att.root.Position.X
	local sx = if dx >= 0 then 1 else -1
	return Vector3.new(sx * math.max(0.6, math.abs(aimDir.X)), math.clamp(aimDir.Y, -0.3, 0.8), 0).Unit
end

function Combat.applyMelee(att: F, victim: F, kind: string, aimDir: Vector3, pos: Vector3?)
	local t = clock()
	if (att.meleeHits[victim.fid] or 0) > t - 0.15 then
		return
	end
	att.meleeHits[victim.fid] = t
	local dir = meleeKnockDir(att, victim, aimDir)
	if kind == "punch" then
		Combat.damage(victim, att.fid, { damage = Config.PUNCH_DAMAGE, dir = dir, knock = Config.PUNCH_KNOCK, up = 0.45, ragdoll = 0, kind = "punch", pos = pos })
	else
		local w = Weapons.get(att.wid)
		if not w or w.kind ~= "melee" then
			return
		end
		Combat.damage(victim, att.fid, { damage = w.damage, dir = dir, knock = w.knock, up = 0.4, ragdoll = w.ragdoll, kind = "melee", pos = pos, wid = w.id })
	end
end

-- server-side melee query (bots)
local function meleeVictims(att: F, center: Vector3, radius: number): { F }
	local out = {}
	for _, o in Combat.fighters do
		if o ~= att and o.alive and o.zone == att.zone and Combat.distToBody(o, center) < radius then
			table.insert(out, o)
		end
	end
	return out
end

function Combat.botPunch(f: F, hand: string)
	act(f, "punch", { hand = hand })
	task.delay(0.08, function()
		if not f.alive or Combat.isRagdoll(f) then
			return
		end
		local dir = Combat.aimDir(f)
		local center = Combat.shoulder(f) + dir * Config.PUNCH_REACH
		for _, v in meleeVictims(f, center, Config.PUNCH_RADIUS) do
			Combat.applyMelee(f, v, "punch", dir, center)
		end
	end)
end

function Combat.botSwing(f: F)
	local w = Weapons.get(f.wid)
	if not w then
		return
	end
	act(f, "swing")
	for _, delay in { 0.06, 0.13 } do
		task.delay(delay, function()
			if not f.alive or Combat.isRagdoll(f) then
				return
			end
			local dir = Combat.aimDir(f)
			local center = Combat.shoulder(f) + dir * (w.length * 0.6 + 1.2)
			for _, v in meleeVictims(f, center, w.length * 0.55 + 1.6) do
				Combat.applyMelee(f, v, "melee", dir, center)
			end
		end)
	end
end

function Combat.muzzle(f: F, w: Weapons.Weapon, aim: number): Vector3
	local dir = Vector3.new(math.cos(aim), math.sin(aim), 0)
	local sh = Combat.shoulder(f)
	local reach = 1.9 + w.length * 0.8
	local hit = workspace:Raycast(sh, dir * reach, Combat.rayParams({ f.model }))
	if hit then
		return hit.Position - dir * 0.3
	end
	return sh + dir * reach
end

-- server-simulated gun shot (bots)
function Combat.botShoot(f: F)
	local w = Weapons.get(f.wid)
	if not w or f.ammo <= 0 then
		return
	end
	setAmmo(f, f.ammo - 1)
	local seed = math.random(1, 1e6)
	local origin = Combat.muzzle(f, w, f.aim)
	local ends = {}
	local rp = Combat.rayParams({ f.model })
	for _, a in Weapons.angles(w, f.aim, seed) do
		local dir = Vector3.new(math.cos(a), math.sin(a), 0)
		local hit = workspace:Raycast(origin, dir * w.range, rp)
		local endPos = if hit then hit.Position else origin + dir * w.range
		table.insert(ends, { endPos.X, endPos.Y })
		if hit then
			local victim = Combat.fromModel(hit.Instance)
			if victim and victim ~= f then
				local head = hit.Instance.Name == "Head"
				Combat.damage(victim, f.fid, {
					damage = w.damage * (if head then w.headMult else 1),
					dir = dir,
					knock = w.knock,
					up = 0.25,
					ragdoll = w.ragdoll,
					kind = "bullet",
					pos = hit.Position,
					headshot = head,
					wid = w.id,
				})
			end
		end
	end
	if w.recoil > 0 then
		Combat.knock(f, -Vector3.new(math.cos(f.aim), math.sin(f.aim), 0) * w.recoil * 0.6, 0)
	end
	sendAll({ t = "Shot", fid = f.fid, wid = w.id, x = origin.X, y = origin.Y, ends = ends })
end

function Combat.throwWeapon(f: F, aim: number)
	local w = Weapons.get(f.wid)
	if not w then
		return
	end
	local ammo = f.ammo
	local dir = Vector3.new(math.cos(aim), math.sin(aim), 0)
	local v = f.root.AssemblyLinearVelocity
	local vel = dir * Config.THROW_SPEED + Vector3.new(v.X * 0.5, 8, 0)
	local h = hand(f)
	local pos = if h then h.Position else Combat.shoulder(f)
	local old = f.model:FindFirstChild("Weapon")
	if old then
		old:Destroy()
	end
	f.wid = 0
	f.ammo = 0
	f.discardAt = 0
	f.model:SetAttribute("Wid", 0)
	f.model:SetAttribute("Ammo", 0)
	sendAll({ t = "Unequip", fid = f.fid })
	act(f, "throw")
	if ammo > 0 or w.kind == "melee" then
		Combat.spawnPickup(w.id, Vector3.new(pos.X, pos.Y, 0), vel, ammo, f.fid)
	else
		-- empty guns still make decent projectiles
		Combat.spawnPickup(w.id, Vector3.new(pos.X, pos.Y, 0), vel, 0, f.fid)
	end
end

function Combat.botLaunch(f: F)
	local w = Weapons.get(f.wid)
	if not w or f.ammo <= 0 then
		return
	end
	setAmmo(f, f.ammo - 1)
	act(f, if w.kind == "throwable" then "lob" else "fire")
	Combat.launch(f, w, f.aim)
	if w.recoil > 0 then
		Combat.knock(f, -Combat.aimDir(f) * w.recoil * 0.6, 0)
	end
	if w.kind == "throwable" and f.ammo <= 0 then
		Combat.unequip(f, false)
	end
end

-------------------------------------------------------------------------------
-- validated player requests

local function num(v: any, default: number): number
	if type(v) == "number" and v == v and math.abs(v) < 1e6 then
		return v
	end
	return default
end
Combat.num = num

function Combat.onAct(f: F, msg: any)
	local kind = msg.kind
	if kind ~= "punch" and kind ~= "swing" and kind ~= "djump" and kind ~= "lob" and kind ~= "fire" then
		return
	end
	if not f.alive then
		return
	end
	act(f, kind, { hand = if msg.hand == "L" then "L" else "R" })
end

function Combat.onHit(f: F, msg: any)
	if not f.alive or Combat.isRagdoll(f) then
		return
	end
	local victim = Combat.fighters[num(msg.victim, -1)]
	if not victim or victim == f or victim.zone ~= f.zone then
		return
	end
	local kind = msg.kind
	local t = clock()
	local dir = Vector3.new(num(msg.dx, 1), num(msg.dy, 0), 0)
	dir = if dir.Magnitude > 1e-3 then dir.Unit else Vector3.new(Combat.facing(f), 0, 0)
	local dist = (victim.root.Position - f.root.Position).Magnitude
	if kind == "punch" then
		if t - (f.lastAction.punch or 0) > 0.6 or dist > Config.PUNCH_REACH + Config.PUNCH_RADIUS + 5 then
			return
		end
	elseif kind == "melee" then
		local w = Weapons.get(f.wid)
		if not w or w.kind ~= "melee" or t - (f.lastAction.swing or 0) > 0.7 or dist > w.length + 7 then
			return
		end
	else
		return
	end
	Combat.applyMelee(f, victim, kind, dir, Vector3.new(num(msg.x, victim.root.Position.X), num(msg.y, victim.root.Position.Y), 0))
end

function Combat.onShoot(f: F, msg: any)
	if not f.alive then
		return
	end
	local w = Weapons.get(f.wid)
	if not w or w.kind ~= "gun" or w.id ~= num(msg.wid, -1) or f.ammo <= 0 then
		return
	end
	local t = clock()
	if t - f.lastShot < w.rate * 0.6 then
		return
	end
	f.lastShot = t
	setAmmo(f, f.ammo - 1)
	local aim = num(msg.aim, f.aim)
	local seed = math.floor(num(msg.seed, 0))
	local ox, oy = num(msg.x, f.root.Position.X), num(msg.y, f.root.Position.Y)
	local origin = Vector3.new(ox, oy, 0)
	if (origin - f.root.Position).Magnitude > 12 then
		origin = Combat.muzzle(f, w, aim)
	end
	-- hits reported by the shooter, sanity checked
	local hits = if type(msg.hits) == "table" then msg.hits else {}
	local angles = Weapons.angles(w, aim, seed)
	local used = 0
	for _, h in hits do
		used += 1
		if used > w.pellets then
			break
		end
		if type(h) ~= "table" then
			continue
		end
		local victim = Combat.fighters[num(h.fid, -1)]
		if not victim or victim == f or not victim.alive or victim.zone ~= f.zone then
			continue
		end
		local hp = Vector3.new(num(h.x, 0), num(h.y, 0), 0)
		local toVictim = (victim.root.Position - origin)
		if toVictim.Magnitude > w.range + 10 or (hp - victim.root.Position).Magnitude > 8 then
			continue
		end
		local a = angles[math.clamp(math.floor(num(h.i, 1)), 1, #angles)] or aim
		local dir = Vector3.new(math.cos(a), math.sin(a), 0)
		local head = h.head == true
		Combat.damage(victim, f.fid, {
			damage = w.damage * (if head then w.headMult else 1),
			dir = dir,
			knock = w.knock,
			up = 0.25,
			ragdoll = w.ragdoll,
			kind = "bullet",
			pos = hp,
			headshot = head,
			wid = w.id,
		})
	end
	local ends = if type(msg.ends) == "table" then msg.ends else {}
	if #ends > w.pellets then
		ends = {}
	end
	sendOthers(f.player, { t = "Shot", fid = f.fid, wid = w.id, x = origin.X, y = origin.Y, ends = ends })
end

function Combat.onLaunch(f: F, msg: any)
	if not f.alive or Combat.isRagdoll(f) then
		return
	end
	local w = Weapons.get(f.wid)
	if not w or (w.kind ~= "launcher" and w.kind ~= "throwable") or f.ammo <= 0 then
		return
	end
	local t = clock()
	if t - f.lastShot < w.rate * 0.6 then
		return
	end
	f.lastShot = t
	f.aim = num(msg.aim, f.aim)
	setAmmo(f, f.ammo - 1)
	act(f, if w.kind == "throwable" then "lob" else "fire")
	Combat.launch(f, w, f.aim)
	if w.kind == "throwable" and f.ammo <= 0 then
		Combat.unequip(f, false)
	end
end

function Combat.onThrow(f: F, msg: any)
	if not f.alive or f.wid == 0 then
		return
	end
	Combat.throwWeapon(f, num(msg.aim, f.aim))
end

function Combat.onState(f: F, aim: number, flags: number)
	f.aim = aim
	local blocking = bit32.band(flags, 1) ~= 0
	if blocking and not f.blocking then
		f.blockStart = clock()
	end
	f.blocking = blocking
	f.crouch = bit32.band(flags, 2) ~= 0
end

-------------------------------------------------------------------------------
-- per frame

function Combat.update(dt: number, roundT: number)
	local now = clock()
	for _, f in Combat.fighters do
		if not f.model.Parent then
			continue
		end
		f.stagger = math.max(0, f.stagger - Config.STAGGER_DECAY * dt)
		f.hazardCd = math.max(0, f.hazardCd - dt)
		-- bots / dummies are server owned: keep them on the plane + end knockbacks
		if not f.player then
			Rig.lockPlane(f.model, f.root, if Combat.isRagdoll(f) or not f.alive then Rig.bodyParts(f.model) else nil)
			if f.knockLV and f.knockLV.Enabled and now > f.knockUntil then
				f.knockLV.Enabled = false
			end
		end
		if not f.alive then
			continue
		end
		-- get back up
		if f.ragdollUntil > 0 and now > f.ragdollUntil then
			f.ragdollUntil = 0
			Rig.setRagdoll(f.model, false)
			if f.player then
				Event:FireClient(f.player, { t = "GetUp" })
			else
				f.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end
		-- empty guns get tossed
		if f.discardAt > 0 and now > f.discardAt then
			f.discardAt = 0
			if f.wid ~= 0 and f.ammo <= 0 then
				Combat.throwWeapon(f, f.aim)
			end
		end
		local zone = Arena.zones[f.zone]
		local pos = f.root.Position
		if zone then
			local map = zone.map
			local floor = math.max(map.killY, zone.inkY)
			if pos.Y < floor or pos.X < map.bounds.left - 45 or pos.X > map.bounds.right + 45 then
				Combat.kill(f, "fell")
				continue
			end
		end
		if f.hazardCd <= 0 and (f.zone ~= "arena" or Combat.hooks.active()) then
			local kind, n = Arena.hazardAt(f.zone, pos, 1.6, roundT)
			if not kind then
				local head = f.model:FindFirstChild("Head") :: BasePart?
				if head then
					kind, n = Arena.hazardAt(f.zone, head.Position, 0.8, roundT)
				end
			end
			if kind then
				f.hazardCd = 0.5
				Combat.damage(f, if now - f.lastHitTime < 4 then f.lastHitBy else 0, {
					damage = if kind == "saw" then 22 else 30,
					dir = n,
					knock = if kind == "saw" then 75 else 55,
					up = if kind == "saw" then 0.3 else 0.6,
					ragdoll = 0.8,
					kind = kind,
					pos = pos,
				})
				sendAll({ t = "Hazard", fid = f.fid, kind = kind, x = pos.X, y = pos.Y })
			end
		end
	end
	updatePickups(dt)
	updateProjectiles(dt)
end

-- clear a zone: its pickups + projectiles, and (for the arena) its bots
function Combat.reset(zone: string)
	for i = #pickups, 1, -1 do
		local p = pickups[i]
		if p.zone == zone then
			p.model:Destroy()
			table.remove(pickups, i)
		end
	end
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		if Arena.zoneAt(pr.last) == zone then
			pr.part:Destroy()
			table.remove(projectiles, i)
		end
	end
	for fid, f in Combat.fighters do
		if f.zone == zone and not f.isDummy then
			if f.isBot and f.model.Parent then
				f.model:Destroy()
			end
			Combat.fighters[fid] = nil
		end
	end
end

function Combat.register(f: F)
	Combat.fighters[f.fid] = f
	f.humanoid.Died:Connect(function()
		Combat.onDied(f)
	end)
end

function Combat.unregister(fid: number)
	Combat.fighters[fid] = nil
end

function Combat.forPlayer(player: Player): F?
	for _, f in Combat.fighters do
		if f.player == player then
			return f
		end
	end
	return nil
end

function Combat.newFighter(fid: number, name: string, colorIndex: number, model: Model, player: Player?, zone: string, isDummy: boolean?): F
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local knock = root:FindFirstChild("Knock") :: LinearVelocity?
	return {
		fid = fid,
		name = name,
		colorIndex = colorIndex,
		model = model,
		humanoid = humanoid,
		root = root,
		player = player,
		isBot = player == nil,
		isDummy = isDummy == true,
		zone = zone,
		god = false,
		alive = true,
		wid = 0,
		ammo = 0,
		aim = if root.CFrame.LookVector.X >= 0 then 0 else math.pi,
		blocking = false,
		crouch = false,
		blockStart = 0,
		stagger = 0,
		lastHitBy = 0,
		lastHitTime = -100,
		ragdollUntil = 0,
		knockUntil = 0,
		knockLV = knock,
		deathCause = "ko",
		hazardCd = 0,
		lastAction = {},
		lastShot = 0,
		meleeHits = {},
		discardAt = 0,
		hitBudget = 0,
		brain = nil,
		lastKnock = Vector3.new(0, 30, 0),
	}
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Crates</string>
          <string name="Source"><![CDATA[--!strict
-- Server-side crate rolls (the client only plays the reveal animation).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Data = require(script.Parent:WaitForChild("Data"))

local Crates = {}

local rng = Random.new()
local lastRoll: { [Player]: number } = {}

Crates.onRare = function(_player: Player, _item: Cosmetics.Item) end

function Crates.roll(player: Player, kind: string): any
	local p = Data.get(player)
	if not p or not p.loaded then
		return { ok = false, msg = "still loading your data" }
	end
	if kind ~= "finisher" and kind ~= "spawn" then
		return { ok = false, msg = "unknown crate" }
	end
	local t = os.clock()
	if t - (lastRoll[player] or 0) < 0.8 then
		return { ok = false, msg = "slow down!" }
	end
	if not p.freeRolls and p.coins < Config.CRATE_COST then
		return { ok = false, msg = "not enough coins" }
	end
	lastRoll[player] = t
	if not p.freeRolls then
		p.coins -= Config.CRATE_COST
	end
	local item = Cosmetics.roll(kind, function()
		return rng:NextNumber()
	end, p.luck, p.forceRarity)
	p.forceRarity = nil
	local owned = p.inventory[item.id] or 0
	p.inventory[item.id] = owned + 1
	p.stats.rolls += 1
	p.stats.best = math.max(p.stats.best, item.chance)
	p.dirty = true
	local refund = 0
	if owned > 0 and item.rarity <= 2 then
		refund = Config.DUPE_REFUND
		p.coins += refund
	end
	Data.push(player)
	if item.rarity >= Config.ANNOUNCE_RARITY then
		Remotes.Event:FireAllClients({ t = "Announce", name = player.DisplayName, userId = player.UserId, item = item.id })
		Crates.onRare(player, item)
	end
	return { ok = true, item = item.id, new = owned == 0, refund = refund, count = owned + 1 }
end

Players.PlayerRemoving:Connect(function(player)
	lastRoll[player] = nil
end)

return Crates
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--!strict
-- Player profiles: coins, crate inventory, equipped cosmetics, stats.
-- Saved with DataStoreService; if that's unavailable (e.g. Studio without API access)
-- profiles still work for the session and the client is told saving is off.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Data = {}

export type Profile = {
	coins: number,
	inventory: { [string]: number },
	equipped: { finisher: string, spawn: string },
	stats: { kills: number, wins: number, rounds: number, matches: number, rolls: number, best: number },
	luck: number, -- admin testing only (not saved)
	forceRarity: number?, -- admin testing only (not saved)
	freeRolls: boolean, -- admin testing only (not saved)
	loaded: boolean,
	dirty: boolean,
}

local store: DataStore? = nil
Data.saving = false
local profiles: { [Player]: Profile } = {}

do
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE)
	end)
	if ok then
		store = s
		Data.saving = true
	end
end

local function fresh(): Profile
	return {
		coins = Config.START_COINS,
		inventory = { [Cosmetics.DEFAULT.finisher] = 1, [Cosmetics.DEFAULT.spawn] = 1 },
		equipped = { finisher = Cosmetics.DEFAULT.finisher, spawn = Cosmetics.DEFAULT.spawn },
		stats = { kills = 0, wins = 0, rounds = 0, matches = 0, rolls = 0, best = 0 },
		luck = 1,
		forceRarity = nil,
		freeRolls = false,
		loaded = false,
		dirty = false,
	}
end

local function serialize(p: Profile): any
	return { v = 1, coins = p.coins, inventory = p.inventory, equipped = p.equipped, stats = p.stats }
end

local function merge(p: Profile, saved: any)
	if type(saved) ~= "table" then
		return
	end
	if type(saved.coins) == "number" then
		p.coins = math.max(0, math.floor(saved.coins))
	end
	if type(saved.inventory) == "table" then
		for id, n in saved.inventory do
			if Cosmetics.byId[id] and type(n) == "number" then
				p.inventory[id] = math.max(p.inventory[id] or 0, math.floor(n))
			end
		end
	end
	if type(saved.equipped) == "table" then
		for _, kind in Cosmetics.KINDS do
			local id = saved.equipped[kind]
			if type(id) == "string" and p.inventory[id] and Cosmetics.byId[id].kind == kind then
				(p.equipped :: any)[kind] = id
			end
		end
	end
	if type(saved.stats) == "table" then
		for k, v in saved.stats do
			if type(v) == "number" and (p.stats :: any)[k] ~= nil then
				(p.stats :: any)[k] = v
			end
		end
	end
end

function Data.get(player: Player): Profile?
	return profiles[player]
end

function Data.public(player: Player): any
	local p = profiles[player]
	if not p then
		return nil
	end
	return {
		coins = p.coins,
		inventory = p.inventory,
		equipped = p.equipped,
		stats = p.stats,
		saving = Data.saving,
		luck = p.luck,
		forceRarity = p.forceRarity,
		freeRolls = p.freeRolls,
	}
end

function Data.push(player: Player)
	if player.Parent then
		Remotes.Event:FireClient(player, { t = "Profile", profile = Data.public(player) })
	end
	local p = profiles[player]
	local ls = player:FindFirstChild("leaderstats")
	if p and ls then
		local coins = ls:FindFirstChild("Coins") :: IntValue?
		local wins = ls:FindFirstChild("Wins") :: IntValue?
		if coins then
			coins.Value = p.coins
		end
		if wins then
			wins.Value = p.stats.wins
		end
	end
end

function Data.load(player: Player): Profile
	local p = fresh()
	profiles[player] = p
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = ls
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = ls
	ls.Parent = player
	local s = store
	if s and Data.saving then
		for attempt = 1, 3 do
			local ok, res = pcall(function()
				return s:GetAsync("u_" .. player.UserId)
			end)
			if ok then
				merge(p, res)
				break
			else
				warn("[Ragdoll Rumble] data load failed (attempt " .. attempt .. "):", res)
				if string.find(tostring(res), "Studio") or string.find(tostring(res), "API") then
					Data.saving = false
					break
				end
				task.wait(1.5 * attempt)
			end
		end
	end
	p.loaded = true
	Data.push(player)
	return p
end

function Data.save(player: Player)
	local p = profiles[player]
	local s = store
	if not p or not p.loaded or not s or not Data.saving then
		return
	end
	local payload = serialize(p)
	local ok, err = pcall(function()
		s:SetAsync("u_" .. player.UserId, payload)
	end)
	if ok then
		p.dirty = false
	else
		warn("[Ragdoll Rumble] data save failed:", err)
	end
end

function Data.release(player: Player)
	Data.save(player)
	profiles[player] = nil
end

function Data.addCoins(player: Player, n: number, reason: string?)
	local p = profiles[player]
	if not p or n == 0 then
		return
	end
	p.coins = math.max(0, p.coins + math.floor(n))
	p.dirty = true
	Data.push(player)
	if reason and n > 0 then
		Remotes.Event:FireClient(player, { t = "Coins", amount = math.floor(n), reason = reason })
	end
end

function Data.stat(player: Player, key: string, delta: number)
	local p = profiles[player]
	if p and (p.stats :: any)[key] ~= nil then
		(p.stats :: any)[key] += delta
		p.dirty = true
	end
end

function Data.equip(player: Player, id: string): (boolean, string?)
	local p = profiles[player]
	local item = Cosmetics.byId[id]
	if not p or not item then
		return false, "unknown item"
	end
	if (p.inventory[id] or 0) <= 0 then
		return false, "you don't own that yet"
	end
	(p.equipped :: any)[item.kind] = id
	p.dirty = true
	Data.push(player)
	return true, nil
end

function Data.equipped(player: Player?, kind: string): string
	local p = if player then profiles[player] else nil
	if p then
		return (p.equipped :: any)[kind]
	end
	return (Cosmetics.DEFAULT :: any)[kind]
end

function Data.reset(player: Player)
	local old = profiles[player]
	local p = fresh()
	p.loaded = true
	p.dirty = true
	if old then
		p.luck = old.luck
	end
	profiles[player] = p
	Data.push(player)
end

-- autosave + shutdown save
task.spawn(function()
	while true do
		task.wait(Config.AUTOSAVE)
		for player, p in profiles do
			if p.dirty then
				Data.save(player)
			end
		end
	end
end)

game:BindToClose(function()
	local threads = {}
	for _, player in Players:GetPlayers() do
		table.insert(threads, task.spawn(Data.save, player))
	end
	task.wait(2)
end)

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--!strict
-- The Arcade: lobby stations (crate machine, locker, ready portal, leaderboard, training
-- dummies + weapons to test on them).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Maps = require(Shared:WaitForChild("Maps"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local Arena = require(script.Parent:WaitForChild("Arena"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Data = require(script.Parent:WaitForChild("Data"))

local Lobby = {}

local map = Maps.lobby
local st = map.stations
local portalGlow: BasePart? = nil
local board: SurfaceGui? = nil
local machineBeam: BasePart? = nil
Lobby.ready = {} :: { [Player]: boolean }
Lobby.uiReady = {} :: { [Player]: boolean }

local c3 = Arena.c3
local deco = Arena.deco

local function prompt(parent: BasePart, action: string, object: string, panel: string)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonY
	p.MaxActivationDistance = 9
	p.RequiresLineOfSight = false
	p.HoldDuration = 0
	p.Style = Enum.ProximityPromptStyle.Default
	p:SetAttribute("Panel", panel)
	p.Parent = parent
end

local function station(name: string, x: number, y: number, z: number, scale: number, fallback: (Model) -> ()): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = (Arena.zones.lobby :: Arena.Zone).folder
	fallback(m)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d:SetAttribute("Fallback", true)
		end
	end
	Arena.skinAnchor(name, CFrame.new(x, y, z), scale, m)
	return m
end

function Lobby.build()
	local zone = Arena.build("lobby", map)
	local th = map.theme

	-- crate machine
	local mx = st.machine.x
	station("machine", mx, 1000, -4, 1, function(m)
		deco({ Size = Vector3.new(5.4, 9, 3.6), CFrame = CFrame.new(mx, 1004.5, -4), Color = c3(0x8b5cf6) }, m)
		deco({ Size = Vector3.new(3.6, 2.2, 0.2), CFrame = CFrame.new(mx, 1005.3, -2.1), Color = c3(0xff5dcf), Material = Enum.Material.Neon }, m)
	end)
	local mp = deco({ Name = "MachinePrompt", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(mx, 1003, 0), Transparency = 1 }, zone.folder)
	prompt(mp, "Open Crates", "Crate Machine", "crates")
	machineBeam = deco({ Name = "MachineBeam", Size = Vector3.new(3, 400, 3), CFrame = CFrame.new(mx, 1210, -4), Color = c3(0xffd36e), Material = Enum.Material.Neon, Transparency = 1 }, zone.folder)
	for i, key in { "crate_finisher", "crate_spawn" } do
		local x = mx - 6 - i * 0.4
		station(key, x, 1001.5 + (i - 1) * 3.05, -5, 1, function(m)
			deco({ Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(x, 1001.5 + (i - 1) * 3.05, -5), Color = if i == 1 then c3(0xb0283a) else c3(0x1e4e8c), Material = Enum.Material.WoodPlanks }, m)
		end)
	end

	-- locker
	local lx = st.locker.x
	station("locker", lx, 1000, -4, 1, function(m)
		deco({ Size = Vector3.new(3.2, 6, 2), CFrame = CFrame.new(lx, 1003, -4), Color = c3(0x1e4e8c) }, m)
	end)
	local lp = deco({ Name = "LockerPrompt", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(lx, 1003, 0), Transparency = 1 }, zone.folder)
	prompt(lp, "Open Locker", "Locker", "locker")

	-- ready portal
	local px = st.portal.x
	station("portal", px, 1003.8, -3, 1, function(m)
		deco({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 7, 7), CFrame = CFrame.new(px, 1003.8, -3) * CFrame.Angles(0, math.pi / 2, 0), Color = c3(0x16181f) }, m)
	end)
	portalGlow = deco({ Name = "PortalGlow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 5.6, 5.6), CFrame = CFrame.new(px, 1003.8, -3.2) * CFrame.Angles(0, math.pi / 2, 0), Color = c3(th.accent), Material = Enum.Material.Neon, Transparency = 0.6 }, zone.folder)
	local sign = deco({ Name = "PortalSign", Size = Vector3.new(8, 1.6, 0.3), CFrame = CFrame.new(px, 1008.8, -3), Transparency = 1 }, zone.folder)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.LightInfluence = 0
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 50
	sg.Parent = sign
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.LuckiestGuy
	lbl.TextScaled = true
	lbl.Text = "STAND HERE TO READY UP"
	lbl.TextColor3 = c3(th.accent)
	lbl.Parent = sg

	-- leaderboard
	local bx, by = st.board.x, st.board.y
	local bp = deco({ Name = "Board", Size = Vector3.new(26, 11, 0.6), CFrame = CFrame.new(bx, by, -8.6), Color = c3(0x16132b) }, zone.folder)
	deco({ Size = Vector3.new(26.8, 11.8, 0.4), CFrame = CFrame.new(bx, by, -8.8), Color = c3(th.edge), Material = Enum.Material.Neon }, zone.folder)
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Back
	g.LightInfluence = 0
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.Parent = bp
	board = g

	-- logo, trophy, lamps, benches, targets
	station("logo", 0, 1031.5, -8.4, 1.15, function(m)
		local p = deco({ Size = Vector3.new(17, 7.5, 0.6), CFrame = CFrame.new(0, 1031.5, -8.4), Color = c3(0x16181f) }, m)
		local lg = Instance.new("SurfaceGui")
		lg.Face = Enum.NormalId.Back
		lg.LightInfluence = 0
		lg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		lg.PixelsPerStud = 30
		lg.Parent = p
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.Text = "RAGDOLL\nRUMBLE"
		t.TextColor3 = c3(0xff5dcf)
		t.Parent = lg
	end)
	station("trophy", st.trophy.x, st.trophy.y, -2.5, 0.9, function(m)
		deco({ Size = Vector3.new(2, 3, 2), CFrame = CFrame.new(st.trophy.x, st.trophy.y + 1.5, -2.5), Color = c3(0xffc93c), Material = Enum.Material.Metal }, m)
	end)
	for i, x in st.lamps do
		station("lamp", x, 1000, -6, 1, function(m)
			deco({ Size = Vector3.new(0.3, 7, 0.3), CFrame = CFrame.new(x, 1003.5, -6), Color = c3(0x2b2f3a) }, m)
		end)
		local light = deco({ Name = "LampLight" .. i, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(x + 1.4, 1006.5, -6), Transparency = 1 }, zone.folder)
		local pl = Instance.new("PointLight")
		pl.Color = c3(0xffd36e)
		pl.Range = 18
		pl.Brightness = 1.6
		pl.Parent = light
	end
	for _, x in st.benches do
		station("bench", x, 1000, -5, 1, function(m)
			deco({ Size = Vector3.new(4, 0.3, 1.2), CFrame = CFrame.new(x, 1001.1, -5), Color = c3(0x9a6233) }, m)
		end)
	end
	for _, d in st.dummies do
		station("target", d[1], 1007, -5, 0.8, function(m)
			deco({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2.6, 2.6), CFrame = CFrame.new(d[1], 1007, -5) * CFrame.Angles(0, math.pi / 2, 0), Color = c3(0xff4d5e) }, m)
		end)
	end
	-- training sign
	local ts = deco({ Size = Vector3.new(14, 2, 0.3), CFrame = CFrame.new(46, 1013.5, -6), Transparency = 1 }, zone.folder)
	local tg = Instance.new("SurfaceGui")
	tg.Face = Enum.NormalId.Back
	tg.LightInfluence = 0
	tg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	tg.PixelsPerStud = 40
	tg.Parent = ts
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.LuckiestGuy
	tl.TextScaled = true
	tl.Text = "TRAINING ZONE"
	tl.TextColor3 = c3(0xffd36e)
	tl.Parent = tg
	return zone
end

-- light pillar when someone rolls something rare
function Lobby.celebrate(color: Color3)
	local b = machineBeam
	if not b then
		return
	end
	b.Color = color
	b.Transparency = 0.15
	task.delay(4, function()
		if b.Parent then
			b.Transparency = 1
		end
	end)
end

function Lobby.spawnPoint(): (number, number)
	local sp = map.spawns[math.random(1, #map.spawns)]
	return sp[1] + (math.random() - 0.5) * 2, sp[2]
end

local weaponTimer = 0
local boardTimer = 0

local function refreshBoard()
	local g = board
	if not g then
		return
	end
	g:ClearAllChildren()
	local rows = {}
	for _, player in Players:GetPlayers() do
		local p = Data.get(player)
		if p then
			table.insert(rows, { name = player.DisplayName, wins = p.stats.wins, kills = p.stats.kills, coins = p.coins })
		end
	end
	table.sort(rows, function(a, b)
		if a.wins ~= b.wins then
			return a.wins > b.wins
		end
		return a.kills > b.kills
	end)
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 80)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.LuckiestGuy
	title.TextSize = 64
	title.Text = "TOP BRAWLERS"
	title.TextColor3 = Color3.fromRGB(255, 211, 110)
	title.Parent = g
	for i = 1, math.min(6, #rows) do
		local r = rows[i]
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, -60, 0, 52)
		l.Position = UDim2.fromOffset(30, 80 + (i - 1) * 56)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.FredokaOne
		l.TextSize = 40
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = if i == 1 then Color3.fromRGB(255, 211, 110) else Color3.fromRGB(230, 226, 255)
		l.Text = string.format("%d. %s   🏆 %d   💥 %d", i, r.name, r.wins, r.kills)
		l.Parent = g
	end
end

function Lobby.update(dt: number)
	-- ready by standing in the portal
	local count, ready = 0, 0
	for _, player in Players:GetPlayers() do
		local f = Combat.forPlayer(player)
		local inPortal = false
		if f and f.zone == "lobby" and f.alive then
			local pos = f.root.Position
			inPortal = math.abs(pos.X - st.portal.x) < 3.4 and pos.Y < st.portal.y + 7
		end
		Lobby.ready[player] = inPortal or Lobby.uiReady[player] == true
		if f and f.zone == "lobby" then
			count += 1
			if Lobby.ready[player] then
				ready += 1
			end
		end
	end
	local pg = portalGlow
	if pg then
		pg.Transparency = if count > 0 then 0.6 - 0.5 * (ready / count) else 0.6
	end
	-- test weapons in the training zone
	weaponTimer -= dt
	if weaponTimer <= 0 then
		weaponTimer = 6
		if Combat.groundWeaponCount("lobby") < Config.LOBBY_WEAPONS then
			local w = Weapons.pick(math.random())
			Combat.spawnPickup(w.id, Vector3.new(map.weaponX[1] + math.random() * (map.weaponX[2] - map.weaponX[1]), map.weaponY, 0), Vector3.new(0, -5, 0))
		end
	end
	boardTimer -= dt
	if boardTimer <= 0 then
		boardTimer = 5
		refreshBoard()
	end
end

Players.PlayerRemoving:Connect(function(player)
	Lobby.ready[player] = nil
	Lobby.uiReady[player] = nil
end)

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Spawner</string>
          <string name="Source"><![CDATA[--!strict
-- Puts fighters into the world: player avatars (LoadCharacterAsync), bots and lobby dummies.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rig = require(Shared:WaitForChild("Rig"))

local Arena = require(script.Parent:WaitForChild("Arena"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Bots = require(script.Parent:WaitForChild("Bots"))

local Spawner = {}

export type Who = { fid: number, name: string, colorIndex: number, player: Player?, isBot: boolean }

local function fightersFolder(): Folder
	local f = workspace:FindFirstChild("Fighters")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Fighters"
		f.Parent = workspace
	end
	return f :: Folder
end

Spawner.onSpawned = function(_f: Combat.F) end

-- configure a freshly spawned rig and register it
function Spawner.setup(who: Who, model: Model, zone: string, x: number, y: number, frozen: boolean, isDummy: boolean?): Combat.F?
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root then
		return nil
	end
	-- replace any previous registration for this fighter id
	local old = Combat.fighters[who.fid]
	if old and old.model ~= model then
		Combat.unregister(who.fid)
		if old.isBot and old.model.Parent then
			old.model:Destroy()
		end
	end
	if not root:FindFirstChild("Facing") then
		Rig.setup(model)
	end
	model:PivotTo(Arena.spawnCFrame(zone, x, y))
	hum.MaxHealth = Config.MAX_HP
	hum.Health = Config.MAX_HP
	hum.UseJumpPower = true
	hum.WalkSpeed = if frozen then 0 else Config.WALK_SPEED
	hum.JumpPower = if frozen then 0 else Config.JUMP_POWER
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.AutoRotate = false
	model:SetAttribute("Fid", who.fid)
	model:SetAttribute("ColorIndex", who.colorIndex)
	model:SetAttribute("FighterName", who.name)
	model:SetAttribute("IsBot", who.isBot)
	model:SetAttribute("IsDummy", isDummy == true)
	model:SetAttribute("Zone", zone)
	model:SetAttribute("Wid", 0)
	model:SetAttribute("Ammo", 0)
	model:SetAttribute("Alive", true)
	model:SetAttribute("Ragdoll", false)
	model:SetAttribute("Victory", false)
	local z = Arena.zones[zone]
	local cx = if z then (z.map.bounds.left + z.map.bounds.right) * 0.5 else 0
	local facing = if x > cx then -1 else 1
	local fo = root:FindFirstChild("Facing") :: AlignOrientation?
	if fo then
		fo.CFrame = Rig.facingCFrame(facing)
	end
	model.Parent = fightersFolder()
	local f = Combat.newFighter(who.fid, who.name, who.colorIndex, model, who.player, zone, isDummy)
	f.aim = if facing > 0 then 0 else math.pi
	if who.isBot then
		f.brain = Bots.newBrain(math.random(1, 1e6), if isDummy then 0 else 0.45 + math.random() * 0.4)
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	Combat.register(f)
	Spawner.onSpawned(f)
	return f
end

local tokens: { [number]: number } = {}

-- async; a newer spawn request for the same fighter cancels older ones
function Spawner.spawn(who: Who, zone: string, x: number, y: number, frozen: boolean, isDummy: boolean?)
	local token = (tokens[who.fid] or 0) + 1
	tokens[who.fid] = token
	task.spawn(function()
		if who.player then
			local player = who.player :: Player
			local ok, err = pcall(function()
				(player :: any):LoadCharacterAsync()
			end)
			if not ok then
				ok, err = pcall(function()
					player:LoadCharacter()
				end)
			end
			if not ok then
				warn("[Ragdoll Rumble] could not load character:", err)
				return
			end
			local char = player.Character
			if not char or tokens[who.fid] ~= token then
				return
			end
			char:WaitForChild("HumanoidRootPart", 6)
			char:WaitForChild("Humanoid", 6)
			if tokens[who.fid] ~= token or not char.Parent or not player.Parent then
				return
			end
			Spawner.setup(who, char, zone, x, y, frozen, false)
		else
			local tpl = Bots.template(who.colorIndex)
			if not tpl or tokens[who.fid] ~= token then
				return
			end
			local m = tpl:Clone()
			m.Name = who.name
			Spawner.setup(who, m, zone, x, y, frozen, isDummy)
		end
	end)
end

function Spawner.cancel(fid: number)
	tokens[fid] = (tokens[fid] or 0) + 1
end

return Spawner
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CharacterJumpPower">54</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">21</float>
      <token name="DevComputerMovementMode">3</token>
      <token name="DevTouchMovementMode">5</token>
      <bool name="EnableMouseLockOption">false</bool>
      <token name="GameSettingsAvatar">1</token>
    </Properties>
    <Item class="StarterCharacterScripts" referent="24">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- Replaces Roblox's default "Animate" script on purpose.
-- Ragdoll Rumble animates every fighter procedurally on each client
-- (see StarterPlayerScripts > RumbleClient > Animator), so no default animations run.
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="26">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Replaces Roblox's default "Health" script on purpose: no health regeneration mid-round.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">RumbleClient</string>
          <string name="Source"><![CDATA[--!strict
-- Ragdoll Rumble client: input, procedural animation, camera, effects, sound, UI glue.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Maps = require(Shared:WaitForChild("Maps"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Motion = require(Shared:WaitForChild("Motion"))
local Util = require(Shared:WaitForChild("Util"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Audio = require(script:WaitForChild("Audio"))
local Input = require(script:WaitForChild("Input"))
local CameraRig = require(script:WaitForChild("CameraRig"))
local Animator = require(script:WaitForChild("Animator"))
local Effects = require(script:WaitForChild("Effects"))
local Skins = require(script:WaitForChild("Skins"))
local Tags = require(script:WaitForChild("Tags"))
local UI = require(script:WaitForChild("UIKit"))
local Store = require(script:WaitForChild("Store"))
local Hud = require(script:WaitForChild("Hud"))
local Menu = require(script:WaitForChild("Menu"))
local CrateUI = require(script:WaitForChild("CrateUI"))
local AdminUI = require(script:WaitForChild("AdminUI"))
local CosmeticFx = require(script:WaitForChild("CosmeticFx"))
local Controller = require(script:WaitForChild("Controller"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Event = Remotes.Event
local State = Remotes.State

-------------------------------------------------------------------------------
-- setup

Audio.init()
Effects.init()
UI.click = function()
	Audio.play("click")
end
UI.hover = function()
	Audio.play("tick", 0.25, 1.6)
end
Hud.init(playerGui)
Menu.init(playerGui)
CrateUI.init(playerGui)
AdminUI.init(Menu.gui())
Input.init(Hud.toggleHelp)
Controller.init()
Skins.init(function(ok: boolean, err: string?)
	Store.emit("skinsReady", ok)
	if not ok then
		warn("[Ragdoll Rumble] using part models:", err)
	end
end)

Menu.onAdmin = AdminUI.toggle
Menu.onPreview = function(id: string)
	local c = player.Character
	local r = if c then c:FindFirstChild("HumanoidRootPart") else nil
	if r and r:IsA("BasePart") then
		CosmeticFx.preview(id, r.Position, Tags.color(c :: Model))
	end
end

task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, false)
			StarterGui:SetCore("ResetButtonCallback", false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local function post(className: string, props: { [string]: any })
	local name = "Rumble" .. className
	local e = Lighting:FindFirstChild(name) or Instance.new(className)
	e.Name = name
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = Lighting
end
post("BloomEffect", { Intensity = 0.7, Size = 26, Threshold = 0.92 })
post("ColorCorrectionEffect", { Saturation = 0.15, Contrast = 0.08, Brightness = 0.02 })
post("SunRaysEffect", { Intensity = 0.04, Spread = 0.6 })

-------------------------------------------------------------------------------
-- helpers

local fightTime = 0
local roundStart = 0
local lastCount = -1
local saws: { { part: BasePart, def: any } } = {}
local viewZone = "lobby"
local lightingFor = ""
local matchCoins = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function fighters(): Folder?
	return workspace:FindFirstChild("Fighters") :: Folder?
end

local function modelOf(fid: number): Model?
	local f = fighters()
	if not f then
		return nil
	end
	for _, m in f:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("Fid") == fid then
			return m
		end
	end
	return nil
end

local function rootOf(fid: number): BasePart?
	local m = modelOf(fid)
	local r = if m then m:FindFirstChild("HumanoidRootPart") else nil
	return if r and r:IsA("BasePart") then r else nil
end

local function nameOf(fid: number): string
	if fid == Store.myFid then
		return "You"
	end
	for _, s in Store.scores do
		if s.fid == fid then
			return s.name
		end
	end
	local m = modelOf(fid)
	return if m then (m:GetAttribute("FighterName") or m.Name) :: string else "???"
end

local function colorOf(fid: number): Color3
	local m = modelOf(fid)
	if m then
		return Tags.color(m)
	end
	for _, s in Store.scores do
		if s.fid == fid then
			local c = Config.COLORS[s.color]
			if c then
				return c.main
			end
		end
	end
	return Color3.new(1, 1, 1)
end

local function c3(hex: number): Color3
	local r, g, b = Util.hexToRGB(hex)
	return Color3.fromRGB(r, g, b)
end

local function mapForZone(zone: string): any?
	if zone == "lobby" then
		return Maps.lobby
	end
	local mi = workspace:GetAttribute("MapIndex")
	if type(mi) == "number" and mi > 0 then
		return Maps.get(mi)
	end
	return nil
end

local function applyLighting(map: any)
	local th = map.theme
	Lighting.ClockTime = th.clock or 14
	Lighting.Brightness = if th.kind == "neon" or th.kind == "lab" or th.kind == "lobby" then 1.3 else 2.2
	Lighting.Ambient = c3(th.skyTop):Lerp(Color3.new(1, 1, 1), 0.45)
	Lighting.OutdoorAmbient = c3(th.skyBottom):Lerp(Color3.new(1, 1, 1), 0.35)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	CameraRig.setBounds(map.bounds)
end

local function refreshArena()
	saws = {}
	local arena = workspace:FindFirstChild("Arena")
	local map = mapForZone("arena")
	if arena and map then
		for _, c in arena:GetChildren() do
			local idx = c:GetAttribute("SawIndex")
			if c:IsA("BasePart") and type(idx) == "number" and map.hazards[idx] then
				table.insert(saws, { part = c, def = map.hazards[idx] })
			end
		end
	end
end

local function paintGeometry()
	local zone = if viewZone == "lobby" then workspace:FindFirstChild("Lobby") else workspace:FindFirstChild("Arena")
	Effects.setGeometry(if zone then zone:FindFirstChild("Geometry") else nil)
end

workspace.ChildAdded:Connect(function(c)
	if c.Name == "Arena" or c.Name == "Lobby" then
		task.wait(0.5)
		refreshArena()
		paintGeometry()
		lightingFor = ""
	end
end)

-------------------------------------------------------------------------------
-- fighters coming and going

local function onFighter(m: Instance)
	if not m:IsA("Model") then
		return
	end
	local model = m :: Model
	task.spawn(function()
		for _ = 1, 60 do
			if model:GetAttribute("Fid") and model:FindFirstChild("HumanoidRootPart") and model:FindFirstChild("Head") then
				break
			end
			task.wait(0.1)
		end
		if not model.Parent then
			return
		end
		Animator.track(model)
		Tags.add(model, model == player.Character)
		local function decorate(child: Instance)
			if child.Name == "Weapon" and child:IsA("Model") then
				task.wait()
				Effects.decorateWeapon(child, Tags.color(model))
			end
		end
		for _, c in model:GetChildren() do
			decorate(c)
		end
		model.ChildAdded:Connect(decorate)
	end)
end

task.spawn(function()
	local folder = workspace:WaitForChild("Fighters")
	for _, m in folder:GetChildren() do
		onFighter(m)
	end
	folder.ChildAdded:Connect(onFighter)
	folder.ChildRemoved:Connect(function(m)
		if m:IsA("Model") then
			Animator.untrack(m)
			Tags.remove(m)
		end
	end)
end)

-------------------------------------------------------------------------------
-- server events

local handlers: { [string]: (any) -> () } = {}

local function setScores(scores: { any }?)
	if scores then
		Store.scores = scores
		Hud.setScores(scores)
	end
end

handlers.Welcome = function(msg)
	Store.myFid = msg.fid
	Store.isAdmin = msg.isAdmin == true
	Store.emit("admin", Store.isAdmin)
	setScores(msg.scores)
	Menu.setProfile(msg.profile)
	if msg.info and msg.info.phase == "match" then
		fightTime = msg.info.fight
		roundStart = msg.info.start
		Hud.setRoster(Store.scores)
	end
	if Store.isAdmin then
		UI.toast("You're an admin · press F2 or use the ADMIN button", Color3.fromRGB(255, 143, 60), 5)
	end
end

handlers.Profile = function(msg)
	Menu.setProfile(msg.profile)
end

handlers.Coins = function(msg)
	Menu.coinPopup(msg.amount, msg.reason)
	if workspace:GetAttribute("Phase") ~= "lobby" then
		matchCoins += msg.amount
	end
end

handlers.Scores = function(msg)
	setScores(msg.scores)
end

handlers.MatchStart = function(_msg)
	matchCoins = 0
	Audio.play("fight", 1, 0.8)
end

handlers.RoundStart = function(msg)
	setScores(msg.scores)
	Hud.setRoster(Store.scores)
	Hud.spectate("")
	Hud.suddenDeath(false)
	local info = msg.info
	fightTime = info.fight
	roundStart = info.start
	lastCount = -1
	local map = Maps.get(info.map)
	Effects.clearSplats()
	if viewZone == "arena" or info.round == 1 then
		Hud.banner(string.upper(map.name), "Round " .. tostring(info.round) .. "  ·  " .. map.subtitle, c3(map.theme.edge), 2.4)
	end
	task.delay(1, refreshArena)
	task.delay(3, refreshArena)
end

handlers.Fight = function(_msg)
	if lastCount ~= 0 and viewZone == "arena" then
		lastCount = 0
		Hud.count("FIGHT!", UI.C.red)
		Audio.play("fight")
	end
end

handlers.Act = function(msg)
	Animator.trigger(msg.fid, msg.kind, msg.hand)
	local r = rootOf(msg.fid)
	if msg.kind == "punch" then
		Audio.play("whoosh", 0.6)
	elseif msg.kind == "swing" then
		Audio.play("slash", 0.7)
		local m = modelOf(msg.fid)
		if r and m then
			local facing = if r.CFrame.LookVector.X >= 0 then 1 else -1
			Effects.slash(r.Position + Vector3.new(facing * 2.4, 1.4, 0), if facing > 0 then 0 else math.pi, Tags.color(m), facing)
		end
	elseif msg.kind == "lob" or msg.kind == "throw" then
		Audio.play("throw", 0.7)
	elseif msg.kind == "djump" and r then
		Effects.ring(r.Position - Vector3.new(0, 2.4, 0), colorOf(msg.fid), 4)
		Audio.play("djump", 0.6)
	end
end

handlers.Shot = function(msg)
	local w = Weapons.get(msg.wid)
	if not w then
		return
	end
	local origin = Vector3.new(msg.x, msg.y, 0)
	local rr, gg, bb = Util.hexToRGB(w.tracer)
	local col = Color3.fromRGB(rr, gg, bb)
	local aim = 0
	for i, e in msg.ends or {} do
		if type(e) == "table" and type(e[1]) == "number" and type(e[2]) == "number" then
			local endPos = Vector3.new(e[1], e[2], 0)
			Effects.tracer(origin, endPos, col, if w.key == "longshot" then 0.35 else 0.18)
			Effects.spark(endPos, col, 3, 18, 0.22)
			if i == 1 then
				aim = math.atan2(e[2] - msg.y, e[1] - msg.x)
			end
		end
	end
	Effects.muzzle(origin, aim, col)
	local r = rootOf(msg.fid)
	if r then
		Effects.shell(r.Position + Vector3.new(0, 1.5, 0), if r.CFrame.LookVector.X >= 0 then 1 else -1)
	end
	Animator.trigger(msg.fid, "fire")
	Audio.play(w.sound, 0.75)
end

handlers.Launch = function(msg)
	if msg.fid == Store.myFid then
		return
	end
	if msg.kind == "rocket" then
		Audio.play("rocket", 0.8)
		Effects.muzzle(Vector3.new(msg.x, msg.y, 0), 0, Color3.fromRGB(255, 160, 80))
	else
		Audio.play("lob", 0.7)
	end
end

handlers.Hit = function(msg)
	local pos = Vector3.new(msg.x, msg.y, 0)
	local victimColor = colorOf(msg.fid)
	local push = Vector3.new(msg.kx or 0, msg.ky or 0, 0)
	local big = (msg.ragdoll or 0) > 0 or msg.damage >= 25
	local r = rootOf(msg.fid)
	if r then
		local facing = if r.CFrame.LookVector.X >= 0 then 1 else -1
		Animator.trigger(msg.fid, "flinch", nil, if (push.X * facing) < 0 then 1 else -1)
	end
	if msg.blocked then
		Effects.spark(pos, Color3.fromRGB(180, 220, 255), 10, 30)
		Effects.ring(pos, Color3.fromRGB(180, 220, 255), 3)
		Effects.text(pos + Vector3.new(0, 2, 0), if msg.parried then "PARRY!" else "BLOCK", Color3.fromRGB(180, 220, 255), if msg.parried then 34 else 24)
		Audio.play(if msg.parried then "parry" else "block")
		CameraRig.shake(if msg.parried then 0.35 else 0.1)
		return
	end
	if msg.deflected then
		Effects.spark(pos, Color3.new(1, 1, 1), 12, 40)
		Effects.text(pos + Vector3.new(0, 2, 0), "DEFLECT!", Color3.new(1, 1, 1), 28)
		Audio.play("deflect")
		return
	end
	if msg.damage > 0 or (msg.kx or 0) ~= 0 then
		Effects.paint(pos, push * 0.35, victimColor, math.clamp(math.floor(math.max(msg.damage, 8) / 4), 3, 16))
		if msg.attacker ~= Store.myFid or (msg.kind ~= "punch" and msg.kind ~= "melee") then
			Effects.spark(pos, Color3.new(1, 1, 1), if big then 14 else 7, if big then 55 else 30)
			Effects.ring(pos, victimColor, if big then 4 else 2.4)
		end
		if big then
			Effects.stars(pos, Color3.fromRGB(255, 236, 150), 4)
		end
		if Store.settings.numbers and msg.damage > 0 then
			local col = if msg.headshot then Color3.fromRGB(255, 80, 80) else Color3.fromRGB(255, 240, 200)
			Effects.text(pos + Vector3.new(0, 1.5, 0), (if msg.headshot then "HEADSHOT " else "") .. tostring(msg.damage), col, if big then 30 else 22, 0.7)
		end
	end
	if msg.kind == "punch" then
		Audio.play(if big then "heavy" else "punch", if msg.attacker == Store.myFid then 0.5 else 0.8)
	elseif msg.kind == "melee" then
		if msg.attacker ~= Store.myFid then
			Audio.play("heavy", 0.8)
		end
	elseif msg.kind == "bullet" or msg.kind == "deflected" or msg.kind == "thrown" then
		Audio.play("punch", 0.6, 1.3)
	elseif msg.kind == "saw" then
		Audio.play("saw")
		Effects.spark(pos, Color3.fromRGB(255, 200, 80), 20, 60)
	elseif msg.kind == "spikes" then
		Audio.play("spikes")
	end
	local me = msg.fid == Store.myFid or msg.attacker == Store.myFid
	CameraRig.shake(math.clamp(msg.damage / 70, 0.05, 0.6) * (if me then 1.4 else 0.6))
	if msg.fid == Store.myFid then
		Hud.hurt(msg.damage)
		if big then
			CameraRig.punchZoom(0.05)
		end
	end
end

handlers.Knock = function(msg)
	Controller.onKnock(msg)
end

handlers.GetUp = function(_msg)
	Controller.onGetUp()
end

handlers.Died = function(msg)
	local r = rootOf(msg.fid)
	local col = colorOf(msg.fid)
	if r then
		local pos = r.Position
		Effects.paint(pos, Vector3.new(0, 20, 0), col, 22)
		Effects.spark(pos, col, 20, 60, 0.5)
		Effects.ring(pos, col, 6, 0.4)
		Effects.flash(pos, Color3.new(1, 1, 1), 4)
		Effects.text(pos + Vector3.new(0, 3, 0), "KO!", col, 52, 1.1)
		CosmeticFx.finisher(msg.finisher, pos, col)
	end
	Audio.play("ko", if msg.zone == "lobby" then 0.6 else 1)
	CameraRig.shake(if msg.zone == "lobby" then 0.25 else 0.55)
	if msg.zone ~= "arena" then
		return
	end
	local killer = if msg.killer and msg.killer ~= 0 and msg.killer ~= msg.fid then msg.killer else nil
	Hud.feed(if killer then nameOf(killer) else nil, if killer then colorOf(killer) else nil, nameOf(msg.fid), col, msg.cause or "ko")
	if msg.fid == Store.myFid then
		local fin = if msg.finisher then Cosmetics.byId[msg.finisher] else nil
		Hud.ko(if killer then nameOf(killer) else nil, if killer then colorOf(killer) else nil, if fin and fin.id ~= "pop" then fin.name else nil)
		Hud.spectate("SPECTATING")
	elseif killer == Store.myFid then
		Hud.banner("KO!", "you took out " .. nameOf(msg.fid), UI.C.gold, 1.2)
	end
end

handlers.SpawnFx = function(msg)
	CosmeticFx.entrance(msg.id, Vector3.new(msg.x, msg.y, 0), colorOf(msg.fid))
end

handlers.Boom = function(msg)
	local pos = Vector3.new(msg.x, msg.y, 0)
	Effects.explosion(pos, msg.r or 9)
	Effects.stars(pos, Color3.fromRGB(255, 190, 80), 6)
	Audio.play("boom")
	CameraRig.shake(0.75)
	CameraRig.punchZoom(0.05)
end

handlers.Equip = function(msg)
	if msg.fid == Store.myFid then
		Audio.play("pickup")
	end
end

handlers.Picked = function(msg)
	local r = rootOf(msg.fid)
	local w = Weapons.get(msg.wid)
	if r and w then
		Effects.text(r.Position + Vector3.new(0, 4.5, 0), string.upper(w.name), colorOf(msg.fid), 22, 0.9)
		Effects.ring(r.Position, colorOf(msg.fid), 3)
	end
end

handlers.Drop = function(msg)
	Effects.beam(msg.x, msg.y, Color3.fromRGB(255, 240, 160))
	Audio.play("drop")
end

handlers.Deflect = function(msg)
	Effects.spark(Vector3.new(msg.x, msg.y, 0), Color3.new(1, 1, 1), 10, 40)
	Audio.play("deflect")
end

handlers.Parry = function(_msg) end

handlers.Hazard = function(msg)
	Effects.spark(Vector3.new(msg.x, msg.y, 0), Color3.fromRGB(255, 210, 90), 14, 50)
end

handlers.RoundEnd = function(msg)
	setScores(msg.scores)
	Hud.suddenDeath(false)
	if viewZone ~= "arena" then
		return
	end
	if msg.winner and msg.winner ~= 0 then
		local col = colorOf(msg.winner)
		Hud.banner(if msg.winner == Store.myFid then "YOU WIN!" else string.upper(nameOf(msg.winner)) .. " WINS!", "round point!", col, 3)
		local r = rootOf(msg.winner)
		if r then
			Effects.confetti(r.Position + Vector3.new(0, 18, 0), 40)
		end
	else
		Hud.banner("DRAW!", "nobody survived", Color3.fromRGB(200, 200, 210), 3)
	end
	Audio.play("win")
end

handlers.Results = function(msg)
	Hud.results(msg.placements or {}, matchCoins)
	local first = (msg.placements or {})[1]
	if first and first.fid == Store.myFid then
		Audio.play("win", 1, 0.8)
		task.delay(0.3, function()
			Audio.play("win", 1, 1.2)
		end)
	end
end

handlers.Lobby = function(msg)
	setScores(msg.scores)
	Hud.hideResults()
	Hud.spectate("")
	Hud.setRoster({})
	UI.toast("Back in the Arcade · roll some crates!", UI.C.pink, 4)
end

handlers.SuddenDeath = function(_msg)
	if viewZone == "arena" then
		Hud.banner("SUDDEN DEATH", "the ink is rising!", Color3.fromRGB(255, 70, 120), 2.5)
		Hud.suddenDeath(true)
		Audio.play("fight", 1, 0.7)
	end
end

handlers.Announce = function(msg)
	local item = Cosmetics.byId[msg.item]
	if not item then
		return
	end
	local r = Cosmetics.rarity(item)
	local hex = string.format("#%02x%02x%02x", math.floor(r.color.R * 255), math.floor(r.color.G * 255), math.floor(r.color.B * 255))
	local t = UI.toast(string.format("%s rolled <font color='%s'>%s %s</font> (%s)!", msg.name, hex, item.icon, item.name, Cosmetics.formatChance(item.chance)), r.color, 6, true)
	if t and item.rarity >= 6 then
		UI.shimmer(t, { r.color, Color3.new(1, 1, 1), r.color }, 1)
	end
	Audio.play("win", 0.7, 1.4)
end

handlers.Left = function(_msg) end

Event.OnClientEvent:Connect(function(msg: any)
	if type(msg) ~= "table" then
		return
	end
	local h = handlers[msg.t]
	if h then
		local ok, err = pcall(h, msg)
		if not ok then
			warn("[Ragdoll Rumble] handler", msg.t, err)
		end
	end
end)

State.OnClientEvent:Connect(function(b: any)
	if typeof(b) ~= "buffer" then
		return
	end
	local n = buffer.readu8(b, 0)
	for i = 1, n do
		local o = 1 + (i - 1) * 3
		local fid = buffer.readu8(b, o)
		if fid ~= Store.myFid then
			Animator.setState(fid, (buffer.readu8(b, o + 1) / 255) * 2 * math.pi - math.pi, buffer.readu8(b, o + 2))
		end
	end
end)

-------------------------------------------------------------------------------
-- loops

local stateAcc = 0

RunService.PreSimulation:Connect(function(dt)
	Animator.step(dt)
	Controller.physicsStep(dt)
end)

local function hpOf(fid: number): (number?, boolean?)
	local m = modelOf(fid)
	if not m then
		return 0, false
	end
	local h = m:FindFirstChildOfClass("Humanoid")
	if not h then
		return 0, false
	end
	return h.Health, h.Health > 0
end

RunService:BindToRenderStep("RagdollRumble", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local t = now()
	local phase = workspace:GetAttribute("Phase") or "lobby"
	local c = player.Character
	local myZone = if c then c:GetAttribute("Zone") else nil
	local hum = if c then c:FindFirstChildOfClass("Humanoid") else nil
	local alive = hum ~= nil and hum.Health > 0
	local inMatch = false
	for _, s in Store.scores do
		if s.fid == Store.myFid and s.inMatch then
			inMatch = true
		end
	end
	-- which zone are we looking at?
	local zone = if type(myZone) == "string" then myZone else "lobby"
	if phase ~= "lobby" and inMatch then
		zone = "arena"
	end
	if zone ~= viewZone then
		viewZone = zone
		lightingFor = ""
		paintGeometry()
		local map = mapForZone(zone)
		if map then
			CameraRig.reset(map.bounds)
		end
	end
	local map = mapForZone(viewZone)
	local key = viewZone .. tostring(workspace:GetAttribute("MapIndex"))
	if map and key ~= lightingFor then
		lightingFor = key
		applyLighting(map)
	end
	CameraRig.shakeEnabled = Store.settings.shake
	Audio.volume = Store.settings.sfx

	-- countdown (arena only)
	local frozen = false
	if viewZone == "arena" and phase == "match" and fightTime > 0 then
		local remain = fightTime - t
		frozen = remain > 0
		if remain > 0 and remain <= Config.COUNTDOWN then
			local n = math.ceil(remain)
			if n ~= lastCount then
				lastCount = n
				Hud.count(tostring(n))
				Audio.play("tick", 1, 1 + (3 - n) * 0.1)
			end
		elseif remain <= 0 and lastCount > 0 then
			handlers.Fight({})
		end
	end
	if myZone == "arena" and phase == "results" then
		frozen = true
	end

	-- my fighter
	local mouseWorld = CameraRig.toWorld(UserInputService:GetMouseLocation())
	local auto = if Input.mode ~= "mouse" then Controller.nearestEnemy() else nil
	Controller.update(dt, mouseWorld, auto, frozen)
	stateAcc += dt
	if stateAcc >= 1 / Config.STATE_RATE then
		stateAcc = 0
		local aimByte = math.floor(((Controller.aim + math.pi) / (2 * math.pi)) * 255 + 0.5) % 256
		State:FireServer(aimByte, (if Controller.blocking then 1 else 0) + (if Controller.crouch then 2 else 0))
	end

	-- camera
	local targets = {}
	local folder = fighters()
	local myRoot = if c then c:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	if folder then
		for _, m in folder:GetChildren() do
			if m:GetAttribute("Zone") ~= viewZone then
				continue
			end
			local h = m:FindFirstChildOfClass("Humanoid")
			local r = m:FindFirstChild("HumanoidRootPart")
			if not h or not r or not r:IsA("BasePart") then
				continue
			end
			if viewZone == "lobby" then
				-- lobby: follow yourself + whoever is right next to you
				if m == c or (myRoot and (r.Position - myRoot.Position).Magnitude < 22) then
					table.insert(targets, Vector2.new(r.Position.X, r.Position.Y))
				end
			elseif h.Health > 0 or m == c then
				if not map or r.Position.Y > map.killY - 5 then
					table.insert(targets, Vector2.new(r.Position.X, r.Position.Y))
				end
			end
		end
	end
	CameraRig.update(dt, targets, if viewZone == "lobby" then 0.75 else 1)

	-- spinning saws follow the shared motion clock
	local mt = t - roundStart
	for _, s in saws do
		if s.part.Parent then
			local x, y = Motion.pose(s.def.motion, s.def.x, s.def.y, 0, mt)
			s.part.CFrame = CFrame.new(x, y, 0) * CFrame.Angles(0, 0, -mt * 9) * CFrame.Angles(0, math.pi / 2, 0)
		end
	end

	Effects.update(dt)
	Tags.update(dt)
	Menu.update(dt, viewZone == "lobby")
	local wid = if c then (c:GetAttribute("Wid") :: number?) or 0 else 0
	local ammo = if c then (c:GetAttribute("Ammo") :: number?) or 0 else 0
	Hud.update(dt, viewZone == "arena" and phase ~= "lobby", hpOf, {
		inArena = myZone == "arena" and alive,
		alive = alive,
		hp = if hum then hum.Health else 0,
		wid = wid,
		ammo = ammo,
		color = if c then Tags.color(c) else Color3.new(1, 1, 1),
		crosshair = Input.mode == "mouse" and alive and not CrateUI.busy(),
	})
	if viewZone == "lobby" and phase == "match" and not inMatch then
		Hud.spectate("a match is running · you'll join the next one")
	elseif viewZone == "lobby" then
		Hud.spectate("")
	end
end)

Event:FireServer({ t = "Ready" })
print("[Ragdoll Rumble] client ready")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">AdminUI</string>
            <string name="Source"><![CDATA[--!strict
-- Admin panel (the server re-checks permissions for every action).

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Maps = require(Shared:WaitForChild("Maps"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local UI = require(script.Parent:WaitForChild("UIKit"))
local Store = require(script.Parent:WaitForChild("Store"))
local Skins = require(script.Parent:WaitForChild("Skins"))

local AdminUI = {}

local win: UI.Window? = nil
local pages: { [string]: ScrollingFrame } = {}
local playerList: Frame? = nil
local logBox: TextLabel? = nil
local status: TextLabel? = nil

local function act(action: string, args: any?): any
	local ok, res = pcall(function()
		return Remotes.Request:InvokeServer("admin", { action = action, args = args })
	end)
	if not ok or type(res) ~= "table" then
		UI.toast("admin request failed", UI.C.red)
		return nil
	end
	if res.msg then
		UI.toast(res.msg, if res.ok then UI.C.green else UI.C.red)
	end
	return res
end

local function btn(parent: Instance, text: string, color: Color3?, fn: () -> (), width: number?)
	return UI.button(parent, { text = text, size = UDim2.fromOffset(width or 150, 38), color = color or UI.C.bg2, textSize = 16, font = UI.HEAVY, z = 23, onClick = fn })
end

local function refreshPlayers()
	local pl = playerList
	if not pl then
		return
	end
	for _, c in pl:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local res = act("state")
	if not res or not res.data then
		return
	end
	if status then
		local d = res.data
		status.Text = string.format("phase: %s  ·  bots: %s (fill to %d, x%.1f%s)  ·  saving: %s  ·  3D models: %s",
			tostring(d.phase), if d.botsEnabled then "on" else "off", d.target, d.difficulty, if d.passive then ", passive" else "",
			if d.saving then "on" else "off", if Skins.ok then "mesh" elseif Skins.ok == false then "fallback (" .. tostring(Skins.err) .. ")" else "loading")
	end
	for i, p in res.data.players do
		local row = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 44), BackgroundColor3 = UI.C.bg2, BackgroundTransparency = 0.3, LayoutOrder = 10 + i, ZIndex = 22 }, pl)
		UI.corner(row, 10)
		UI.pad(row, 3, 8)
		UI.list(row, true, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		UI.text({ Size = UDim2.fromOffset(170, 38), Text = p.name .. "  (" .. p.zone .. ")", TextXAlignment = Enum.TextXAlignment.Left, TextSize = 16, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 23 }, row)
		local uid = p.userId
		btn(row, "Heal", UI.C.green, function()
			act("player.heal", { userId = uid })
		end, 70)
		btn(row, "KO", UI.C.red, function()
			act("player.kill", { userId = uid })
		end, 60)
		btn(row, if p.god then "God: ON" else "God: off", if p.god then UI.C.gold else UI.C.bg2, function()
			act("player.god", { userId = uid, on = not p.god })
			refreshPlayers()
		end, 100)
		btn(row, "Flop", UI.C.cyan, function()
			act("player.ragdoll", { userId = uid })
		end, 70)
		btn(row, "+1000 ★", UI.C.gold, function()
			act("player.coins", { userId = uid, amount = 1000 })
		end, 100)
	end
end

local function refreshLogs()
	local res = act("logs")
	local lb = logBox
	if not res or not lb then
		return
	end
	local lines = {}
	for i = #res.data, math.max(1, #res.data - 25), -1 do
		local l = res.data[i]
		table.insert(lines, string.format("<font color='%s'>[%s]</font> %s", if l.kind == "error" then "#ff5a6e" else "#ffd36e", l.kind, (l.msg:gsub("<", "&lt;"))))
	end
	lb.Text = if #lines > 0 then table.concat(lines, "\n") else "no server errors or warnings 🎉"
end

function AdminUI.init(parent: Instance)
	local w = UI.window(parent, "ADMIN PANEL", UDim2.fromOffset(760, 560), Color3.fromRGB(255, 143, 60))
	win = w
	pages = UI.tabs(w.body, { "Match", "Bots", "Players", "Weapons", "Crates", "Debug" }, Color3.fromRGB(255, 143, 60))

	-- match
	local m = pages.Match
	local s1 = UI.section(m, "Flow", 1)
	local r1 = UI.row(s1, 1)
	btn(r1, "Start match now", UI.C.green, function()
		act("match.start")
	end, 170)
	btn(r1, "Skip round", UI.C.cyan, function()
		act("round.skip")
	end)
	btn(r1, "End match", UI.C.red, function()
		act("match.end")
	end)
	btn(r1, "Sudden death", Color3.fromRGB(255, 70, 120), function()
		act("suddendeath")
	end)
	local r2 = UI.row(s1, 2)
	btn(r2, "Lobby timer 5s", UI.C.bg2, function()
		act("intermission", { seconds = 5 })
	end, 160)
	btn(r2, "Lobby timer 60s", UI.C.bg2, function()
		act("intermission", { seconds = 60 })
	end, 160)
	local s2 = UI.section(m, "Next map", 2)
	local grid = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 96), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 22 }, s2)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(170, 40), CellPadding = UDim2.fromOffset(6, 6) }, grid)
	for i, map in Maps.list do
		btn(grid, map.name, UI.C.bg2, function()
			act("round.map", { map = i })
		end)
	end

	-- bots
	local b = pages.Bots
	local sb = UI.section(b, "Bots in matches", 1)
	UI.toggle(sb, "Bots enabled", true, function(v)
		act("bots.enabled", { on = v })
	end, 1)
	UI.toggle(sb, "Passive bots (they won't attack)", false, function(v)
		act("bots.passive", { on = v })
	end, 2)
	UI.slider(sb, "Fill matches up to", 1, 8, 4, function(v)
		act("bots.target", { count = math.floor(v + 0.5) })
	end, function(v)
		return tostring(math.floor(v + 0.5)) .. " fighters"
	end, 3)
	UI.slider(sb, "Difficulty", 0.2, 1.6, 1, function(v)
		act("bots.difficulty", { value = v })
	end, function(v)
		return string.format("x%.1f", v)
	end, 4)
	local sb2 = UI.section(b, "Testing", 2)
	local rb = UI.row(sb2, 1)
	btn(rb, "Spawn sparring bot near me", UI.C.pink, function()
		act("bots.spawn")
	end, 260)

	-- players
	local p = pages.Players
	local sp = UI.section(p, "Players", 1)
	status = UI.text({ Size = UDim2.new(1, 0, 0, 40), TextWrapped = true, TextSize = 14, TextColor3 = UI.C.dim, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, ZIndex = 23 }, sp)
	btn(sp, "Refresh", UI.C.cyan, refreshPlayers, 120).LayoutOrder = 2
	playerList = sp

	-- weapons
	local wp = pages.Weapons
	local sw = UI.section(wp, "Give yourself a weapon", 1)
	local wg = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 100), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 22 }, sw)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(165, 40), CellPadding = UDim2.fromOffset(6, 6) }, wg)
	for _, wpn in Weapons.list do
		btn(wg, wpn.name, UI.C.bg2, function()
			act("player.weapon", { wid = wpn.id, userId = Players.LocalPlayer.UserId })
		end)
	end
	local sw2 = UI.section(wp, "Drop one from the sky", 2)
	local wg2 = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 100), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 22 }, sw2)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(165, 40), CellPadding = UDim2.fromOffset(6, 6) }, wg2)
	for _, wpn in Weapons.list do
		btn(wg2, wpn.name, UI.C.bg2, function()
			act("weapon.drop", { wid = wpn.id })
		end)
	end

	-- crates
	local c = pages.Crates
	local sc = UI.section(c, "Force your next roll (watch the animations)", 1)
	local cg = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 96), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 22 }, sc)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(165, 40), CellPadding = UDim2.fromOffset(6, 6) }, cg)
	for _, r in Cosmetics.RARITIES do
		btn(cg, r.name, r.color, function()
			act("crate.force", { rarity = r.id })
		end)
	end
	local sc2 = UI.section(c, "Economy", 2)
	UI.toggle(sc2, "Free rolls", false, function(v)
		act("crate.free", { on = v })
	end, 1)
	UI.slider(sc2, "Luck", 1, 1000, 1, function(v)
		act("crate.luck", { value = math.floor(v) })
	end, function(v)
		return string.format("x%d", math.floor(v))
	end, 2)
	local rc = UI.row(sc2, 3)
	btn(rc, "+10,000 coins", UI.C.gold, function()
		act("player.coins", { amount = 10000 })
	end, 170)
	btn(rc, "Reset my data", UI.C.red, function()
		act("data.reset")
	end, 170)

	-- debug
	local d = pages.Debug
	local sd = UI.section(d, "Server errors + warnings", 1)
	btn(sd, "Refresh", UI.C.cyan, refreshLogs, 120).LayoutOrder = 1
	logBox = UI.text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, FontFace = Font.fromEnum(Enum.Font.Code), TextSize = 13, Text = "", LayoutOrder = 2, ZIndex = 23 }, sd)

	UserInputService.InputBegan:Connect(function(io, gpe)
		if not gpe and (io.KeyCode == Enum.KeyCode.F2 or io.KeyCode == Enum.KeyCode.Backquote) and Store.isAdmin then
			AdminUI.toggle()
		end
	end)
end

function AdminUI.toggle()
	local w = win
	if not w then
		return
	end
	if w.frame.Visible then
		w.close()
	else
		UI.open(w)
		refreshPlayers()
		refreshLogs()
	end
end

return AdminUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural R15 animation for every fighter (your avatar, other players, bots).
-- Each client animates everyone from replicated state (velocity, aim, actions), so no
-- animation assets are needed. Everything is a pitch rotation in the side-view plane.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Weapons = require(Shared:WaitForChild("Weapons"))

local Animator = {}

local JOINTS = {
	"Root", "Waist", "Neck",
	"RightShoulder", "RightElbow", "RightWrist",
	"LeftShoulder", "LeftElbow", "LeftWrist",
	"RightHip", "RightKnee", "RightAnkle",
	"LeftHip", "LeftKnee", "LeftAnkle",
}

type Action = { kind: string, t: number, dur: number, hand: string, dir: number }

type Anim = {
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	motors: { [string]: Motor6D },
	cur: { [string]: Vector3 },
	vel: { [string]: Vector3 },
	rootY: number,
	rootRoll: number,
	rootPitch: number,
	phase: number,
	aim: number,
	aimTarget: number,
	blocking: boolean,
	crouch: boolean,
	actions: { Action },
	recoil: number,
	flinch: number,
	flinchDir: number,
	airT: number,
	landT: number,
	wasRagdoll: boolean,
	seed: number,
}

local anims: { [Model]: Anim } = {}
local byFid: { [number]: Anim } = {}
local clock = 0

local PI = math.pi
local sin, cos, abs, clamp, exp = math.sin, math.cos, math.abs, math.clamp, math.exp

local function wrap(a: number): number
	return (a + PI) % (2 * PI) - PI
end

function Animator.track(model: Model)
	if anims[model] then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return
	end
	local motors = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	if not motors.Waist or not motors.RightShoulder then
		return -- not an R15 rig
	end
	local cur, vel = {}, {}
	for _, n in JOINTS do
		cur[n] = Vector3.zero
		vel[n] = Vector3.zero
	end
	local a: Anim = {
		model = model,
		humanoid = humanoid,
		root = root,
		motors = motors,
		cur = cur,
		vel = vel,
		rootY = 0,
		rootRoll = 0,
		rootPitch = 0,
		phase = 0,
		aim = if root.CFrame.LookVector.X >= 0 then 0 else PI,
		aimTarget = if root.CFrame.LookVector.X >= 0 then 0 else PI,
		blocking = false,
		crouch = false,
		actions = {},
		recoil = 0,
		flinch = 0,
		flinchDir = 1,
		airT = 0,
		landT = 0,
		wasRagdoll = false,
		seed = math.random() * 10,
	}
	anims[model] = a
	local fid = model:GetAttribute("Fid")
	if type(fid) == "number" then
		byFid[fid] = a
	end
end

function Animator.untrack(model: Model)
	local a = anims[model]
	if a then
		anims[model] = nil
		for fid, b in byFid do
			if b == a then
				byFid[fid] = nil
			end
		end
	end
end

local function get(fid: number): Anim?
	local a = byFid[fid]
	if a and a.model.Parent then
		return a
	end
	for m, b in anims do
		if m:GetAttribute("Fid") == fid then
			byFid[fid] = b
			return b
		end
	end
	return nil
end

function Animator.setState(fid: number, aim: number, flags: number, snap: boolean?)
	local a = get(fid)
	if not a then
		return
	end
	a.aimTarget = aim
	if snap then
		a.aim = aim
	end
	a.blocking = bit32.band(flags, 1) ~= 0
	a.crouch = bit32.band(flags, 2) ~= 0
end

-- kind: punch | swing | fire | lob | throw | djump | flinch
function Animator.trigger(fid: number, kind: string, hand: string?, dir: number?)
	local a = get(fid)
	if not a then
		return
	end
	if kind == "fire" then
		a.recoil = 1
		return
	elseif kind == "flinch" then
		a.flinch = 1
		a.flinchDir = dir or 1
		return
	end
	local w = Weapons.get(a.model:GetAttribute("Wid") :: number?)
	local dur = 0.3
	if kind == "swing" then
		dur = (if w then w.swingTime else 0.25) + 0.18
	elseif kind == "lob" or kind == "throw" then
		dur = 0.42
	elseif kind == "djump" then
		dur = 0.4
	end
	-- a new punch replaces the previous one so combos stay snappy
	for i = #a.actions, 1, -1 do
		if a.actions[i].kind == kind then
			table.remove(a.actions, i)
		end
	end
	table.insert(a.actions, { kind = kind, t = 0, dur = dur, hand = hand or "R", dir = dir or 1 })
end

local function easeOut(x: number): number
	x = clamp(x, 0, 1)
	return 1 - (1 - x) * (1 - x) * (1 - x)
end

local function easeInOut(x: number): number
	x = clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function set(t: { [string]: Vector3 }, name: string, p: number, y: number?, r: number?)
	t[name] = Vector3.new(p, y or 0, r or 0)
end

local function animate(a: Anim, dt: number)
	local root = a.root
	local hum = a.humanoid
	local vel = root.AssemblyLinearVelocity
	local facing = if root.CFrame.LookVector.X >= 0 then 1 else -1
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	local vx, vy = vel.X, vel.Y
	local speed = abs(vx)
	local t = clock + a.seed
	local w = Weapons.get(a.model:GetAttribute("Wid") :: number?)

	-- aim smoothing
	a.aim = a.aim + wrap(a.aimTarget - a.aim) * (1 - exp(-dt * 22))
	local th = a.aim
	-- arm pitch that points the arm along the aim (0 = down, pi/2 = forward, pi = up)
	local aimPitch = math.atan2(cos(th) * facing, -sin(th))

	if grounded then
		if a.airT > 0.25 then
			a.landT = 0.2
		end
		a.airT = 0
	else
		a.airT += dt
	end
	a.landT = math.max(0, a.landT - dt)
	a.recoil = math.max(0, a.recoil - dt * 7)
	a.flinch = math.max(0, a.flinch - dt * 4)

	local T: { [string]: Vector3 } = {}
	local rootY, rootPitch = 0, 0
	local waistP, waistY = 0, 0
	if not grounded or a.crouch then
		a.rootRoll = 0
	end

	-- legs / base -----------------------------------------------------------------
	if not grounded then
		local rising = vy > 4
		set(T, "RightHip", if rising then 1.0 else 0.4)
		set(T, "LeftHip", if rising then 0.25 else -0.25)
		set(T, "RightKnee", if rising then -1.6 else -0.6)
		set(T, "LeftKnee", if rising then -0.9 else -0.35)
		set(T, "RightAnkle", 0.3)
		set(T, "LeftAnkle", 0.2)
		waistP = if rising then -0.12 else 0.06
	elseif a.crouch then
		set(T, "RightHip", 1.15)
		set(T, "LeftHip", 0.75)
		set(T, "RightKnee", -1.8)
		set(T, "LeftKnee", -1.6)
		set(T, "RightAnkle", 0.6)
		set(T, "LeftAnkle", 0.8)
		rootY = -1.05
		waistP = -0.35
	elseif speed > 1.5 then
		local forward = if vx * facing >= 0 then 1 else -1
		a.phase += dt * speed * 0.48 * forward
		local s, c = sin(a.phase), cos(a.phase)
		local amp = clamp(speed / 21, 0.35, 1)
		set(T, "RightHip", s * 0.9 * amp)
		set(T, "LeftHip", -s * 0.9 * amp)
		set(T, "RightKnee", -0.2 - math.max(0, c) * 1.35 * amp)
		set(T, "LeftKnee", -0.2 - math.max(0, -c) * 1.35 * amp)
		set(T, "RightAnkle", 0.25 * s * amp)
		set(T, "LeftAnkle", -0.25 * s * amp)
		rootY = abs(s) * 0.2 * amp - 0.06
		waistP = -0.16 * amp * forward
		waistY = -s * 0.22 * amp -- shoulders counter-twist against the hips
		a.rootRoll = s * 0.06 * amp
	else
		a.rootRoll = sin(t * 1.1) * 0.025 -- idle weight shift
		local b = sin(t * 2.3)
		set(T, "RightHip", 0.16)
		set(T, "LeftHip", -0.12)
		set(T, "RightKnee", -0.22)
		set(T, "LeftKnee", -0.3)
		set(T, "RightAnkle", 0.06)
		set(T, "LeftAnkle", 0.18)
		rootY = -0.1 + b * 0.035
		waistP = -0.06 + b * 0.02
	end
	if a.landT > 0 then
		local k = a.landT / 0.2
		for _, n in { "RightHip", "LeftHip" } do
			T[n] += Vector3.new(0.6 * k, 0, 0)
		end
		for _, n in { "RightKnee", "LeftKnee" } do
			T[n] += Vector3.new(-1.0 * k, 0, 0)
		end
		rootY -= 0.55 * k
	end

	-- upper body ----------------------------------------------------------------------
	local bob = sin(t * 4.2) * 0.04
	local guardR = Vector3.new(0.95 + bob, 0, -0.15)
	local guardL = Vector3.new(0.75 + bob, 0, 0.15)
	local elbowGuardR, elbowGuardL = 1.75, 1.9
	local armR, armL = guardR, guardL
	local elbR, elbL = elbowGuardR, elbowGuardL
	local wristR = 0
	local ap = aimPitch - waistP -- compensate for the torso lean

	if a.blocking then
		armR = Vector3.new(1.55, 0, -0.35)
		armL = Vector3.new(1.5, 0, 0.35)
		elbR, elbL = 2.1, 2.1
		waistP -= 0.08
	elseif w and (w.kind == "gun" or w.kind == "launcher") then
		armR = Vector3.new(ap, 0, 0)
		elbR = 0.05
		if w.twoHanded then
			armL = Vector3.new(ap - 0.08, 0, 0.55)
			elbL = 0.75
		else
			armL = Vector3.new(0.45, 0, 0.1)
			elbL = 1.0
		end
	elseif w and w.kind == "melee" then
		armR = Vector3.new(ap + 0.9, 0, -0.1)
		elbR = 1.0
		wristR = 0.3
	elseif w and w.kind == "throwable" then
		armR = Vector3.new(2.5, 0, -0.1)
		elbR = 1.5
	end

	if not grounded and a.airT > 0.35 and vy < -35 and not w and not a.blocking then
		-- flail when falling fast
		local fl = sin(t * 15) * 0.45
		armR = Vector3.new(2.2 + fl, 0, 0.6)
		armL = Vector3.new(2.2 - fl, 0, -0.6)
		elbR, elbL = 0.6, 0.6
	end

	-- actions ------------------------------------------------------------------------
	for i = #a.actions, 1, -1 do
		local act = a.actions[i]
		act.t += dt
		local p = act.t / act.dur
		if p >= 1 then
			table.remove(a.actions, i)
			continue
		end
		if act.kind == "punch" then
			local ext
			if p < 0.25 then
				ext = easeOut(p / 0.25)
			elseif p < 0.4 then
				ext = 1
			else
				ext = 1 - easeInOut((p - 0.4) / 0.6)
			end
			local target = Vector3.new(ap, 0, 0)
			if act.hand == "R" then
				armR = armR:Lerp(target, ext)
				elbR = elbR + (0.05 - elbR) * ext
				waistY += 0.5 * ext
				armL = armL + Vector3.new(-0.2 * ext, 0, 0)
			else
				armL = armL:Lerp(target, ext)
				elbL = elbL + (0.05 - elbL) * ext
				waistY -= 0.5 * ext
				armR = armR + Vector3.new(-0.2 * ext, 0, 0)
			end
			waistP -= 0.14 * ext
		elseif act.kind == "swing" then
			local st = if w then w.swingTime else 0.25
			local q = act.t / st
			if q <= 1 then
				local e = easeOut(q)
				local a0, a1 = ap + 2.3, ap - 0.9
				armR = Vector3.new(a0 + (a1 - a0) * e, 0, -0.1)
				elbR = 0.15
				wristR = 0.1
				waistY += -0.45 + 0.95 * e
				waistP -= 0.15 * e
			else
				local r = easeInOut((act.t - st) / (act.dur - st))
				armR = Vector3.new(ap - 0.9, 0, -0.1):Lerp(armR, r)
				elbR = 0.15 + (elbR - 0.15) * r
				waistY += 0.5 * (1 - r)
			end
		elseif act.kind == "lob" or act.kind == "throw" then
			if p < 0.3 then
				local e = easeOut(p / 0.3)
				armR = armR:Lerp(Vector3.new(2.9, 0, -0.1), e)
				elbR = elbR + (1.4 - elbR) * e
				waistY -= 0.4 * e
			elseif p < 0.6 then
				local e = easeOut((p - 0.3) / 0.3)
				armR = Vector3.new(2.9 + (ap - 0.25 - 2.9) * e, 0, -0.1)
				elbR = 1.4 + (0.1 - 1.4) * e
				waistY += -0.4 + 0.9 * e
			else
				local r = easeInOut((p - 0.6) / 0.4)
				armR = Vector3.new(ap - 0.25, 0, -0.1):Lerp(armR, r)
				elbR = 0.1 + (elbR - 0.1) * r
				waistY += 0.5 * (1 - r)
			end
		elseif act.kind == "djump" then
			rootPitch = -2 * PI * easeInOut(p)
			for _, n in { "RightHip", "LeftHip" } do
				T[n] = Vector3.new(1.7, 0, 0)
			end
			for _, n in { "RightKnee", "LeftKnee" } do
				T[n] = Vector3.new(-2.2, 0, 0)
			end
			armR = Vector3.new(1.2, 0, -0.3)
			armL = Vector3.new(1.2, 0, 0.3)
			elbR, elbL = 1.6, 1.6
		end
	end

	-- recoil + flinch
	if a.recoil > 0 then
		local k = a.recoil * a.recoil
		armR += Vector3.new(0.4 * k, 0, 0)
		elbR += 0.35 * k
		waistP += 0.14 * k
		if w and w.twoHanded then
			armL += Vector3.new(0.4 * k, 0, 0)
		end
	end
	local neckP = clamp((aimPitch - PI / 2) * 0.55, -0.55, 0.6)
	if a.flinch > 0 then
		local k = a.flinch * a.flinch
		waistP += 0.5 * k * a.flinchDir
		neckP += 0.45 * k * a.flinchDir
		armR += Vector3.new(0.3 * k, 0, 0.5 * k)
		armL += Vector3.new(0.3 * k, 0, -0.5 * k)
	end

	-- victory dance
	if a.model:GetAttribute("Victory") == true then
		local wave = sin(t * 9)
		armR = Vector3.new(2.95 + wave * 0.15, 0, 0.35)
		armL = Vector3.new(2.95 - wave * 0.15, 0, -0.35)
		elbR, elbL = 0.3 + wave * 0.3, 0.3 - wave * 0.3
		waistP = 0.12
		waistY = sin(t * 4.5) * 0.35
		neckP = 0.3
		if grounded then
			rootY += abs(sin(t * 6)) * 0.4
		end
	end

	set(T, "RightShoulder", armR.X, armR.Y, armR.Z)
	set(T, "LeftShoulder", armL.X, armL.Y, armL.Z)
	set(T, "RightElbow", elbR)
	set(T, "LeftElbow", elbL)
	set(T, "RightWrist", wristR)
	set(T, "LeftWrist", 0)
	set(T, "Waist", waistP, waistY, 0)
	set(T, "Neck", neckP - waistP * 0.5, -waistY * 0.4, 0)

	-- springs: limbs overshoot a touch and settle (secondary motion)
	local fast = #a.actions > 0 or a.recoil > 0.2
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for _, n in JOINTS do
		local target = T[n]
		if n == "Root" or not target then
			continue
		end
		local snappy = fast and (string.find(n, "Shoulder") ~= nil or string.find(n, "Elbow") ~= nil or n == "Waist")
		local K = if snappy then 1500 elseif string.find(n, "Hip") or string.find(n, "Knee") then 520 else 360
		local D = if snappy then 58 elseif string.find(n, "Hip") or string.find(n, "Knee") then 36 else 28
		local c, v = a.cur[n], a.vel[n]
		for _ = 1, steps do
			v += ((target - c) * K - v * D) * h
			c += v * h
		end
		a.cur[n], a.vel[n] = c, v
		local m = a.motors[n]
		if m then
			m.Transform = CFrame.Angles(c.X, c.Y, c.Z)
		end
	end
	local kFast = 1 - exp(-dt * 40)
	local kSlow = 1 - exp(-dt * 16)
	a.rootY += (rootY - a.rootY) * kSlow
	if rootPitch ~= 0 then
		a.rootPitch = rootPitch
	else
		a.rootPitch += (0 - a.rootPitch) * kFast
	end
	local rm = a.motors.Root
	if rm then
		rm.Transform = CFrame.new(0, a.rootY, 0) * CFrame.Angles(a.rootPitch, 0, a.rootRoll)
	end
end

function Animator.step(dt: number)
	clock += dt
	for model, a in anims do
		if not model.Parent then
			anims[model] = nil
			continue
		end
		local floppy = model:GetAttribute("Ragdoll") == true or a.humanoid.Health <= 0
		if floppy then
			if not a.wasRagdoll then
				a.wasRagdoll = true
				local rm = a.motors.Root
				if rm then
					rm.Transform = CFrame.identity
				end
				table.clear(a.actions)
			end
			continue
		end
		a.wasRagdoll = false
		animate(a, dt)
	end
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- Custom sound design: every effect is a recipe of layered sources (sounds that ship with
-- the Roblox client, so they always load) run through effect chains (distortion, EQ,
-- reverb, echo). Swap any `id` for your own "rbxassetid://123" to re-skin a sound.

local SoundService = game:GetService("SoundService")

local Audio = {}

type Fx = { dist: number?, low: number?, mid: number?, high: number?, reverb: number?, echo: number? }
type Layer = { id: string, vol: number, pitch: number, var: number?, fx: Fx? }

local S = {
	collide = "rbxasset://sounds/collide.wav",
	lunge = "rbxasset://sounds/swordlunge.wav",
	slash = "rbxasset://sounds/swordslash.wav",
	unsheath = "rbxasset://sounds/unsheath.wav",
	paint = "rbxasset://sounds/paintball.wav",
	rocket = "rbxasset://sounds/Rocket shot.wav",
	whoosh = "rbxasset://sounds/Rocket whoosh 01.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/clickfast.wav",
	jump = "rbxasset://sounds/action_jump.mp3",
	land = "rbxasset://sounds/action_jump_land.mp3",
	glass = "rbxasset://sounds/glassbreak.wav",
}

local RECIPES: { [string]: { Layer } } = {
	whoosh = { { id = S.lunge, vol = 0.32, pitch = 1.8, var = 0.15, fx = { high = -6 } } },
	punch = {
		{ id = S.collide, vol = 1.0, pitch = 1.1, var = 0.18, fx = { dist = 0.35, low = 6 } },
		{ id = S.land, vol = 0.55, pitch = 1.6, var = 0.1 },
	},
	heavy = {
		{ id = S.collide, vol = 1.2, pitch = 0.55, var = 0.08, fx = { dist = 0.5, low = 8 } },
		{ id = S.rocket, vol = 0.25, pitch = 2.6, var = 0.1, fx = { high = 2 } },
	},
	block = {
		{ id = S.unsheath, vol = 0.5, pitch = 2.0, var = 0.08, fx = { echo = 0.15 } },
		{ id = S.collide, vol = 0.35, pitch = 1.8, var = 0.1 },
	},
	parry = {
		{ id = S.ping, vol = 0.6, pitch = 1.6, var = 0, fx = { reverb = 0.4 } },
		{ id = S.unsheath, vol = 0.6, pitch = 1.3, var = 0.05, fx = { reverb = 0.3 } },
	},
	slash = { { id = S.slash, vol = 0.65, pitch = 1.1, var = 0.12 }, { id = S.lunge, vol = 0.25, pitch = 1.4, var = 0.1 } },
	bonk = {
		{ id = S.collide, vol = 1.3, pitch = 0.75, var = 0.05, fx = { dist = 0.2, low = 5 } },
		{ id = S.land, vol = 0.6, pitch = 0.7, var = 0.05 },
	},
	pistol = {
		{ id = S.paint, vol = 0.8, pitch = 1.1, var = 0.08, fx = { dist = 0.3, low = 4 } },
		{ id = S.rocket, vol = 0.18, pitch = 3, var = 0.1 },
	},
	smg = { { id = S.paint, vol = 0.5, pitch = 1.5, var = 0.1, fx = { dist = 0.25 } } },
	shotgun = {
		{ id = S.rocket, vol = 0.8, pitch = 1.5, var = 0.06, fx = { dist = 0.45, low = 6 } },
		{ id = S.collide, vol = 0.4, pitch = 0.8, var = 0.05 },
	},
	sniper = {
		{ id = S.rocket, vol = 0.9, pitch = 2.2, var = 0.03, fx = { dist = 0.3, reverb = 0.35 } },
		{ id = S.ping, vol = 0.2, pitch = 0.5, var = 0, fx = { reverb = 0.5 } },
	},
	rocket = { { id = S.rocket, vol = 0.8, pitch = 0.9, var = 0.05, fx = { low = 4 } }, { id = S.whoosh, vol = 0.5, pitch = 1, var = 0.05 } },
	boom = {
		{ id = S.rocket, vol = 1.4, pitch = 0.45, var = 0.05, fx = { dist = 0.6, low = 10, reverb = 0.3 } },
		{ id = S.collide, vol = 1.0, pitch = 0.35, var = 0.05, fx = { dist = 0.4 } },
		{ id = S.glass, vol = 0.3, pitch = 0.5, var = 0.1 },
	},
	throw = { { id = S.lunge, vol = 0.45, pitch = 1.1, var = 0.1 } },
	lob = { { id = S.lunge, vol = 0.4, pitch = 0.9, var = 0.1 }, { id = S.click, vol = 0.3, pitch = 0.8, var = 0 } },
	pickup = { { id = S.ping, vol = 0.45, pitch = 1.5, var = 0.04 }, { id = S.click, vol = 0.3, pitch = 1.4, var = 0 } },
	deflect = { { id = S.unsheath, vol = 0.7, pitch = 1.6, var = 0.1, fx = { echo = 0.2 } } },
	jump = { { id = S.jump, vol = 0.3, pitch = 1.2, var = 0.1 } },
	djump = { { id = S.lunge, vol = 0.35, pitch = 2.4, var = 0.1 }, { id = S.ping, vol = 0.15, pitch = 2, var = 0.05 } },
	land = { { id = S.land, vol = 0.35, pitch = 1, var = 0.1 } },
	ko = {
		{ id = S.collide, vol = 1.4, pitch = 0.4, var = 0.05, fx = { dist = 0.5, low = 6 } },
		{ id = S.glass, vol = 0.35, pitch = 0.7, var = 0.1 },
		{ id = S.ping, vol = 0.4, pitch = 0.6, var = 0, fx = { reverb = 0.5 } },
	},
	tick = { { id = S.click, vol = 0.6, pitch = 1, var = 0 } },
	fight = { { id = S.ping, vol = 0.7, pitch = 0.8, var = 0, fx = { echo = 0.3 } }, { id = S.rocket, vol = 0.3, pitch = 0.7, var = 0 } },
	win = { { id = S.ping, vol = 0.7, pitch = 1.2, var = 0, fx = { echo = 0.3, reverb = 0.3 } } },
	saw = { { id = S.slash, vol = 0.6, pitch = 0.6, var = 0.1, fx = { dist = 0.3 } } },
	spikes = { { id = S.unsheath, vol = 0.6, pitch = 0.7, var = 0.1 } },
	drop = { { id = S.ping, vol = 0.3, pitch = 1, var = 0.05 } },
	click = { { id = S.click, vol = 0.4, pitch = 1.2, var = 0 } },
}

local POOL = 4
type Voice = { sounds: { Sound }, cursor: number, layer: Layer }
local voices: { [string]: { Voice } } = {}
Audio.muted = false
Audio.volume = 1

local function addFx(s: Sound, fx: Fx?)
	if not fx then
		return
	end
	if fx.low or fx.mid or fx.high then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = fx.low or 0
		eq.MidGain = fx.mid or 0
		eq.HighGain = fx.high or 0
		eq.Priority = 3
		eq.Parent = s
	end
	if fx.dist then
		local d = Instance.new("DistortionSoundEffect")
		d.Level = fx.dist
		d.Priority = 2
		d.Parent = s
	end
	if fx.echo then
		local e = Instance.new("EchoSoundEffect")
		e.Delay = 0.09
		e.Feedback = 0.25
		e.WetLevel = -12 + fx.echo * 10
		e.Priority = 1
		e.Parent = s
	end
	if fx.reverb then
		local r = Instance.new("ReverbSoundEffect")
		r.DecayTime = 1.2
		r.WetLevel = -14 + fx.reverb * 12
		r.Priority = 0
		r.Parent = s
	end
end

function Audio.init()
	local folder = Instance.new("Folder")
	folder.Name = "RumbleSounds"
	folder.Parent = SoundService
	for name, layers in RECIPES do
		local list = {}
		for li, layer in layers do
			local v: Voice = { sounds = {}, cursor = 1, layer = layer }
			for i = 1, POOL do
				local s = Instance.new("Sound")
				s.Name = name .. "_" .. li .. "_" .. i
				s.SoundId = layer.id
				s.Volume = layer.vol
				addFx(s, layer.fx)
				s.Parent = folder
				v.sounds[i] = s
			end
			list[li] = v
		end
		voices[name] = list
	end
end

function Audio.play(name: string, volumeScale: number?, pitchScale: number?)
	if Audio.muted then
		return
	end
	local list = voices[name]
	if not list then
		return
	end
	for _, v in list do
		local s = v.sounds[v.cursor]
		v.cursor = v.cursor % POOL + 1
		local l = v.layer
		local var = l.var or 0
		s.PlaybackSpeed = l.pitch * (pitchScale or 1) * (1 + (math.random() * 2 - 1) * var)
		s.Volume = l.vol * (volumeScale or 1) * Audio.volume
		s.TimePosition = 0
		s:Play()
	end
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">CameraRig</string>
            <string name="Source"><![CDATA[--!strict
-- Side-on "couch fighter" camera: frames every living fighter, eases zoom, adds shake.

local CameraRig = {}

local FOV = 34
local MIN_H, MAX_H = 34, 80

local cam: Camera = workspace.CurrentCamera
local cx, cy, h = 0, 8, 50
local trauma = 0
local punch = Vector2.zero
local bounds = { left = -60, right = 60, bottom = -30, top = 50 }
local t = 0
local zoomPunch = 0
CameraRig.shakeEnabled = true

function CameraRig.reset(b: { left: number, right: number, bottom: number, top: number })
	bounds = b
	cx = (b.left + b.right) * 0.5
	cy = (b.bottom + b.top) * 0.5 - 6
	h = MAX_H
	trauma = 0
end

function CameraRig.shake(amount: number)
	if CameraRig.shakeEnabled then
		trauma = math.min(1, trauma + amount)
	end
end

-- quick zoom-in on heavy impacts
function CameraRig.punchZoom(amount: number)
	if CameraRig.shakeEnabled then
		zoomPunch = math.min(0.25, zoomPunch + amount)
	end
end

function CameraRig.setBounds(b: { left: number, right: number, bottom: number, top: number })
	bounds = b
end

-- directional kick (e.g. recoil / big hit)
function CameraRig.kick(dx: number, dy: number)
	punch += Vector2.new(dx, dy)
end

function CameraRig.update(dt: number, targets: { Vector2 }, zoomBias: number?, snap: boolean?)
	cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = FOV
	t += dt
	local vp = cam.ViewportSize
	local aspect = if vp.Y > 0 then vp.X / vp.Y else 16 / 9

	local tx, ty, th
	if #targets == 0 then
		tx = (bounds.left + bounds.right) * 0.5
		ty = (bounds.bottom + bounds.top) * 0.5 - 6
		th = MAX_H
	else
		local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
		for _, p in targets do
			minX = math.min(minX, p.X)
			maxX = math.max(maxX, p.X)
			minY = math.min(minY, p.Y)
			maxY = math.max(maxY, p.Y)
		end
		minX -= 9
		maxX += 9
		minY -= 6
		maxY += 9
		tx = (minX + maxX) * 0.5
		ty = (minY + maxY) * 0.5
		th = math.max(maxY - minY, (maxX - minX) / aspect)
		th = math.clamp(th * (zoomBias or 1), MIN_H, MAX_H)
	end

	-- keep the view mostly inside the arena
	local halfW = th * aspect * 0.5
	local left, right = bounds.left - 10, bounds.right + 10
	if right - left > halfW * 2 then
		tx = math.clamp(tx, left + halfW, right - halfW)
	else
		tx = (left + right) * 0.5
	end
	ty = math.clamp(ty, bounds.bottom + th * 0.5 - 6, bounds.top - th * 0.5 + 10)

	local k = if snap then 1 else 1 - math.exp(-dt * 3.2)
	local kz = if snap then 1 else 1 - math.exp(-dt * 2.2)
	cx += (tx - cx) * k
	cy += (ty - cy) * k
	h += (th - h) * kz

	trauma = math.max(0, trauma - dt * 1.6)
	punch *= math.exp(-dt * 12)
	local s = trauma * trauma
	local sx = (math.noise(t * 25, 0.3) * 2) * s * 1.4 + punch.X
	local sy = (math.noise(0.7, t * 25) * 2) * s * 1.4 + punch.Y
	local roll = math.noise(t * 20, 4.2) * s * 0.035

	zoomPunch = math.max(0, zoomPunch - dt * 1.2)
	local hh = h * (1 - zoomPunch)
	local dist = (hh * 0.5) / math.tan(math.rad(FOV * 0.5))
	-- a slight look-down angle shows off the 3D depth of the arena
	local eye = Vector3.new(cx + sx, cy + sy + hh * 0.2, dist)
	cam.CFrame = CFrame.lookAt(eye, Vector3.new(cx + sx, cy + sy, 0)) * CFrame.Angles(0, 0, roll)
	cam.Focus = CFrame.new(cx, cy, 0)
end

-- world point on the z = 0 plane under a viewport position
function CameraRig.toWorld(screen: Vector2): Vector2?
	local ray = cam:ViewportPointToRay(screen.X, screen.Y)
	local dz = ray.Direction.Z
	if math.abs(dz) < 1e-5 then
		return nil
	end
	local s = -ray.Origin.Z / dz
	local p = ray.Origin + ray.Direction * s
	return Vector2.new(p.X, p.Y)
end

function CameraRig.viewHeight(): number
	return h
end

return CameraRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Controller</string>
            <string name="Source"><![CDATA[--!strict
-- Local fighter control: your own avatar, locked to the side-view plane.
-- Movement / jumps / attacks happen instantly here; hits are reported to the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Rig = require(Shared:WaitForChild("Rig"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Input = require(script.Parent:WaitForChild("Input"))
local Animator = require(script.Parent:WaitForChild("Animator"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local CameraRig = require(script.Parent:WaitForChild("CameraRig"))
local Tags = require(script.Parent:WaitForChild("Tags"))

local Controller = {}

local player = Players.LocalPlayer
local Event = Remotes.Event

local char: Model? = nil
local hum: Humanoid? = nil
local root: BasePart? = nil
local facingObj: AlignOrientation? = nil
local knockLV: LinearVelocity? = nil
local bodyParts: { BasePart } = {}

Controller.aim = 0
Controller.facing = 1
Controller.blocking = false
Controller.crouch = false

local input = {
	moveX = 0,
	jump = false,
	crouch = false,
	attack = false,
	block = false,
	aimX = 0,
	aimY = 0,
	jumpPressed = false,
	attackPressed = false,
	throwPressed = false,
}

local attackCd = 0
local attackBuffer = 0
local hand = "R"
local djumpUsed = false
local knockUntil = 0
local wasGrounded = true
local airTime = 0
local physicsSince = 0

local function now(): number
	return os.clock()
end

local function fighterFolder(): Instance?
	return workspace:FindFirstChild("Fighters")
end

local function fid(): number
	local c = char
	local v = if c then c:GetAttribute("Fid") else nil
	return if type(v) == "number" then v else 0
end
Controller.fid = fid

local function myColor(): Color3
	return if char then Tags.color(char) else Color3.new(1, 1, 1)
end

function Controller.character(): Model?
	return char
end

function Controller.alive(): boolean
	return char ~= nil and hum ~= nil and (hum :: Humanoid).Health > 0 and char.Parent ~= nil
end

function Controller.isRagdoll(): boolean
	return char ~= nil and (char :: Model):GetAttribute("Ragdoll") == true
end

function Controller.shoulder(): Vector3
	local c = char
	if not c then
		return Vector3.zero
	end
	local ut = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
	if ut and ut:IsA("BasePart") then
		return ut.Position + Vector3.new(0, ut.Size.Y * 0.3, 0)
	end
	return if root then root.Position + Vector3.new(0, 1.5, 0) else Vector3.zero
end

local function aimDir(): Vector3
	return Vector3.new(math.cos(Controller.aim), math.sin(Controller.aim), 0)
end

local function onCharacter(c: Model)
	char = c
	hum = c:WaitForChild("Humanoid", 10) :: Humanoid?
	root = c:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not hum or not root then
		return
	end
	local h = hum :: Humanoid
	h.AutoRotate = false
	pcall(function()
		h:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		h:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
	end)
	bodyParts = Rig.bodyParts(c)
	djumpUsed = false
	task.spawn(function()
		local r = root :: BasePart
		facingObj = r:WaitForChild("Facing", 15) :: AlignOrientation?
		knockLV = r:WaitForChild("Knock", 15) :: LinearVelocity?
	end)
end

function Controller.init()
	task.spawn(function()
		local ok, err = pcall(function()
			local ps = player:WaitForChild("PlayerScripts")
			local pm = require(ps:WaitForChild("PlayerModule") :: ModuleScript) :: any
			pm:GetControls():Disable()
		end)
		if not ok then
			warn("[Ragdoll Rumble] could not disable default controls:", err)
		end
	end)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

-------------------------------------------------------------------------------
-- hit detection against other fighters

local BODY = { "HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso" }

local function bodyDist(m: Model, p: Vector3): (number, Vector3)
	local best, bp = math.huge, p
	for _, n in BODY do
		local part = m:FindFirstChild(n)
		if part and part:IsA("BasePart") then
			local d = (part.Position - p).Magnitude
			if d < best then
				best, bp = d, part.Position
			end
		end
	end
	return best, bp
end

local function victimsNear(center: Vector3, radius: number): { { model: Model, fid: number, at: Vector3 } }
	local out = {}
	local folder = fighterFolder()
	if not folder then
		return out
	end
	for _, m in folder:GetChildren() do
		if m:IsA("Model") and m ~= char then
			local vf = m:GetAttribute("Fid")
			if type(vf) == "number" then
				local d, at = bodyDist(m, center)
				if d < radius then
					table.insert(out, { model = m, fid = vf, at = at })
				end
			end
		end
	end
	return out
end

local function fighterOf(inst: Instance): Model?
	local m: Instance? = inst
	while m and m ~= workspace do
		if m:IsA("Model") and m:GetAttribute("Fid") then
			return m :: Model
		end
		m = m.Parent
	end
	return nil
end

local function rayParams(): RaycastParams
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local list: { Instance } = {}
	if char then
		table.insert(list, char)
	end
	for _, n in { "RumbleFX", "Pickups", "Projectiles", "RumbleView" } do
		local f = workspace:FindFirstChild(n)
		if f then
			table.insert(list, f)
		end
	end
	local arena = workspace:FindFirstChild("Arena")
	if arena then
		local ink = arena:FindFirstChild("Ink")
		if ink then
			table.insert(list, ink)
		end
		local decor = arena:FindFirstChild("Decor")
		if decor then
			table.insert(list, decor)
		end
	end
	rp.FilterDescendantsInstances = list
	return rp
end

-------------------------------------------------------------------------------
-- attacks

local function impactFx(pos: Vector3, big: boolean)
	Effects.spark(pos, Color3.new(1, 1, 1), if big then 14 else 8, if big then 50 else 32)
	Effects.ring(pos, myColor(), if big then 4 else 2.4)
	CameraRig.shake(if big then 0.3 else 0.14)
	CameraRig.punchZoom(if big then 0.07 else 0.025)
	if big then
		Effects.stars(pos, Color3.fromRGB(255, 236, 150), 5)
	end
end

local function punch()
	hand = if hand == "R" then "L" else "R"
	attackCd = Config.PUNCH_COOLDOWN
	local f = fid()
	Animator.trigger(f, "punch", hand)
	Event:FireServer({ t = "Act", kind = "punch", hand = hand })
	Audio.play("whoosh")
	task.delay(0.075, function()
		if not Controller.alive() or Controller.isRagdoll() then
			return
		end
		local dir = aimDir()
		local center = Controller.shoulder() + dir * Config.PUNCH_REACH
		for _, v in victimsNear(center, Config.PUNCH_RADIUS) do
			Event:FireServer({ t = "Hit", victim = v.fid, kind = "punch", dx = dir.X, dy = dir.Y, x = v.at.X, y = v.at.Y })
			impactFx(center:Lerp(v.at, 0.5), false)
			Audio.play("punch")
		end
	end)
end

local function swing(w: Weapons.Weapon)
	attackCd = w.rate
	Animator.trigger(fid(), "swing")
	Event:FireServer({ t = "Act", kind = "swing" })
	Audio.play("slash")
	task.delay(0.06, function()
		local d = aimDir()
		Effects.slash(Controller.shoulder() + d * 2.4, Controller.aim, myColor(), Controller.facing, if w.key == "bonker" then 1.5 else 1.3)
	end)
	local hitSet: { [number]: boolean } = {}
	for _, delay in { 0.05, 0.1, 0.16 } do
		task.delay(delay, function()
			if not Controller.alive() or Controller.isRagdoll() then
				return
			end
			local dir = aimDir()
			local center = Controller.shoulder() + dir * (w.length * 0.6 + 1.2)
			for _, v in victimsNear(center, w.length * 0.55 + 1.6) do
				if not hitSet[v.fid] then
					hitSet[v.fid] = true
					Event:FireServer({ t = "Hit", victim = v.fid, kind = "melee", dx = dir.X, dy = dir.Y, x = v.at.X, y = v.at.Y })
					impactFx(v.at, true)
					Audio.play(if w.key == "bonker" then "bonk" else "heavy")
				end
			end
		end)
	end
end

function Controller.selfKnock(v: Vector3, duration: number)
	local lv = knockLV
	if lv then
		lv.VectorVelocity = v
		lv.Enabled = true
		knockUntil = now() + duration
	end
end

local function muzzleFrom(w: Weapons.Weapon): Vector3
	local sh = Controller.shoulder()
	local dir = aimDir()
	local reach = 1.9 + w.length * 0.8
	local hit = workspace:Raycast(sh, dir * reach, rayParams())
	if hit and not fighterOf(hit.Instance) then
		return hit.Position - dir * 0.3
	end
	return sh + dir * reach
end

local function fire(w: Weapons.Weapon)
	attackCd = w.rate
	local seed = math.random(1, 1000000)
	local origin = muzzleFrom(w)
	local rp = rayParams()
	local hits = {}
	local ends = {}
	local r, g, b = Util.hexToRGB(w.tracer)
	local tracerColor = Color3.fromRGB(r, g, b)
	for i, a in Weapons.angles(w, Controller.aim, seed) do
		local dir = Vector3.new(math.cos(a), math.sin(a), 0)
		local res = workspace:Raycast(origin, dir * w.range, rp)
		local endPos = if res then res.Position else origin + dir * w.range
		table.insert(ends, { endPos.X, endPos.Y })
		Effects.tracer(origin, endPos, tracerColor, if w.key == "longshot" then 0.35 else 0.18)
		if res then
			local m = fighterOf(res.Instance)
			if m then
				local vf = m:GetAttribute("Fid")
				table.insert(hits, { fid = vf, head = res.Instance.Name == "Head", x = res.Position.X, y = res.Position.Y, i = i })
				Effects.spark(res.Position, Color3.new(1, 1, 1), 6, 30)
			else
				Effects.spark(res.Position, tracerColor, 5, 22, 0.25)
			end
		end
	end
	Effects.muzzle(origin, Controller.aim, tracerColor)
	Effects.shell(Controller.shoulder(), Controller.facing)
	Audio.play(w.sound)
	Animator.trigger(fid(), "fire")
	CameraRig.shake(math.clamp(w.recoil / 60, 0.05, 0.4))
	local d = aimDir()
	CameraRig.kick(-d.X * 0.4, -d.Y * 0.4)
	if w.recoil >= 15 then
		local v = root and root.AssemblyLinearVelocity or Vector3.zero
		Controller.selfKnock(Vector3.new(v.X, math.max(v.Y, 0), 0) * 0.3 - d * w.recoil, 0.12)
	end
	Event:FireServer({ t = "Shoot", wid = w.id, x = origin.X, y = origin.Y, aim = Controller.aim, seed = seed, hits = hits, ends = ends })
end

local function launch(w: Weapons.Weapon)
	attackCd = w.rate
	Event:FireServer({ t = "Launch", wid = w.id, aim = Controller.aim })
	if w.kind == "throwable" then
		Animator.trigger(fid(), "lob")
		Audio.play("lob")
	else
		Animator.trigger(fid(), "fire")
		Audio.play("rocket")
		Effects.muzzle(muzzleFrom(w), Controller.aim, Color3.fromRGB(255, 160, 80))
		CameraRig.shake(0.25)
		if w.recoil > 0 then
			Controller.selfKnock(-aimDir() * w.recoil, 0.12)
		end
	end
end

-------------------------------------------------------------------------------
-- per frame

-- mouseWorld: point under the cursor; autoTarget: nearest enemy (pad / touch aim assist)
function Controller.update(dt: number, mouseWorld: Vector2?, autoTarget: Vector2?, frozen: boolean)
	local c, h, r = char, hum, root
	if not c or not h or not r or not c.Parent then
		return
	end
	local sh = Controller.shoulder()
	Input.apply(input, sh.X, sh.Y, Controller.facing, mouseWorld, autoTarget)
	local dx, dy = input.aimX - sh.X, input.aimY - sh.Y
	if dx * dx + dy * dy > 0.3 then
		Controller.aim = math.atan2(dy, dx)
	end
	local cx = math.cos(Controller.aim)
	if math.abs(cx) > 0.1 then
		Controller.facing = if cx > 0 then 1 else -1
	end

	local f = fid()
	local alive = Controller.alive()
	local floppy = Controller.isRagdoll()
	attackCd -= dt
	Controller.blocking = alive and not floppy and not frozen and input.block
	Controller.crouch = input.crouch
	local flags = (if Controller.blocking then 1 else 0) + (if Controller.crouch then 2 else 0)
	Animator.setState(f, Controller.aim, flags, true)

	-- failsafe: never stay stuck in Physics state once the server stood us up
	local st = h:GetState()
	if alive and not floppy and st == Enum.HumanoidStateType.Physics then
		physicsSince += dt
		if physicsSince > 0.4 then
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
			physicsSince = 0
		end
	else
		physicsSince = 0
	end

	if not alive or floppy or frozen then
		h:Move(Vector3.zero, false)
		input.jumpPressed, input.attackPressed, input.throwPressed = false, false, false
		attackBuffer = 0
		return
	end

	local fo = facingObj
	if fo then
		fo.CFrame = Rig.facingCFrame(Controller.facing)
	end

	-- movement
	local grounded = h.FloorMaterial ~= Enum.Material.Air
	local speedMul = if Controller.blocking then Config.BLOCK_SPEED elseif input.crouch and grounded then 0.45 else 1
	if now() > knockUntil then
		h:Move(Vector3.new(input.moveX * speedMul, 0, 0), false)
	end
	if grounded then
		if not wasGrounded and airTime > 0.3 then
			Audio.play("land", math.clamp(airTime, 0.4, 1.2))
			Effects.dust(r.Position - Vector3.new(0, 2.6, 0), 4)
		end
		djumpUsed = false
		airTime = 0
	else
		airTime += dt
	end
	wasGrounded = grounded

	if input.jumpPressed then
		input.jumpPressed = false
		if grounded then
			h.Jump = true
			Audio.play("jump")
			Effects.dust(r.Position - Vector3.new(0, 2.6, 0), 3)
		elseif not djumpUsed then
			djumpUsed = true
			local v = r.AssemblyLinearVelocity
			r.AssemblyLinearVelocity = Vector3.new(v.X, Config.DOUBLE_JUMP_VELOCITY, 0)
			Animator.trigger(f, "djump")
			Event:FireServer({ t = "Act", kind = "djump" })
			Effects.ring(r.Position - Vector3.new(0, 2.4, 0), myColor(), 4)
			Audio.play("djump")
		end
	end
	if not grounded and input.crouch then
		local v = r.AssemblyLinearVelocity
		if v.Y > -90 then
			r.AssemblyLinearVelocity = v - Vector3.new(0, Config.FAST_FALL * dt, 0)
		end
	end

	-- attacks
	local w = Weapons.get(c:GetAttribute("Wid") :: number?)
	local ammo = (c:GetAttribute("Ammo") :: number?) or 0
	if input.throwPressed then
		input.throwPressed = false
		if w then
			Event:FireServer({ t = "Throw", aim = Controller.aim })
			Animator.trigger(f, "throw")
			Audio.play("throw")
		end
	end
	if input.attackPressed then
		attackBuffer = 0.2
		input.attackPressed = false
	else
		attackBuffer = math.max(0, attackBuffer - dt)
	end
	local want = attackBuffer > 0 or (input.attack and w ~= nil and w.auto)
	if want and attackCd <= 0 and not Controller.blocking then
		attackBuffer = 0
		if not w then
			punch()
		elseif w.kind == "melee" then
			swing(w)
		elseif w.kind == "gun" then
			if ammo > 0 then
				fire(w)
			end
		elseif ammo > 0 then
			launch(w)
		end
	end
end

-- before each physics step
function Controller.physicsStep(_dt: number)
	local c, r = char, root
	if not c or not r or not c.Parent then
		return
	end
	local lv = knockLV
	if lv and lv.Enabled and now() > knockUntil then
		lv.Enabled = false
	end
	local floppy = Controller.isRagdoll() or not Controller.alive()
	Rig.lockPlane(c, r, if floppy then bodyParts else nil)
end

-------------------------------------------------------------------------------
-- server -> me

function Controller.onKnock(msg: any)
	local c, h = char, hum
	if not c or not h then
		return
	end
	local v = Vector3.new(tonumber(msg.vx) or 0, tonumber(msg.vy) or 0, 0)
	if msg.floppy then
		if h.Health > 0 then
			h:ChangeState(Enum.HumanoidStateType.Physics)
		end
		Rig.fling(c, v, (math.random() - 0.5) * 14)
	else
		Controller.selfKnock(v, Config.KNOCK_TIME)
		if v.Y > 10 then
			h:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end
end

function Controller.onGetUp()
	local h = hum
	if h and h.Health > 0 then
		h:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

-- nearest enemy for aim assist
function Controller.nearestEnemy(): Vector2?
	local c, r = char, root
	local folder = fighterFolder()
	if not c or not r or not folder then
		return nil
	end
	local best, bestD = nil, 60
	for _, m in folder:GetChildren() do
		if m:IsA("Model") and m ~= c then
			local hm = m:FindFirstChildOfClass("Humanoid")
			local t = m:FindFirstChild("UpperTorso") or m:FindFirstChild("HumanoidRootPart")
			if hm and hm.Health > 0 and t and t:IsA("BasePart") then
				local d = (t.Position - r.Position).Magnitude
				if d < bestD then
					best, bestD = Vector2.new(t.Position.X, t.Position.Y), d
				end
			end
		end
	end
	return best
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CosmeticFx</string>
            <string name="Source"><![CDATA[--!strict
-- Finisher (KO) and entrance (spawn) effects. Built from the Blender VFX meshes
-- (stars, rings, skulls, bolts, rocks, halos) when available, else neon parts.

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Effects = require(script.Parent:WaitForChild("Effects"))
local Skins = require(script.Parent:WaitForChild("Skins"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local CameraRig = require(script.Parent:WaitForChild("CameraRig"))

local Fx = {}

type Obj = {
	inst: Instance,
	parts: { BasePart },
	base: { [BasePart]: number },
	pos: Vector3,
	vel: Vector3,
	grav: number,
	rot: CFrame,
	spinAxis: Vector3,
	spin: number,
	scale0: number,
	scale1: number,
	size0: { [BasePart]: Vector3 },
	life: number,
	max: number,
	fadeAt: number,
	pull: Vector3?,
	hue: boolean,
}

local live: { Obj } = {}

local function rand(a: number, b: number): number
	return a + (b - a) * math.random()
end

-- spawn a mesh (or a fallback neon part) that moves / spins / grows / fades
local function obj(mesh: string?, pos: Vector3, scale: number, life: number, o: any?): Obj
	local opts = o or {}
	local inst: Instance
	local parts: { BasePart } = {}
	local m = if mesh then Skins.clone(mesh, CFrame.new(), 1) else nil
	if m then
		inst = m
		for _, p in m:GetChildren() do
			if p:IsA("BasePart") then
				p.Anchored = true
				table.insert(parts, p)
				if opts.color and p.Material == Enum.Material.Neon then
					p.Color = opts.color
				end
			end
		end
	else
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = opts.material or Enum.Material.Neon
		p.Color = opts.color or Color3.new(1, 1, 1)
		local shape = opts.shape or "ball"
		if shape == "ball" then
			p.Shape = Enum.PartType.Ball
		elseif shape == "disc" then
			p.Shape = Enum.PartType.Cylinder
		end
		p.Size = opts.size or Vector3.new(1, 1, 1)
		inst = p
		table.insert(parts, p)
	end
	inst.Parent = Effects.folder()
	local base, size0 = {}, {}
	for _, p in parts do
		base[p] = opts.transparency or p.Transparency
		size0[p] = p.Size
	end
	local ob: Obj = {
		inst = inst,
		parts = parts,
		base = base,
		pos = pos,
		vel = opts.vel or Vector3.zero,
		grav = opts.grav or 0,
		rot = opts.rot or CFrame.identity,
		spinAxis = opts.axis or Vector3.zAxis,
		spin = opts.spin or 0,
		scale0 = scale,
		scale1 = opts.scaleTo or scale,
		size0 = size0,
		life = life,
		max = life,
		fadeAt = opts.fadeAt or 0.6,
		pull = opts.pull,
		hue = opts.hue == true,
	}
	table.insert(live, ob)
	return ob
end

RunService.RenderStepped:Connect(function(dt)
	for i = #live, 1, -1 do
		local o = live[i]
		o.life -= dt
		if o.life <= 0 or not o.inst.Parent then
			o.inst:Destroy()
			table.remove(live, i)
			continue
		end
		local k = 1 - o.life / o.max
		if o.pull then
			local to = (o.pull :: Vector3) - o.pos
			o.vel += to * dt * 12
		end
		o.vel -= Vector3.new(0, o.grav * dt, 0)
		o.pos += o.vel * dt
		o.rot *= CFrame.fromAxisAngle(o.spinAxis, o.spin * dt)
		local s = o.scale0 + (o.scale1 - o.scale0) * (1 - (1 - k) ^ 3)
		local fade = if k > o.fadeAt then (k - o.fadeAt) / (1 - o.fadeAt) else 0
		local cf = CFrame.new(o.pos) * o.rot
		for _, p in o.parts do
			p.Size = o.size0[p] * s
			p.Transparency = o.base[p] + (1 - o.base[p]) * fade
			if o.hue then
				p.Color = Color3.fromHSV((os.clock() * 0.8 + k) % 1, 0.7, 1)
			end
		end
		if o.inst:IsA("Model") then
			(o.inst :: Model):PivotTo(cf)
		else
			(o.inst :: BasePart).CFrame = cf
		end
	end
end)

-- jagged lightning between two points
local function bolt(from: Vector3, to: Vector3, color: Color3, width: number?)
	local segs = 9
	local prev = from
	local w = width or 0.45
	for i = 1, segs do
		local p = from:Lerp(to, i / segs)
		if i < segs then
			p += Vector3.new(rand(-2.2, 2.2), 0, rand(-0.5, 0.5))
		end
		local d = p - prev
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = color
		part.Size = Vector3.new(w, w, d.Magnitude + 0.2)
		part.CFrame = CFrame.lookAt(prev + d * 0.5, p)
		part.Parent = Effects.folder()
		TweenService:Create(part, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Transparency = 1 }):Play()
		Debris:AddItem(part, 0.4)
		prev = p
	end
end

local function beam(pos: Vector3, height: number, width: number, color: Color3, life: number)
	obj(nil, pos + Vector3.new(0, height * 0.5, -0.5), 1, life, { shape = "block", size = Vector3.new(width, height, width), color = color, transparency = 0.25, scaleTo = 0.15, fadeAt = 0.3 })
end

local function rings(pos: Vector3, color: Color3, n: number, size: number, life: number?)
	for i = 1, n do
		task.delay((i - 1) * 0.12, function()
			obj("fx_ring", pos + Vector3.new(0, 0, 1), size * 0.3, life or 0.6, { color = color, scaleTo = size * (1 + i * 0.4), fadeAt = 0.2, shape = "disc", size = Vector3.new(0.2, 2, 2), rot = CFrame.Angles(0, math.pi / 2, 0) })
		end)
	end
end

local function stars(pos: Vector3, color: Color3?, n: number, speed: number, life: number?)
	for _ = 1, n do
		local a = rand(0, math.pi * 2)
		local c = color or Color3.fromHSV(math.random(), 0.6, 1)
		obj("fx_star", pos, rand(0.35, 0.7), life or rand(0.7, 1.1), {
			vel = Vector3.new(math.cos(a), math.sin(a), 0) * rand(speed * 0.5, speed),
			grav = 30,
			spin = rand(-8, 8),
			color = c,
			scaleTo = 0.1,
			fadeAt = 0.5,
			size = Vector3.new(0.8, 0.8, 0.8),
		})
	end
end

local function cubes(pos: Vector3, color: Color3, n: number, speed: number, glitch: boolean?)
	for _ = 1, n do
		local a = rand(0, math.pi * 2)
		local c = if glitch then (if math.random() < 0.5 then Color3.fromRGB(0, 255, 156) else Color3.new(0, 0, 0)) else color
		obj(nil, pos + Vector3.new(rand(-1, 1), rand(-1.5, 1.5), 0), 1, rand(0.7, 1.3), {
			shape = "block",
			size = Vector3.new(0.55, 0.55, 0.55),
			color = c,
			material = if math.random() < 0.4 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
			vel = Vector3.new(math.cos(a), math.sin(a) + 0.6, 0) * rand(speed * 0.4, speed),
			grav = 70,
			spin = rand(-10, 10),
			axis = Vector3.new(rand(-1, 1), rand(-1, 1), rand(-1, 1)).Unit,
			fadeAt = 0.6,
		})
	end
end

-------------------------------------------------------------------------------
-- finishers (play where the victim fell)

local FINISHERS: { [string]: (Vector3, Color3) -> () } = {}

FINISHERS.pop = function(_pos, _color) end

FINISHERS.confetti = function(pos, _color)
	Effects.confetti(pos + Vector3.new(0, 4, 0), 10)
	Audio.play("pickup", 1, 0.8)
	Audio.play("win", 0.6, 1.5)
end

FINISHERS.splash = function(pos, color)
	Effects.paint(pos, Vector3.new(0, 60, 0), color, 40)
	rings(pos, color, 2, 5)
	Audio.play("heavy", 0.8, 1.2)
end

FINISHERS.shockwave = function(pos, color)
	rings(pos, color, 3, 9)
	Effects.dust(pos - Vector3.new(0, 2, 0), 10)
	CameraRig.shake(0.5)
	Audio.play("boom", 0.6, 1.4)
end

FINISHERS.skull = function(pos, color)
	obj("fx_skull", pos + Vector3.new(0, 3, 1.5), 0.1, 1.6, { scaleTo = 2.4, vel = Vector3.new(0, 3, 0), spin = 1.2, axis = Vector3.yAxis, fadeAt = 0.7, color = color, size = Vector3.new(2, 2, 2) })
	Effects.spark(pos, Color3.fromRGB(170, 110, 255), 18, 40)
	Audio.play("ko", 0.8, 1.4)
end

FINISHERS.thunder = function(pos, _color)
	bolt(pos + Vector3.new(rand(-4, 4), 70, 0), pos, Color3.fromRGB(255, 240, 140), 0.6)
	bolt(pos + Vector3.new(rand(-6, 6), 70, 0), pos, Color3.fromRGB(160, 220, 255), 0.3)
	Effects.flash(pos, Color3.new(1, 1, 1), 8, 0.2)
	Effects.spark(pos, Color3.fromRGB(255, 240, 140), 26, 70)
	Effects.dust(pos - Vector3.new(0, 2, 0), 8, Color3.fromRGB(120, 120, 130))
	CameraRig.shake(0.7)
	Audio.play("boom", 0.9, 1.6)
end

FINISHERS.shatter = function(pos, color)
	cubes(pos, color, 34, 45)
	Effects.flash(pos, color, 4, 0.15)
	Audio.play("ko", 0.6, 1.8)
end

FINISHERS.fireworks = function(pos, _color)
	for i = 1, 5 do
		task.delay(i * 0.18, function()
			local c = Color3.fromHSV(math.random(), 0.7, 1)
			local start = pos + Vector3.new(rand(-8, 8), 0, 0)
			local rocket = obj(nil, start, 1, 0.7, { shape = "ball", size = Vector3.new(0.6, 0.6, 0.6), color = c, vel = Vector3.new(rand(-6, 6), 55, 0), grav = 30, fadeAt = 0.95 })
			Audio.play("whoosh", 0.6, 0.8)
			task.delay(0.65, function()
				stars(rocket.pos, c, 14, 26, 1.2)
				Effects.flash(rocket.pos, c, 3, 0.15)
				Audio.play("boom", 0.4, 1.8)
			end)
		end)
	end
end

FINISHERS.supernova = function(pos, _color)
	local gold = Color3.fromRGB(255, 211, 110)
	obj(nil, pos, 1, 0.5, { shape = "ball", size = Vector3.new(6, 6, 6), color = gold, scaleTo = 0.05, fadeAt = 0.95 })
	Audio.play("djump", 1, 0.5)
	task.delay(0.5, function()
		obj(nil, pos, 0.2, 0.7, { shape = "ball", size = Vector3.new(10, 10, 10), color = Color3.new(1, 1, 1), scaleTo = 2.2, fadeAt = 0.2 })
		rings(pos, gold, 3, 14)
		stars(pos, gold, 16, 50, 1.3)
		Effects.spark(pos, gold, 30, 90, 0.6)
		CameraRig.shake(1)
		Audio.play("boom", 1.2, 0.9)
	end)
end

FINISHERS.blackhole = function(pos, _color)
	local purple = Color3.fromRGB(165, 107, 255)
	local core = obj(nil, pos, 0.1, 2.2, { shape = "ball", size = Vector3.new(6, 6, 6), color = Color3.new(0, 0, 0), material = Enum.Material.SmoothPlastic, scaleTo = 1, fadeAt = 0.85 })
	obj("fx_ring", pos + Vector3.new(0, 0, 0.5), 3, 2.2, { color = purple, spin = 4, axis = Vector3.zAxis, scaleTo = 4, fadeAt = 0.85, rot = CFrame.Angles(0.5, 0, 0), shape = "disc", size = Vector3.new(0.2, 2, 2) })
	for i = 1, 40 do
		task.delay(i * 0.04, function()
			local a = rand(0, math.pi * 2)
			local r = rand(10, 16)
			obj(nil, pos + Vector3.new(math.cos(a) * r, math.sin(a) * r, 0), 1, 0.9, { shape = "ball", size = Vector3.new(0.4, 0.4, 0.4), color = if i % 2 == 0 then purple else Color3.new(1, 1, 1), pull = pos, fadeAt = 0.8 })
		end)
	end
	Audio.play("whoosh", 1, 0.4)
	task.delay(2, function()
		core.life = 0.01
		Effects.flash(pos, purple, 9, 0.3)
		rings(pos, purple, 2, 12)
		CameraRig.shake(0.8)
		Audio.play("boom", 1, 0.6)
	end)
end

FINISHERS.rift = function(pos, _color)
	obj(nil, pos + Vector3.new(0, 4, -0.5), 1, 2, { shape = "block", size = Vector3.new(0.8, 16, 0.8), color = Color3.new(1, 1, 1), hue = true, scaleTo = 1.6, fadeAt = 0.6 })
	for i = 1, 4 do
		task.delay(i * 0.2, function()
			obj("fx_ring", pos + Vector3.new(0, 0, 1), 1, 1, { hue = true, scaleTo = 8 + i * 2, fadeAt = 0.3, shape = "disc", size = Vector3.new(0.2, 2, 2), rot = CFrame.Angles(0, math.pi / 2, 0) })
		end)
	end
	stars(pos, nil, 22, 40, 1.4)
	Effects.confetti(pos + Vector3.new(0, 6, 0), 14)
	CameraRig.shake(0.6)
	Audio.play("win", 1, 1.1)
	Audio.play("djump", 1, 0.7)
end

FINISHERS.glitch = function(pos, _color)
	for i = 1, 12 do
		task.delay(i * 0.08, function()
			cubes(pos + Vector3.new(rand(-3, 3), rand(-2, 4), 0), Color3.new(), 4, 20, true)
			if i % 3 == 0 then
				Audio.play("tick", 0.8, rand(0.5, 2.5))
			end
		end)
	end
	Effects.text(pos + Vector3.new(0, 5, 0), "GLITCH.EXE", Color3.fromRGB(0, 255, 156), 40, 1.6)
	task.delay(0.4, function()
		Effects.text(pos + Vector3.new(rand(-3, 3), 3, 0), "ERR", Color3.fromRGB(255, 80, 80), 30, 0.8)
	end)
	Audio.play("deflect", 1, 0.4)
end

-------------------------------------------------------------------------------
-- entrances (play at the spawn point)

local SPAWNS: { [string]: (Vector3, Color3) -> () } = {}

SPAWNS.drop = function(pos, _color)
	Effects.dust(pos - Vector3.new(0, 3, 0), 6)
end

SPAWNS.smoke = function(pos, _color)
	for _ = 1, 3 do
		Effects.dust(pos + Vector3.new(0, rand(-2, 2), 0), 6, Color3.fromRGB(160, 160, 170))
	end
	Audio.play("whoosh", 0.6, 0.6)
end

SPAWNS.paintbomb = function(pos, color)
	Effects.paint(pos, Vector3.new(0, 40, 0), color, 24)
	rings(pos, color, 1, 6)
	Audio.play("heavy", 0.6, 1.3)
end

SPAWNS.sparks = function(pos, color)
	for i = 1, 8 do
		task.delay(i * 0.08, function()
			Effects.spark(pos - Vector3.new(0, 2.5, 0), if i % 2 == 0 then color else Color3.fromRGB(255, 220, 120), 6, 40)
		end)
	end
	Audio.play("pickup", 0.6, 1.2)
end

SPAWNS.rings = function(pos, color)
	for i = 1, 3 do
		task.delay(i * 0.15, function()
			obj("fx_ring", pos + Vector3.new(0, -2.5 + i * 1.6, 0), 1.2, 0.6, { color = color, scaleTo = 2.2, fadeAt = 0.3, rot = CFrame.Angles(math.pi / 2, 0, 0), shape = "disc", size = Vector3.new(0.2, 2.4, 2.4) })
		end)
	end
	Audio.play("djump", 0.6, 1.2)
end

SPAWNS.lightning = function(pos, _color)
	bolt(pos + Vector3.new(rand(-3, 3), 70, 0), pos - Vector3.new(0, 2.5, 0), Color3.fromRGB(160, 220, 255), 0.55)
	Effects.flash(pos, Color3.new(1, 1, 1), 6, 0.2)
	Effects.dust(pos - Vector3.new(0, 2.5, 0), 8)
	CameraRig.shake(0.4)
	Audio.play("boom", 0.6, 1.7)
end

SPAWNS.meteor = function(pos, _color)
	local start = pos + Vector3.new(-30, 60, 0)
	local rock = obj("fx_rock", start, 1.4, 0.6, { vel = (pos - start) / 0.55, spin = 6, axis = Vector3.new(1, 1, 0).Unit, fadeAt = 0.98, color = Color3.fromRGB(255, 120, 40), shape = "ball", size = Vector3.new(2.5, 2.5, 2.5), material = Enum.Material.Slate })
	local trail = true
	task.spawn(function()
		while trail do
			Effects.spark(rock.pos, Color3.fromRGB(255, 140, 40), 3, 10, 0.5)
			task.wait(0.03)
		end
	end)
	Audio.play("whoosh", 1, 0.6)
	task.delay(0.55, function()
		trail = false
		Effects.explosion(pos - Vector3.new(0, 2, 0), 6)
		Effects.dust(pos - Vector3.new(0, 2.5, 0), 12, Color3.fromRGB(120, 100, 90))
		CameraRig.shake(0.6)
		Audio.play("boom", 0.8, 1.2)
	end)
end

SPAWNS.portal = function(pos, color)
	obj("fx_ring", pos + Vector3.new(0, 0, -1), 0.2, 1.4, { color = color, spin = 5, axis = Vector3.zAxis, scaleTo = 3.6, fadeAt = 0.7, rot = CFrame.Angles(0, 0, 0), shape = "disc", size = Vector3.new(0.2, 2, 2) })
	obj(nil, pos + Vector3.new(0, 0, -1.4), 0.2, 1.4, { shape = "disc", size = Vector3.new(0.1, 6.5, 6.5), color = Color3.fromRGB(40, 10, 80), material = Enum.Material.SmoothPlastic, rot = CFrame.Angles(0, math.pi / 2, 0), scaleTo = 1, fadeAt = 0.7 })
	Effects.spark(pos, color, 14, 30)
	Audio.play("djump", 1, 0.6)
end

SPAWNS.angel = function(pos, _color)
	beam(pos - Vector3.new(0, 3, 0), 120, 5, Color3.fromRGB(255, 245, 210), 1.6)
	obj("fx_halo", pos + Vector3.new(0, 3.6, 0), 0.6, 2, { color = Color3.fromRGB(255, 220, 120), spin = 2, axis = Vector3.yAxis, scaleTo = 0.7, fadeAt = 0.8, shape = "disc", size = Vector3.new(0.2, 2, 2) })
	for _ = 1, 16 do
		obj(nil, pos + Vector3.new(rand(-4, 4), rand(4, 10), rand(-1, 1)), 1, rand(1.2, 2), { shape = "block", size = Vector3.new(0.15, 0.7, 0.3), color = Color3.new(1, 1, 1), vel = Vector3.new(rand(-1, 1), -4, 0), spin = rand(-3, 3), fadeAt = 0.6 })
	end
	Audio.play("win", 0.8, 1.6)
end

SPAWNS.void = function(pos, _color)
	local purple = Color3.fromRGB(120, 40, 200)
	obj(nil, pos + Vector3.new(0, 0, -0.8), 1, 1.8, { shape = "block", size = Vector3.new(1.2, 9, 0.6), color = Color3.new(0, 0, 0), material = Enum.Material.SmoothPlastic, scaleTo = 0.1, fadeAt = 0.7 })
	obj(nil, pos + Vector3.new(0, 0, -1), 1, 1.8, { shape = "block", size = Vector3.new(2, 10, 0.4), color = purple, scaleTo = 0.1, fadeAt = 0.6 })
	for _ = 1, 20 do
		local a = rand(0, math.pi * 2)
		obj(nil, pos, 1, rand(0.6, 1.1), { shape = "block", size = Vector3.new(0.3, 0.3, 0.3), color = if math.random() < 0.5 then purple else Color3.new(0, 0, 0), vel = Vector3.new(math.cos(a), math.sin(a), 0) * rand(10, 25), fadeAt = 0.5, spin = 8 })
	end
	CameraRig.shake(0.3)
	Audio.play("whoosh", 1, 0.35)
end

SPAWNS.starfall = function(pos, _color)
	for i = 1, 20 do
		task.delay(i * 0.06, function()
			local start = pos + Vector3.new(rand(-10, 10), rand(20, 30), rand(-1, 1))
			obj("fx_star", start, 0.5, 1.2, { vel = Vector3.new(rand(-4, 4), -40, 0), spin = 6, color = Color3.fromHSV(rand(0.1, 0.2), 0.6, 1), fadeAt = 0.7, size = Vector3.new(0.8, 0.8, 0.8) })
		end)
	end
	stars(pos, nil, 12, 30)
	Audio.play("win", 0.7, 1.3)
end

SPAWNS.error404 = function(pos, _color)
	for i = 1, 10 do
		task.delay(i * 0.06, function()
			cubes(pos + Vector3.new(rand(-2, 2), rand(-2, 3), 0), Color3.new(), 3, 15, true)
		end)
	end
	Effects.text(pos + Vector3.new(0, 5, 0), "404", Color3.fromRGB(0, 255, 156), 48, 1.4)
	Audio.play("deflect", 1, 0.5)
end

function Fx.finisher(id: string?, pos: Vector3, color: Color3)
	local fn = FINISHERS[id or "pop"]
	if fn then
		fn(pos, color)
	end
end

function Fx.entrance(id: string?, pos: Vector3, color: Color3)
	local fn = SPAWNS[id or "drop"]
	if fn then
		fn(pos, color)
	end
end

function Fx.preview(id: string, pos: Vector3, color: Color3)
	if FINISHERS[id] then
		Fx.finisher(id, pos, color)
	else
		Fx.entrance(id, pos, color)
	end
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">CrateUI</string>
            <string name="Source"><![CDATA[--!strict
-- Crate roll cutscene: spinning crate -> name ticker that slows down -> rarity build-up
-- (flashes / shakes that escalate tier by tier for rare pulls) -> reveal card.

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local UI = require(script.Parent:WaitForChild("UIKit"))
local Store = require(script.Parent:WaitForChild("Store"))
local Skins = require(script.Parent:WaitForChild("Skins"))
local Audio = require(script.Parent:WaitForChild("Audio"))

local CrateUI = {}

local gui: ScreenGui
local overlay: Frame
local flash: Frame
local stage: Frame
local ticker: TextLabel
local tickerSub: TextLabel
local tierText: TextLabel
local busy = false
local particles: { { f: Frame, v: Vector2, life: number, max: number } } = {}

function CrateUI.init(parent: Instance)
	gui = UI.new("ScreenGui", { Name = "RumbleCrates", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 40, Enabled = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, parent)
	overlay = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.C.dark, BackgroundTransparency = 1, ZIndex = 1 }, gui)
	flash = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 30 }, gui)
	stage = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 }, gui)
	ticker = UI.text({ Size = UDim2.new(1, 0, 0, 90), Position = UDim2.new(0, 0, 0.62, 0), FontFace = UI.TITLE, TextSize = 70, Text = "", ZIndex = 10 }, stage)
	UI.textStroke(ticker, 5)
	tickerSub = UI.text({ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0.62, 86), FontFace = UI.HEAVY, TextSize = 26, Text = "", ZIndex = 10 }, stage)
	UI.textStroke(tickerSub, 2.5)
	tierText = UI.text({ Size = UDim2.new(1, 0, 0, 140), Position = UDim2.new(0, 0, 0.18, 0), FontFace = UI.TITLE, TextSize = 120, Text = "", TextTransparency = 1, ZIndex = 12 }, stage)
	UI.textStroke(tierText, 7)
	RunService.RenderStepped:Connect(function(dt)
		for i = #particles, 1, -1 do
			local p = particles[i]
			p.life -= dt
			if p.life <= 0 or not p.f.Parent then
				p.f:Destroy()
				table.remove(particles, i)
				continue
			end
			p.v += Vector2.new(0, 600 * dt)
			local pos = p.f.Position
			p.f.Position = UDim2.new(pos.X.Scale, pos.X.Offset + p.v.X * dt, pos.Y.Scale, pos.Y.Offset + p.v.Y * dt)
			p.f.Rotation += p.v.X * dt
			p.f.BackgroundTransparency = 1 - p.life / p.max
		end
	end)
end

local function burst(color: Color3, n: number, z: number?)
	for _ = 1, n do
		local s = math.random(6, 14)
		local f = UI.new("Frame", {
			Size = UDim2.fromOffset(s, s),
			Position = UDim2.fromScale(0.5, 0.45),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = if math.random() < 0.3 then Color3.new(1, 1, 1) else color,
			BorderSizePixel = 0,
			Rotation = math.random(0, 90),
			ZIndex = z or 15,
		}, stage)
		local a = math.random() * math.pi * 2
		local sp = math.random(250, 750)
		local life = 0.8 + math.random() * 0.8
		table.insert(particles, { f = f, v = Vector2.new(math.cos(a) * sp, math.sin(a) * sp - 300), life = life, max = life })
	end
end

local function doFlash(color: Color3, strength: number, t: number)
	if not Store.settings.flashing then
		strength *= 0.25
	end
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - strength
	UI.tween(flash, t, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
end

local function shake(amount: number, t: number)
	if not Store.settings.shake then
		return
	end
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < t do
			local k = 1 - (os.clock() - start) / t
			stage.Position = UDim2.fromOffset((math.random() - 0.5) * amount * k, (math.random() - 0.5) * amount * k)
			RunService.RenderStepped:Wait()
		end
		stage.Position = UDim2.fromOffset(0, 0)
	end)
end

-- 3D crate in a ViewportFrame (Blender mesh if available, else a chunky block)
local function crateView(kind: string): (ViewportFrame, () -> ())
	local vp = UI.new("ViewportFrame", {
		Size = UDim2.fromOffset(320, 320),
		Position = UDim2.fromScale(0.5, 0.36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 160, 200),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1, -1),
		ZIndex = 6,
	}, stage)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local model = Skins.clone(if kind == "finisher" then "crate_finisher" else "crate_spawn", CFrame.new(), 1)
	if not model then
		model = Instance.new("Model")
		local box = Instance.new("Part")
		box.Size = Vector3.new(3, 3, 3)
		box.Color = if kind == "finisher" then Color3.fromRGB(176, 40, 58) else Color3.fromRGB(30, 78, 140)
		box.Material = Enum.Material.WoodPlanks
		box.Parent = model
		local band = Instance.new("Part")
		band.Size = Vector3.new(3.1, 0.5, 3.1)
		band.Color = Color3.fromRGB(255, 201, 60)
		band.Material = Enum.Material.Neon
		band.Parent = model
		model.PrimaryPart = box
	end
	local m = model :: Model
	m.Parent = vp
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 2.2, 8.5), Vector3.zero)
	local spin = 0
	local shakeAmt = 0
	local alive = true
	local conn = RunService.RenderStepped:Connect(function(dt)
		if not alive or not m.Parent then
			return
		end
		spin += dt * (1.2 + shakeAmt * 6)
		local j = shakeAmt * 0.25
		m:PivotTo(CFrame.Angles(0, spin, 0) * CFrame.Angles((math.random() - 0.5) * j, 0, (math.random() - 0.5) * j))
	end)
	local function setShake(v: number)
		shakeAmt = v
	end
	vp:SetAttribute("Shake", 0)
	vp.AttributeChanged:Connect(function(a)
		if a == "Shake" then
			setShake(vp:GetAttribute("Shake") :: number)
		end
	end)
	return vp, function()
		alive = false
		conn:Disconnect()
	end
end

local function blur(on: boolean)
	local b = Lighting:FindFirstChild("RumbleBlur") :: BlurEffect?
	if not b then
		local nb = Instance.new("BlurEffect")
		nb.Name = "RumbleBlur"
		nb.Size = 0
		nb.Parent = Lighting
		b = nb
	end
	UI.tween(b :: BlurEffect, 0.4, { Size = if on then 18 else 0 })
end

function CrateUI.busy(): boolean
	return busy
end

-- res = server roll result { item, new, refund, count }; onEquip(id) called by the EQUIP button
function CrateUI.play(kind: string, res: any, onEquip: (string) -> ())
	if busy then
		return
	end
	local item = Cosmetics.byId[res.item]
	if not item then
		return
	end
	busy = true
	local rarity = Cosmetics.rarity(item)
	gui.Enabled = true
	overlay.BackgroundTransparency = 1
	UI.tween(overlay, 0.35, { BackgroundTransparency = 0.25 })
	blur(true)
	ticker.Text = ""
	tickerSub.Text = ""
	tierText.TextTransparency = 1
	stage.Position = UDim2.fromOffset(0, 0)

	local vp, stopView = crateView(kind)
	local glow = UI.new("Frame", { Size = UDim2.fromOffset(260, 260), Position = UDim2.fromScale(0.5, 0.36), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = UI.C.gold, BackgroundTransparency = 0.8, ZIndex = 5 }, stage)
	UI.round(glow)
	UI.pop(vp, 0.4, 0.4)
	Audio.play("lob", 1, 0.8)

	-- 1) shake the crate
	vp:SetAttribute("Shake", 0.4)
	for i = 1, 6 do
		Audio.play("tick", 0.6, 0.7 + i * 0.08)
		UI.tween(glow, 0.12, { Size = UDim2.fromOffset(260 + i * 14, 260 + i * 14), BackgroundTransparency = 0.8 - i * 0.06 })
		task.wait(0.11)
	end

	-- 2) ticker
	local quick = Store.settings.quickRolls and item.rarity <= 2
	local pool = Cosmetics.ofKind(kind)
	local rollable = {}
	for _, it in pool do
		if it.chance > 0 then
			-- show common stuff more often, like real odds
			local w = math.max(1, math.floor(12 / math.sqrt(it.chance)))
			for _ = 1, w do
				table.insert(rollable, it)
			end
		end
	end
	local total = if quick then 0.5 else 2.0 + item.rarity * 0.25
	local start = os.clock()
	local interval = 0.045
	local shown = rollable[1]
	while os.clock() - start < total do
		shown = rollable[math.random(1, #rollable)]
		local r = Cosmetics.rarity(shown)
		ticker.Text = string.upper(shown.name)
		ticker.TextColor3 = r.color
		tickerSub.Text = r.name .. "  ·  " .. Cosmetics.formatChance(shown.chance)
		tickerSub.TextColor3 = r.color:Lerp(Color3.new(1, 1, 1), 0.4)
		UI.pop(ticker, 1.18, 0.12)
		overlay.BackgroundColor3 = r.color:Lerp(UI.C.dark, 0.85)
		Audio.play("tick", 0.5, 0.9 + (os.clock() - start) / total * 0.6)
		local k = (os.clock() - start) / total
		interval = 0.045 + k * k * 0.32
		vp:SetAttribute("Shake", 0.4 + k * 0.8)
		task.wait(interval)
	end
	ticker.Text = ""
	tickerSub.Text = ""

	-- 3) build-up for rare pulls: climb the tiers one by one
	if item.rarity >= 3 and not quick then
		for tier = 3, item.rarity do
			local r = Cosmetics.RARITIES[tier]
			tierText.Text = string.upper(r.name) .. string.rep("!", tier - 2)
			tierText.TextColor3 = r.color
			tierText.TextTransparency = 0
			UI.pop(tierText, 1.6, 0.3)
			doFlash(r.color, 0.55 + tier * 0.04, 0.45)
			shake(8 + tier * 5, 0.4)
			overlay.BackgroundColor3 = r.color:Lerp(UI.C.dark, 0.7)
			Audio.play("win", 0.8, 0.7 + tier * 0.12)
			vp:SetAttribute("Shake", 1.2 + tier * 0.3)
			burst(r.color, 10 + tier * 4, 14)
			task.wait(if tier == item.rarity then 0.7 else 0.42)
		end
		if item.rarity >= 6 then
			-- strobe
			for i = 1, (if Store.settings.flashing then 10 else 3) do
				doFlash(if i % 2 == 0 then Color3.new(1, 1, 1) else rarity.color, 0.7, 0.08)
				Audio.play("tick", 0.8, 1.6)
				task.wait(0.08)
			end
		end
		if item.rarity == 7 then
			local t0 = os.clock()
			while os.clock() - t0 < 1.2 do
				overlay.BackgroundColor3 = Color3.fromHSV((os.clock() * 1.5) % 1, 0.6, 0.35)
				tierText.TextColor3 = Color3.fromHSV((os.clock() * 1.5 + 0.5) % 1, 0.5, 1)
				burst(Color3.fromHSV(math.random(), 0.6, 1), 3, 14)
				task.wait(0.05)
			end
		elseif item.rarity == 8 then
			local glyphs = { "█", "▓", "▒", "░", "#", "@", "%", "0", "1" }
			local t0 = os.clock()
			Audio.play("deflect", 1, 0.5)
			while os.clock() - t0 < 1.4 do
				local s = ""
				for _ = 1, 10 do
					s ..= glyphs[math.random(1, #glyphs)]
				end
				tierText.Text = s
				tierText.TextColor3 = if math.random() < 0.5 then UI.C.green else Color3.new(1, 1, 1)
				overlay.BackgroundColor3 = if math.random() < 0.5 then Color3.new(0, 0, 0) else Color3.fromRGB(0, 40, 20)
				tierText.Position = UDim2.new(0, math.random(-30, 30), 0.18, math.random(-20, 20))
				if math.random() < 0.3 then
					Audio.play("tick", 0.7, math.random() * 2 + 0.5)
				end
				task.wait(0.05)
			end
			tierText.Position = UDim2.new(0, 0, 0.18, 0)
		end
		UI.tween(tierText, 0.25, { TextTransparency = 1 })
	end

	-- 4) the crate pops
	stopView()
	UI.tween(vp, 0.15, { Size = UDim2.fromOffset(420, 420) })
	doFlash(Color3.new(1, 1, 1), 0.9, 0.6)
	shake(14 + item.rarity * 3, 0.35)
	Audio.play(if item.rarity >= 5 then "boom" else "pickup", if item.rarity >= 5 then 0.6 else 1)
	burst(rarity.color, 30 + item.rarity * 8)
	task.wait(0.12)
	vp:Destroy()
	glow:Destroy()

	-- 5) reveal card
	overlay.BackgroundColor3 = rarity.color:Lerp(UI.C.dark, 0.82)
	local holder = UI.new("Frame", { Size = UDim2.fromOffset(460, 360), Position = UDim2.fromScale(0.5, 0.46), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 16 }, stage)
	UI.rays(holder, rarity.color, 14 + item.rarity * 2, 16)
	local card = UI.panel({ Size = UDim2.fromScale(1, 1), ZIndex = 17 }, holder)
	local st = card:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = rarity.color
		st.Thickness = 4
		st.Transparency = 0
	end
	local band = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = rarity.color, ZIndex = 18 }, card)
	UI.corner(band, 16)
	local rl = UI.text({ Size = UDim2.fromScale(1, 1), Text = string.upper(rarity.name) .. "  ·  " .. Cosmetics.formatChance(item.chance), FontFace = UI.TITLE, TextSize = 26, ZIndex = 19 }, band)
	UI.textStroke(rl, 2.5, rarity.color:Lerp(Color3.new(0, 0, 0), 0.6))
	if item.rarity >= 5 then
		UI.shimmer(band, { rarity.color, Color3.new(1, 1, 1), rarity.color }, 0.8)
	end
	UI.text({ Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 54), Text = item.icon, TextSize = 84, FontFace = UI.BODY, ZIndex = 18 }, card)
	local nm = UI.text({ Size = UDim2.new(1, -20, 0, 54), Position = UDim2.fromOffset(10, 156), Text = string.upper(item.name), FontFace = UI.TITLE, TextSize = 46, TextColor3 = rarity.color:Lerp(Color3.new(1, 1, 1), 0.25), ZIndex = 18 }, card)
	UI.textStroke(nm, 3)
	if item.rarity >= 6 then
		UI.shimmer(nm, { rarity.color, Color3.new(1, 1, 1), rarity.glow, rarity.color }, 1.2)
	end
	local sub = Cosmetics.KIND_NAMES[kind] .. "  ·  " .. item.desc
	UI.text({ Size = UDim2.new(1, -30, 0, 40), Position = UDim2.fromOffset(15, 206), Text = sub, TextWrapped = true, TextSize = 17, TextColor3 = UI.C.dim, FontFace = UI.BODY, ZIndex = 18 }, card)
	local note = if res.new then "✨ NEW!" elseif (res.refund or 0) > 0 then string.format("Duplicate · +%d coins back", res.refund) else string.format("You own %d", res.count or 1)
	local nt = UI.text({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 250), Text = note, TextSize = 20, FontFace = UI.HEAVY, TextColor3 = if res.new then UI.C.gold else UI.C.text, ZIndex = 18 }, card)
	UI.textStroke(nt, 1.5)
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		UI.tween(overlay, 0.3, { BackgroundTransparency = 1 })
		UI.tween(UI.scale(holder), 0.2, { Scale = 0.6 })
		blur(false)
		task.wait(0.3)
		holder:Destroy()
		gui.Enabled = false
		busy = false
	end
	local row = UI.new("Frame", { Size = UDim2.new(1, -30, 0, 54), Position = UDim2.new(0, 15, 1, -66), BackgroundTransparency = 1, ZIndex = 18 }, card)
	UI.list(row, true, 12, Enum.HorizontalAlignment.Center)
	UI.button(row, {
		text = "EQUIP",
		size = UDim2.fromOffset(180, 50),
		color = UI.C.green,
		z = 19,
		onClick = function()
			onEquip(item.id)
			close()
		end,
	})
	UI.button(row, { text = "NICE", size = UDim2.fromOffset(180, 50), color = rarity.color, z = 19, onClick = close })
	UI.pop(holder, 0.3, 0.5)
	burst(rarity.color, 20 + item.rarity * 6)
	if item.rarity >= 5 then
		Audio.play("win", 1, 1.3)
	end
	-- safety: auto close after a while
	task.delay(25, close)
end

return CrateUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- All visual effects. A small pooled particle system moves parts in bulk every frame.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Skins = require(script.Parent:WaitForChild("Skins"))

local Effects = {}

local folder: Folder
local anchor: BasePart
local splatFolder: Folder

type Particle = {
	part: BasePart,
	shape: string,
	pos: Vector3,
	vel: Vector3,
	life: number,
	max: number,
	grav: number,
	drag: number,
	fade: number, -- start transparency
	grow: number,
	size: Vector3,
	rot: CFrame,
	spin: number,
	paint: boolean,
	color: Color3,
	axisZ: boolean,
}

local live: { Particle } = {}
local pools: { [string]: { BasePart } } = {}
local splats: { BasePart } = {}
local MAX_SPLATS = 260
local geoParams = RaycastParams.new()
geoParams.FilterType = Enum.RaycastFilterType.Include

local bulkParts: { BasePart } = {}
local bulkCFs: { CFrame } = {}

local function newPart(shape: string): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "disc" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	return p
end

local function take(shape: string): BasePart
	local pool = pools[shape]
	if pool and #pool > 0 then
		local p = table.remove(pool) :: BasePart
		return p
	end
	return newPart(shape)
end

local function give(shape: string, p: BasePart)
	p.Transparency = 1
	p.CFrame = CFrame.new(0, -5000, 0)
	pools[shape] = pools[shape] or {}
	table.insert(pools[shape], p)
end

function Effects.init()
	local f = workspace:FindFirstChild("RumbleFX")
	if f then
		f:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "RumbleFX"
	folder.Parent = workspace
	splatFolder = Instance.new("Folder")
	splatFolder.Name = "Splats"
	splatFolder.Parent = folder
	anchor = Instance.new("Part")
	anchor.Name = "Anchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.1, 0.1, 0.1)
	anchor.CFrame = CFrame.new(0, 0, 0)
	anchor.Parent = folder
end

function Effects.folder(): Folder
	return folder
end

function Effects.setGeometry(geo: Instance?)
	geoParams.FilterDescendantsInstances = if geo then { geo } else {}
end

function Effects.clearSplats()
	for _, s in splats do
		s:Destroy()
	end
	splats = {}
end

local function spawn(shape: string, pos: Vector3, vel: Vector3, life: number, size: Vector3, color: Color3, opts: any?): Particle
	local o = opts or {}
	local p = take(shape)
	p.Size = size
	p.Color = color
	p.Material = o.material or Enum.Material.Neon
	p.Transparency = o.fade or 0
	local pt: Particle = {
		part = p,
		shape = shape,
		pos = pos,
		vel = vel,
		life = life,
		max = life,
		grav = o.grav or 0,
		drag = o.drag or 0,
		fade = o.fade or 0,
		grow = o.grow or 0,
		size = size,
		rot = o.rot or CFrame.identity,
		spin = o.spin or 0,
		paint = o.paint or false,
		color = color,
		axisZ = shape == "disc",
	}
	table.insert(live, pt)
	return pt
end

local function rand(a: number, b: number): number
	return a + (b - a) * math.random()
end

local function dir2(angle: number): Vector3
	return Vector3.new(math.cos(angle), math.sin(angle), 0)
end

-------------------------------------------------------------------------------
-- effect library

function Effects.spark(pos: Vector3, color: Color3, count: number, speed: number, size: number?)
	local s = size or 0.35
	for _ = 1, count do
		local a = rand(0, math.pi * 2)
		local v = dir2(a) * rand(speed * 0.4, speed) + Vector3.new(0, 0, rand(-4, 4))
		spawn("block", pos, v, rand(0.18, 0.35), Vector3.new(s * 2.2, s * 0.5, s * 0.5), color, { grav = 60, drag = 3, rot = CFrame.Angles(0, 0, a), spin = rand(-10, 10) })
	end
end

function Effects.ring(pos: Vector3, color: Color3, size: number, life: number?)
	spawn("disc", pos + Vector3.new(0, 0, 1.5), Vector3.zero, life or 0.25, Vector3.new(0.1, size * 0.3, size * 0.3), color, { grow = 3.2, fade = 0.15 })
end

function Effects.flash(pos: Vector3, color: Color3, size: number, life: number?)
	spawn("ball", pos + Vector3.new(0, 0, 1), Vector3.zero, life or 0.12, Vector3.new(size, size, size), color, { grow = 0.8 })
end

function Effects.dust(pos: Vector3, count: number, color: Color3?)
	local c = color or Color3.fromRGB(230, 225, 215)
	for i = 1, count do
		local side = if i % 2 == 0 then 1 else -1
		spawn("ball", pos + Vector3.new(rand(-0.6, 0.6), 0.2, rand(-1.5, 1.5)), Vector3.new(side * rand(4, 10), rand(1, 4), 0), rand(0.3, 0.5), Vector3.new(0.9, 0.9, 0.9), c, { drag = 5, grow = 1.6, fade = 0.3, material = Enum.Material.SmoothPlastic })
	end
end

-- paint droplets in the victim's color that splat onto the arena
function Effects.paint(pos: Vector3, push: Vector3, color: Color3, count: number)
	for _ = 1, count do
		local v = push * rand(0.3, 0.9) + Vector3.new(rand(-12, 12), rand(-4, 16), 0)
		spawn("ball", pos, v, 1.4, Vector3.new(0.35, 0.35, 0.35), color, { grav = 120, paint = true, material = Enum.Material.SmoothPlastic })
	end
end

local function makeSplat(pos: Vector3, normal: Vector3, color: Color3)
	local up = if math.abs(normal.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis
	local cf = CFrame.fromMatrix(pos + normal * 0.04, normal, normal:Cross(up).Unit)
	local d = rand(0.7, 1.6)
	local s = Instance.new("Part")
	s.Shape = Enum.PartType.Cylinder
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CastShadow = false
	s.Material = Enum.Material.SmoothPlastic
	s.Color = color
	s.Size = Vector3.new(0.05, d, d * rand(0.8, 1.3))
	s.CFrame = cf
	s.Parent = splatFolder
	table.insert(splats, s)
	if #splats > MAX_SPLATS then
		local old = table.remove(splats, 1)
		if old then
			old:Destroy()
		end
	end
end

function Effects.tracer(from: Vector3, to: Vector3, color: Color3, width: number?)
	local d = to - from
	local len = d.Magnitude
	if len < 0.1 then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	local wd = width or 0.18
	p.Size = Vector3.new(len, wd, wd)
	p.CFrame = CFrame.new(from + d * 0.5) * CFrame.Angles(0, 0, math.atan2(d.Y, d.X))
	p.Parent = folder
	TweenService:Create(p, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { Transparency = 1, Size = Vector3.new(len, 0.02, 0.02) }):Play()
	Debris:AddItem(p, 0.15)
end

function Effects.muzzle(pos: Vector3, angle: number, color: Color3?)
	local c = color or Color3.fromRGB(255, 220, 120)
	local d = dir2(angle)
	spawn("ball", pos + d * 0.3, Vector3.zero, 0.07, Vector3.new(1.3, 1.3, 1.3), c, { grow = 0.5 })
	spawn("block", pos + d * 0.8, d * 6, 0.06, Vector3.new(1.8, 0.35, 0.35), Color3.new(1, 1, 0.85), { rot = CFrame.Angles(0, 0, angle) })
	for _ = 1, 4 do
		local a = angle + rand(-0.5, 0.5)
		spawn("block", pos, dir2(a) * rand(20, 40), rand(0.08, 0.14), Vector3.new(0.5, 0.12, 0.12), c, { rot = CFrame.Angles(0, 0, a), drag = 8 })
	end
	local lp = Instance.new("Part")
	lp.Anchored = true
	lp.CanCollide = false
	lp.CanQuery = false
	lp.Transparency = 1
	lp.Size = Vector3.new(0.2, 0.2, 0.2)
	lp.CFrame = CFrame.new(pos + Vector3.new(0, 0, 2))
	local light = Instance.new("PointLight")
	light.Color = c
	light.Range = 14
	light.Brightness = 4
	light.Parent = lp
	lp.Parent = folder
	Debris:AddItem(lp, 0.06)
end

function Effects.shell(pos: Vector3, facing: number)
	spawn("block", pos, Vector3.new(-facing * rand(6, 12), rand(10, 18), rand(-2, 2)), 0.9, Vector3.new(0.18, 0.32, 0.18), Color3.fromRGB(230, 180, 60), { grav = 140, spin = rand(-20, 20), material = Enum.Material.Metal })
end

function Effects.explosion(pos: Vector3, radius: number)
	spawn("ball", pos + Vector3.new(0, 0, 1), Vector3.zero, 0.3, Vector3.new(radius * 0.6, radius * 0.6, radius * 0.6), Color3.fromRGB(255, 245, 210), { grow = 1.3 })
	spawn("ball", pos, Vector3.zero, 0.5, Vector3.new(radius * 0.9, radius * 0.9, radius * 0.9), Color3.fromRGB(255, 140, 50), { grow = 0.7, fade = 0.2 })
	spawn("disc", pos + Vector3.new(0, 0, 1.5), Vector3.zero, 0.35, Vector3.new(0.15, radius * 0.6, radius * 0.6), Color3.fromRGB(255, 230, 160), { grow = 3.5, fade = 0.1 })
	for _ = 1, 14 do
		local a = rand(0, math.pi * 2)
		spawn("ball", pos + dir2(a) * rand(0.5, radius * 0.4), dir2(a) * rand(4, 12) + Vector3.new(0, 6, 0), rand(0.8, 1.4), Vector3.new(2.4, 2.4, 2.4), Color3.fromRGB(70, 65, 70), { drag = 2.5, grow = 1.6, fade = 0.25, material = Enum.Material.SmoothPlastic })
	end
	Effects.spark(pos, Color3.fromRGB(255, 190, 80), 22, 70, 0.5)
	local lp = Instance.new("Part")
	lp.Anchored = true
	lp.CanCollide = false
	lp.CanQuery = false
	lp.Transparency = 1
	lp.Size = Vector3.new(0.2, 0.2, 0.2)
	lp.CFrame = CFrame.new(pos + Vector3.new(0, 0, 4))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 80)
	light.Range = radius * 4
	light.Brightness = 8
	light.Parent = lp
	lp.Parent = folder
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(lp, 0.55)
end

function Effects.beam(x: number, top: number, color: Color3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.5
	p.Size = Vector3.new(1.4, 120, 1.4)
	p.CFrame = CFrame.new(x, top - 50, -1)
	p.Parent = folder
	TweenService:Create(p, TweenInfo.new(1.1, Enum.EasingStyle.Quad), { Transparency = 1, Size = Vector3.new(0.1, 120, 0.1) }):Play()
	Debris:AddItem(p, 1.2)
end

function Effects.confetti(center: Vector3, width: number)
	for _ = 1, 90 do
		local c = Color3.fromHSV(math.random(), 0.75, 1)
		spawn("block", center + Vector3.new(rand(-width, width) * 0.5, rand(0, 10), rand(-3, 3)), Vector3.new(rand(-6, 6), rand(-12, 4), 0), rand(2.5, 4), Vector3.new(0.6, 0.35, 0.05), c, { grav = 12, drag = 1.5, spin = rand(-8, 8), rot = CFrame.Angles(rand(0, 6), rand(0, 6), rand(0, 6)), material = Enum.Material.SmoothPlastic })
	end
end

-- floating text (damage numbers, KO!, BLOCK, PARRY)
function Effects.text(pos: Vector3, text: string, color: Color3, size: number?, life: number?)
	local gui = Instance.new("BillboardGui")
	gui.Adornee = anchor
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromOffset(200, 60)
	gui.StudsOffsetWorldSpace = pos + Vector3.new(0, 0, 2)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.LuckiestGuy
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size or 26
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(20, 18, 30)
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.4
	scale.Parent = label
	gui.Parent = folder
	local l = life or 0.8
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(gui, TweenInfo.new(l, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = pos + Vector3.new(rand(-1, 1), 3, 2) }):Play()
	task.delay(l * 0.6, function()
		TweenService:Create(label, TweenInfo.new(l * 0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, TweenInfo.new(l * 0.4), { Transparency = 1 }):Play()
	end)
	Debris:AddItem(gui, l + 0.05)
end

-- crescent slash arc (Blender mesh) for melee swings
function Effects.slash(pos: Vector3, angle: number, color: Color3, facing: number, scale: number?)
	local sc = scale or 1.3
	local cf = CFrame.new(pos + Vector3.new(0, 0, 1.2)) * CFrame.Angles(0, 0, angle) * (if facing < 0 then CFrame.Angles(math.pi, 0, 0) else CFrame.identity)
	local m = Skins.clone("fx_slash", cf, sc)
	if m then
		for _, p in m:GetChildren() do
			if p:IsA("BasePart") then
				p.Anchored = true
				p.Color = color:Lerp(Color3.new(1, 1, 1), 0.35)
				p.Transparency = 0.1
				TweenService:Create(p, TweenInfo.new(0.22, Enum.EasingStyle.Quad), { Transparency = 1, Size = p.Size * 1.35 }):Play()
			end
		end
		m.Parent = folder
		Debris:AddItem(m, 0.25)
	else
		for i = -1, 1 do
			local a = angle + i * 0.5
			Effects.tracer(pos + dir2(a) * 1.2, pos + dir2(a + 0.4 * facing) * 3, color, 0.3)
		end
	end
end

-- little spinning stars (Blender mesh) for big hits
function Effects.stars(pos: Vector3, color: Color3, n: number)
	for _ = 1, n do
		local a = rand(0, math.pi * 2)
		local m = Skins.clone("fx_star", CFrame.new(pos) * CFrame.Angles(0, 0, a), rand(0.25, 0.45))
		if not m then
			Effects.spark(pos, color, 2, 30)
			continue
		end
		local v = dir2(a) * rand(14, 26)
		m.Parent = folder
		local parts = {}
		for _, p in m:GetChildren() do
			if p:IsA("BasePart") then
				p.Anchored = true
				p.Color = color
				table.insert(parts, p)
			end
		end
		task.spawn(function()
			local t0 = os.clock()
			local pos0 = pos
			while os.clock() - t0 < 0.55 and m.Parent do
				local t = os.clock() - t0
				local cf = CFrame.new(pos0 + v * t - Vector3.new(0, 30 * t * t, 0)) * CFrame.Angles(0, 0, a + t * 9)
				m:PivotTo(cf)
				for _, p in parts do
					p.Transparency = math.clamp((t - 0.25) / 0.3, 0, 1)
				end
				task.wait()
			end
			m:Destroy()
		end)
	end
end

-- slash trail on melee weapons (attachments created by the server)
function Effects.decorateWeapon(weapon: Model, color: Color3)
	local handle = weapon:FindFirstChild("Handle")
	if not handle then
		return
	end
	local tip = handle:FindFirstChild("Tip") :: Attachment?
	local base = handle:FindFirstChild("Base") :: Attachment?
	if not tip or not base or handle:FindFirstChild("SlashTrail") then
		return
	end
	local trail = Instance.new("Trail")
	trail.Name = "SlashTrail"
	trail.Attachment0 = base
	trail.Attachment1 = tip
	trail.Lifetime = 0.16
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = handle
end

-------------------------------------------------------------------------------

function Effects.update(dt: number)
	table.clear(bulkParts)
	table.clear(bulkCFs)
	for i = #live, 1, -1 do
		local p = live[i]
		p.life -= dt
		if p.life <= 0 then
			give(p.shape, p.part)
			table.remove(live, i)
			continue
		end
		local old = p.pos
		p.vel -= Vector3.new(0, p.grav * dt, 0)
		if p.drag > 0 then
			p.vel *= math.max(0, 1 - p.drag * dt)
		end
		p.pos += p.vel * dt
		if p.paint then
			local hit = workspace:Raycast(old, p.pos - old, geoParams)
			if hit then
				makeSplat(hit.Position, hit.Normal, p.color)
				give(p.shape, p.part)
				table.remove(live, i)
				continue
			end
		end
		local k = 1 - p.life / p.max
		if p.grow > 0 then
			p.part.Size = p.size * (1 + p.grow * k)
		end
		p.part.Transparency = p.fade + (1 - p.fade) * (k * k)
		if p.spin ~= 0 then
			p.rot *= CFrame.Angles(0, 0, p.spin * dt)
		end
		local cf = CFrame.new(p.pos) * p.rot
		if p.axisZ then
			cf = CFrame.new(p.pos) * CFrame.Angles(0, math.pi / 2, 0)
		end
		table.insert(bulkParts, p.part)
		table.insert(bulkCFs, cf)
	end
	if #bulkParts > 0 then
		workspace:BulkMoveTo(bulkParts, bulkCFs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- In-match HUD: fighter bar, banners, countdown, kill feed, crosshair, vignettes,
-- KO panel, results podium, controls help and touch controls.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local UI = require(script.Parent:WaitForChild("UIKit"))
local Input = require(script.Parent:WaitForChild("Input"))
local Store = require(script.Parent:WaitForChild("Store"))

local Hud = {}

local gui: ScreenGui
local bar: Frame
local cards: { [number]: any } = {}
local bannerHolder: Frame
local countLabel: TextLabel
local feed: Frame
local cross: Frame
local crossTicks: { Frame } = {}
local crossKick = 0
local vignette: { Frame } = {}
local sdFrame: Frame
local koPanel: Frame
local koText: TextLabel
local koSub: TextLabel
local help: Frame
local results: Frame
local spectate: TextLabel
local weaponCard: Frame
local weaponName: TextLabel
local ammoBar: Frame
local ammoText: TextLabel
local touch: Frame? = nil
local lowHp, hurtFlash = 0, 0
local sdOn = false
local bannerToken = 0

local function colorOf(ci: number?): Color3
	local c = Config.COLORS[ci or 1] or Config.COLORS[1]
	return c.main
end

function Hud.init(parent: Instance)
	gui = UI.new("ScreenGui", { Name = "RumbleHud", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 5, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, parent)

	-- vignettes
	local dirs = {
		{ UDim2.new(1, 0, 0.25, 0), UDim2.new(0, 0, 0, 0), 90 },
		{ UDim2.new(1, 0, 0.25, 0), UDim2.new(0, 0, 0.75, 0), -90 },
		{ UDim2.new(0.18, 0, 1, 0), UDim2.new(0, 0, 0, 0), 0 },
		{ UDim2.new(0.18, 0, 1, 0), UDim2.new(0.82, 0, 0, 0), 180 },
	}
	for i, d in dirs do
		local f = UI.new("Frame", { Size = d[1], Position = d[2], BackgroundColor3 = Color3.fromRGB(255, 30, 60), BorderSizePixel = 0, BackgroundTransparency = 1 }, gui)
		UI.new("UIGradient", { Rotation = d[3], Transparency = NumberSequence.new(0, 1) }, f)
		vignette[i] = f
	end
	sdFrame = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 40, 120), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)

	-- fighter bar
	bar = UI.new("Frame", { Size = UDim2.new(1, -40, 0, 86), Position = UDim2.new(0.5, 0, 1, -14), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1 }, gui)
	UI.list(bar, true, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)

	-- weapon card (mine)
	weaponCard = UI.panel({ Size = UDim2.fromOffset(250, 66), Position = UDim2.new(0, 16, 1, -112), AnchorPoint = Vector2.new(0, 1) }, gui)
	weaponName = UI.text({ Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(12, 4), FontFace = UI.TITLE, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Left, Text = "FISTS", ZIndex = 2 }, weaponCard)
	UI.textStroke(weaponName, 2)
	local ammoTrack = UI.new("Frame", { Size = UDim2.new(1, -24, 0, 10), Position = UDim2.fromOffset(12, 40), BackgroundColor3 = UI.C.bg2, ZIndex = 2 }, weaponCard)
	UI.round(ammoTrack)
	ammoBar = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.C.gold, ZIndex = 3 }, ammoTrack)
	UI.round(ammoBar)
	ammoText = UI.text({ Size = UDim2.new(0, 120, 0, 20), Position = UDim2.new(1, -132, 0, 10), FontFace = UI.HEAVY, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UI.C.gold, Text = "", ZIndex = 2 }, weaponCard)
	UI.textStroke(ammoText, 1.5)

	-- banners + countdown
	bannerHolder = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 160), Position = UDim2.new(0, 0, 0.28, 0), BackgroundTransparency = 1, ZIndex = 8 }, gui)
	countLabel = UI.text({ Size = UDim2.new(1, 0, 0, 220), Position = UDim2.new(0, 0, 0.5, -110), FontFace = UI.TITLE, TextSize = 190, TextColor3 = UI.C.gold, Text = "", TextTransparency = 1, ZIndex = 9 }, gui)
	UI.textStroke(countLabel, 9)

	-- kill feed
	feed = UI.new("Frame", { Size = UDim2.new(0, 380, 0, 260), Position = UDim2.new(1, -16, 0, 150), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1 }, gui)
	UI.list(feed, false, 5, Enum.HorizontalAlignment.Right)

	-- crosshair
	cross = UI.new("Frame", { Size = UDim2.fromOffset(44, 44), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false, ZIndex = 20 }, gui)
	local dot = UI.new("Frame", { Size = UDim2.fromOffset(6, 6), Position = UDim2.new(0.5, -3, 0.5, -3), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 21 }, cross)
	UI.round(dot)
	UI.stroke(dot, 1.5, UI.C.dark)
	for i = 1, 4 do
		local t = UI.new("Frame", { Size = if i % 2 == 0 then UDim2.fromOffset(12, 4) else UDim2.fromOffset(4, 12), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 21 }, cross)
		UI.corner(t, 2)
		UI.stroke(t, 1.5, UI.C.dark)
		crossTicks[i] = t
	end

	-- KO panel
	koPanel = UI.panel({ Size = UDim2.fromOffset(440, 96), Position = UDim2.new(0.5, 0, 0.72, 0), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 10 }, gui)
	koText = UI.text({ Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 10), FontFace = UI.TITLE, TextSize = 38, TextColor3 = UI.C.red, Text = "", ZIndex = 11 }, koPanel)
	UI.textStroke(koText, 3)
	koSub = UI.text({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 58), FontFace = UI.BOLD, TextSize = 17, TextColor3 = UI.C.dim, Text = "", ZIndex = 11, RichText = true }, koPanel)

	spectate = UI.text({ Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -140), FontFace = UI.TITLE, TextSize = 24, Text = "", ZIndex = 6 }, gui)
	UI.textStroke(spectate, 2)

	-- help
	help = UI.panel({ Size = UDim2.fromOffset(330, 236), Position = UDim2.new(1, -16, 1, -112), AnchorPoint = Vector2.new(1, 1) }, gui)
	UI.text({
		Size = UDim2.new(1, -24, 1, -16),
		Position = UDim2.fromOffset(12, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		TextSize = 16,
		FontFace = UI.BOLD,
		ZIndex = 2,
		Text = "<font color='#ffd36e'><b>CONTROLS</b></font>   (H to hide)\n"
			.. "<font color='#5bc0ff'>A / D</font>   move\n"
			.. "<font color='#5bc0ff'>W / Space</font>   jump · again in air = flip\n"
			.. "<font color='#5bc0ff'>S</font>   crouch · fast fall\n"
			.. "<font color='#5bc0ff'>Left click</font>   punch / shoot / swing\n"
			.. "<font color='#5bc0ff'>Right click / Shift</font>   block (tap = parry)\n"
			.. "<font color='#5bc0ff'>F / Q</font>   throw your weapon\n"
			.. "<font color='#5bc0ff'>E</font>   use stations in the lobby\n"
			.. "Walk over weapons to grab them!",
	}, help)

	-- results
	results = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.C.dark, BackgroundTransparency = 0.25, Visible = false, ZIndex = 30 }, gui)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		Hud.buildTouch()
		help.Visible = false
	end
end

function Hud.toggleHelp()
	help.Visible = not help.Visible
end

-------------------------------------------------------------------------------
-- touch controls

function Hud.buildTouch()
	local t = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui)
	touch = t
	local function button(text: string, pos: UDim2, size: number, color: Color3, onDown: () -> (), onUp: () -> ())
		local b = UI.new("TextButton", { Size = UDim2.fromOffset(size, size), Position = pos, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color, BackgroundTransparency = 0.2, Text = "", AutoButtonColor = false }, t)
		UI.round(b)
		UI.stroke(b, 3, Color3.new(1, 1, 1), 0.4)
		local l = UI.text({ Size = UDim2.fromScale(1, 1), Text = text, FontFace = UI.TITLE, TextSize = math.floor(size * 0.27) }, b)
		UI.textStroke(l, 2)
		b.InputBegan:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				b.BackgroundTransparency = 0
				UI.scale(b).Scale = 0.9
				onDown()
			end
		end)
		b.InputEnded:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				b.BackgroundTransparency = 0.2
				UI.scale(b).Scale = 1
				onUp()
			end
		end)
	end
	local dark = Color3.fromRGB(40, 36, 64)
	button("◀", UDim2.new(0, 80, 1, -150), 92, dark, function()
		Input.touchMove = -1
	end, function()
		if Input.touchMove < 0 then
			Input.touchMove = 0
		end
	end)
	button("▶", UDim2.new(0, 190, 1, -150), 92, dark, function()
		Input.touchMove = 1
	end, function()
		if Input.touchMove > 0 then
			Input.touchMove = 0
		end
	end)
	button("▼", UDim2.new(0, 135, 1, -64), 62, dark, function()
		Input.touchDown = true
	end, function()
		Input.touchDown = false
	end)
	button("JUMP", UDim2.new(1, -90, 1, -150), 104, UI.C.cyan, function()
		Input.touchPress("jump", true)
	end, function()
		Input.touchPress("jump", false)
	end)
	button("HIT", UDim2.new(1, -205, 1, -200), 100, UI.C.red, function()
		Input.touchPress("attack", true)
	end, function()
		Input.touchPress("attack", false)
	end)
	button("BLOCK", UDim2.new(1, -210, 1, -88), 76, UI.C.green, function()
		Input.touchPress("block", true)
	end, function()
		Input.touchPress("block", false)
	end)
	button("THROW", UDim2.new(1, -90, 1, -262), 76, Color3.fromRGB(255, 143, 60), function()
		Input.touchPress("throw", true)
	end, function()
		Input.touchPress("throw", false)
	end)
end

-------------------------------------------------------------------------------
-- fighter bar

local function makeCard(s: any): any
	local col = colorOf(s.color)
	local me = s.fid == Store.myFid
	local w = if me then 200 else 168
	local card = UI.panel({ Size = UDim2.fromOffset(w, if me then 80 else 70), LayoutOrder = if me then -1 else s.fid }, bar)
	local st = card:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = if me then UI.C.gold else col
		st.Thickness = if me then 3 else 2
		st.Transparency = 0
	end
	local face = UI.new("ImageLabel", { Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = col, ZIndex = 2 }, card)
	UI.round(face)
	UI.stroke(face, 2.5, col)
	if s.userId and s.userId > 0 then
		UI.thumb(s.userId, face)
	else
		UI.text({ Size = UDim2.fromScale(1, 1), Text = string.upper(string.sub(s.name, 1, 1)), FontFace = UI.TITLE, TextSize = 26, ZIndex = 3 }, face)
	end
	local nm = UI.text({ Size = UDim2.new(1, -66, 0, 20), Position = UDim2.fromOffset(60, 6), Text = if me then "YOU" else s.name, FontFace = UI.HEAVY, TextSize = 16, TextColor3 = col:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2 }, card)
	UI.textStroke(nm, 1.5)
	local track = UI.new("Frame", { Size = UDim2.new(1, -68, 0, 12), Position = UDim2.fromOffset(60, 30), BackgroundColor3 = UI.C.dark, ZIndex = 2 }, card)
	UI.round(track)
	local trail = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 3 }, track)
	UI.round(trail)
	local hp = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = col, ZIndex = 4 }, track)
	UI.round(hp)
	UI.gradient(hp, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 210), 90)
	local pips = UI.new("Frame", { Size = UDim2.new(1, -68, 0, 12), Position = UDim2.fromOffset(60, 48), BackgroundTransparency = 1, ZIndex = 2 }, card)
	UI.list(pips, true, 3)
	local pipList = {}
	for k = 1, Config.WINS_TO_MATCH do
		local p = UI.new("Frame", { Size = UDim2.fromOffset(16, 9), BackgroundColor3 = UI.C.bg2, ZIndex = 3, LayoutOrder = k }, pips)
		UI.corner(p, 3)
		pipList[k] = p
	end
	local ko = UI.text({ Size = UDim2.fromScale(1, 1), Text = "KO", FontFace = UI.TITLE, TextSize = 44, TextColor3 = UI.C.red, Rotation = -12, Visible = false, ZIndex = 8 }, card)
	UI.textStroke(ko, 3)
	return { card = card, hp = hp, trail = trail, pips = pipList, ko = ko, color = col, shownHp = 1, trailHp = 1, wins = -1, dead = false }
end

function Hud.setRoster(scores: { any })
	for fid, c in cards do
		c.card:Destroy()
		cards[fid] = nil
	end
	for _, s in scores do
		if s.inMatch then
			cards[s.fid] = makeCard(s)
		end
	end
	Hud.setScores(scores)
end

function Hud.setScores(scores: { any })
	for _, s in scores do
		local c = cards[s.fid]
		if c and c.wins ~= s.wins then
			for k, p in c.pips do
				local on = k <= s.wins
				p.BackgroundColor3 = if on then UI.C.gold else UI.C.bg2
				if on and k > math.max(c.wins, 0) and c.wins >= 0 then
					UI.pop(p, 2.2, 0.4)
				end
			end
			c.wins = s.wins
		end
	end
end

-------------------------------------------------------------------------------
-- banners / countdown / feed

function Hud.banner(text: string, sub: string?, color: Color3?, duration: number?)
	bannerToken += 1
	local token = bannerToken
	for _, c in bannerHolder:GetChildren() do
		c:Destroy()
	end
	local col = color or UI.C.pink
	local stripe = UI.new("Frame", { Size = UDim2.new(1.4, 0, 0, 110), Position = UDim2.new(-1.4, 0, 0, 10), BackgroundColor3 = col, BackgroundTransparency = 0.15, Rotation = -3, ZIndex = 8 }, bannerHolder)
	UI.gradient(stripe, col, col:Lerp(Color3.new(0, 0, 0), 0.5), 0)
	local t = UI.text({ Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 12), Text = text, FontFace = UI.TITLE, TextSize = 88, ZIndex = 9 }, bannerHolder)
	UI.textStroke(t, 6, col:Lerp(Color3.new(0, 0, 0), 0.65))
	local s = UI.text({ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 120), Text = sub or "", FontFace = UI.HEAVY, TextSize = 26, ZIndex = 9 }, bannerHolder)
	UI.textStroke(s, 2.5)
	UI.tween(stripe, 0.35, { Position = UDim2.new(-0.2, 0, 0, 10) }, Enum.EasingStyle.Quint)
	UI.pop(t, 0.4, 0.4)
	task.delay(duration or 2, function()
		if token ~= bannerToken then
			return
		end
		UI.tween(stripe, 0.3, { Position = UDim2.new(1.2, 0, 0, 10) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		UI.tween(t, 0.3, { TextTransparency = 1 })
		UI.tween(s, 0.3, { TextTransparency = 1 })
	end)
end

function Hud.count(text: string, color: Color3?)
	countLabel.Text = text
	countLabel.TextColor3 = color or UI.C.gold
	countLabel.TextTransparency = 0
	countLabel.Rotation = math.random(-6, 6)
	UI.pop(countLabel, 2.2, 0.3)
	UI.tween(countLabel, 0.3, { TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0.6)
end

local CAUSE_ICON = {
	punch = "👊", melee = "🗡️", bullet = "🔫", explosion = "💥", fell = "🕳️", saw = "🪚", spikes = "📌", thrown = "🎯", deflected = "↩️", admin = "🛠️",
}

function Hud.feed(killer: string?, killerColor: Color3?, victim: string, victimColor: Color3, cause: string)
	local row = UI.panel({ Size = UDim2.new(0, 0, 0, 36), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = -math.floor(os.clock() * 100) }, feed)
	UI.pad(row, 0, 12)
	UI.list(row, true, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local function name(text: string, col: Color3, order: number)
		local l = UI.text({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = text, FontFace = UI.HEAVY, TextSize = 17, TextColor3 = col, LayoutOrder = order, ZIndex = 2 }, row)
		UI.textStroke(l, 1.5)
	end
	if killer then
		name(killer, killerColor or Color3.new(1, 1, 1), 1)
	end
	UI.text({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = CAUSE_ICON[cause] or "💀", TextSize = 18, LayoutOrder = 2, ZIndex = 2 }, row)
	name(victim, victimColor, 3)
	UI.pop(row, 0.6)
	local n = 0
	for _, c in feed:GetChildren() do
		if c:IsA("Frame") then
			n += 1
		end
	end
	task.delay(5, function()
		if row.Parent then
			UI.tween(row, 0.35, { BackgroundTransparency = 1 })
			for _, d in row:GetDescendants() do
				if d:IsA("TextLabel") then
					UI.tween(d, 0.35, { TextTransparency = 1 })
				elseif d:IsA("UIStroke") then
					UI.tween(d, 0.35, { Transparency = 1 })
				end
			end
			task.wait(0.4)
			row:Destroy()
		end
	end)
	local _ = n
end

function Hud.ko(killer: string?, killerColor: Color3?, finisher: string?)
	koPanel.Visible = true
	koText.Text = if killer then "KO'D BY " .. string.upper(killer) else "KNOCKED OUT"
	koText.TextColor3 = killerColor or UI.C.red
	koSub.Text = if finisher then "finished with <b>" .. finisher .. "</b> · spectating..." else "spectating until the next round..."
	UI.pop(koPanel, 0.6)
	task.delay(3.5, function()
		koPanel.Visible = false
	end)
end

function Hud.hurt(amount: number)
	hurtFlash = math.min(0.6, hurtFlash + amount / 60)
end

function Hud.kick(amount: number)
	crossKick = math.min(1, crossKick + amount)
end

function Hud.suddenDeath(on: boolean)
	sdOn = on
	if not on then
		sdFrame.BackgroundTransparency = 1
	end
end

function Hud.spectate(text: string)
	spectate.Text = text
end

-------------------------------------------------------------------------------
-- results podium

function Hud.results(placements: { any }, myCoins: number)
	results:ClearAllChildren()
	results.Visible = true
	results.BackgroundTransparency = 1
	UI.tween(results, 0.4, { BackgroundTransparency = 0.2 })
	local title = UI.text({ Size = UDim2.new(1, 0, 0, 90), Position = UDim2.new(0, 0, 0.08, 0), Text = "MATCH RESULTS", FontFace = UI.TITLE, TextSize = 76, TextColor3 = UI.C.gold, ZIndex = 31 }, results)
	UI.textStroke(title, 5)
	UI.pop(title, 0.5)
	local heights = { 220, 160, 120 }
	local xs = { 0.5, 0.32, 0.68 }
	for i = 1, math.min(3, #placements) do
		local p = placements[i]
		local col = colorOf(p.color)
		local holder = UI.new("Frame", { Size = UDim2.fromOffset(200, heights[i] + 190), Position = UDim2.new(xs[i], 0, 0.86, 0), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, ZIndex = 31 }, results)
		local ped = UI.panel({ Size = UDim2.new(1, 0, 0, heights[i]), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), ZIndex = 31 }, holder)
		local st = ped:FindFirstChildOfClass("UIStroke")
		if st then
			st.Color = col
			st.Thickness = 3
		end
		local rank = UI.text({ Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 10), Text = tostring(i), FontFace = UI.TITLE, TextSize = 64, TextColor3 = if i == 1 then UI.C.gold else UI.C.text, ZIndex = 32 }, ped)
		UI.textStroke(rank, 4)
		UI.text({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 80), Text = string.format("🏆 %d   💥 %d", p.wins, p.kills), FontFace = UI.HEAVY, TextSize = 18, ZIndex = 32 }, ped)
		local face = UI.new("ImageLabel", { Size = UDim2.fromOffset(120, 120), Position = UDim2.new(0.5, 0, 0, 10), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = col, ZIndex = 32 }, holder)
		UI.round(face)
		UI.stroke(face, 5, if i == 1 then UI.C.gold else col)
		if p.userId > 0 then
			UI.thumb(p.userId, face)
		else
			UI.text({ Size = UDim2.fromScale(1, 1), Text = string.upper(string.sub(p.name, 1, 1)), FontFace = UI.TITLE, TextSize = 60, ZIndex = 33 }, face)
		end
		local nm = UI.text({ Size = UDim2.new(1, 40, 0, 34), Position = UDim2.new(0.5, 0, 0, 134), AnchorPoint = Vector2.new(0.5, 0), Text = if p.fid == Store.myFid then "YOU" else p.name, FontFace = UI.TITLE, TextSize = 30, TextColor3 = col:Lerp(Color3.new(1, 1, 1), 0.2), ZIndex = 32 }, holder)
		UI.textStroke(nm, 3)
		if i == 1 then
			UI.rays(face, UI.C.gold, 12, 31)
			local crown = UI.text({ Size = UDim2.fromOffset(80, 60), Position = UDim2.new(0.5, 0, 0, -48), AnchorPoint = Vector2.new(0.5, 0), Text = "👑", TextSize = 52, ZIndex = 34 }, holder)
			UI.pop(crown, 0.2, 0.6)
		end
		holder.Position = UDim2.new(xs[i], 0, 1.6, 0)
		UI.tween(holder, 0.6, { Position = UDim2.new(xs[i], 0, 0.86, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0.25 * (4 - i))
	end
	if myCoins > 0 then
		local cl = UI.text({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0.92, 0), Text = "", FontFace = UI.TITLE, TextSize = 32, TextColor3 = UI.C.gold, ZIndex = 31 }, results)
		UI.textStroke(cl, 3)
		UI.countTo(cl, 0, myCoins, 1.4, "+ ")
		task.delay(1.45, function()
			cl.Text = "+ " .. UI.fmt(myCoins) .. " ★ this match"
		end)
	end
end

function Hud.hideResults()
	if results.Visible then
		UI.tween(results, 0.3, { BackgroundTransparency = 1 })
		task.delay(0.3, function()
			results.Visible = false
			results:ClearAllChildren()
		end)
	end
end

-------------------------------------------------------------------------------
-- per frame

-- hpOf(fid) -> hp, alive (nil if unknown)
function Hud.update(dt: number, inMatchView: boolean, hpOf: (number) -> (number?, boolean?), me: any)
	bar.Visible = inMatchView
	weaponCard.Visible = me.inArena
	for fid, c in cards do
		local hp, alive = hpOf(fid)
		local frac = math.clamp((hp or 0) / Config.MAX_HP, 0, 1)
		c.shownHp += (frac - c.shownHp) * math.min(1, dt * 14)
		if frac < c.trailHp then
			c.trailHp = math.max(frac, c.trailHp - dt * 0.35)
		else
			c.trailHp = frac
		end
		c.hp.Size = UDim2.fromScale(c.shownHp, 1)
		c.trail.Size = UDim2.fromScale(c.trailHp, 1)
		c.hp.BackgroundColor3 = if frac > 0.5 then c.color elseif frac > 0.25 then Color3.fromRGB(255, 190, 60) else Color3.fromRGB(255, 70, 70)
		local dead = alive == false
		if dead ~= c.dead then
			c.dead = dead
			c.ko.Visible = dead
			if dead then
				UI.pop(c.ko, 2.5, 0.3)
			end
			c.card.BackgroundTransparency = if dead then 0.5 else 0.06
		end
	end
	-- weapon card
	local w = Weapons.get(me.wid)
	if w then
		weaponName.Text = string.upper(w.name)
		if w.kind == "melee" then
			ammoBar.Size = UDim2.fromScale(1, 1)
			ammoText.Text = "∞"
		else
			ammoBar.Size = UDim2.fromScale(math.clamp(me.ammo / math.max(1, w.ammo), 0, 1), 1)
			ammoText.Text = if me.ammo > 0 then tostring(me.ammo) .. " / " .. tostring(w.ammo) else "EMPTY"
		end
	else
		weaponName.Text = "FISTS"
		ammoBar.Size = UDim2.fromScale(0, 1)
		ammoText.Text = "grab a weapon!"
	end
	-- crosshair
	cross.Visible = me.crosshair
	UserInputService.MouseIconEnabled = not me.crosshair
	if me.crosshair then
		local m = UserInputService:GetMouseLocation()
		cross.Position = UDim2.fromOffset(m.X, m.Y)
		crossKick = math.max(0, crossKick - dt * 5)
		local gap = 9 + crossKick * 14
		local offs = { Vector2.new(0, -gap), Vector2.new(gap, 0), Vector2.new(0, gap), Vector2.new(-gap, 0) }
		for i, t in crossTicks do
			t.Position = UDim2.new(0.5, offs[i].X, 0.5, offs[i].Y)
			t.BackgroundColor3 = me.color
		end
	end
	-- vignettes
	local frac = math.clamp(me.hp / Config.MAX_HP, 0, 1)
	local target = if me.alive and me.inArena and frac < 0.35 then (0.35 - frac) * 1.6 else 0
	lowHp += (target - lowHp) * math.min(1, dt * 4)
	hurtFlash = math.max(0, hurtFlash - dt * 1.5)
	local pulse = lowHp * (0.75 + 0.25 * math.sin(os.clock() * 6)) + hurtFlash
	for _, f in vignette do
		f.BackgroundTransparency = 1 - math.clamp(pulse, 0, 0.75)
	end
	if sdOn then
		sdFrame.BackgroundTransparency = 0.93 + math.sin(os.clock() * 5) * 0.04
	end
	if touch then
		touch.Visible = me.alive
	end
end

function Hud.gui(): ScreenGui
	return gui
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!strict
-- Keyboard + mouse, gamepad and touch input -> Fighter.Input

local UserInputService = game:GetService("UserInputService")

local Input = {}

local held = {
	left = false,
	right = false,
	up = false,
	down = false,
	attack = false,
	block = false,
}
local pressed = { jump = false, attack = false, throw = false }

Input.mode = "mouse" -- "mouse" | "gamepad" | "touch"
Input.touchMove = 0
Input.touchDown = false
Input.touchAttack = false
Input.touchBlock = false
local stick1 = Vector2.zero
local stick2 = Vector2.zero
local gamepadAttack = false
local gamepadBlock = false
local lastAim = Vector2.new(1, 0)

local KEYS_LEFT = { [Enum.KeyCode.A] = true, [Enum.KeyCode.Left] = true }
local KEYS_RIGHT = { [Enum.KeyCode.D] = true, [Enum.KeyCode.Right] = true }
local KEYS_JUMP = { [Enum.KeyCode.W] = true, [Enum.KeyCode.Up] = true, [Enum.KeyCode.Space] = true }
local KEYS_DOWN = { [Enum.KeyCode.S] = true, [Enum.KeyCode.Down] = true }
local KEYS_THROW = { [Enum.KeyCode.F] = true, [Enum.KeyCode.Q] = true }
local KEYS_ATTACK = { [Enum.KeyCode.J] = true, [Enum.KeyCode.Z] = true }
local KEYS_BLOCK = { [Enum.KeyCode.K] = true, [Enum.KeyCode.X] = true, [Enum.KeyCode.LeftShift] = true }

function Input.init(onToggleHelp: () -> ())
	UserInputService.InputBegan:Connect(function(io: InputObject, gpe: boolean)
		local kc = io.KeyCode
		local ut = io.UserInputType
		if ut == Enum.UserInputType.Keyboard then
			if gpe then
				return
			end
			Input.mode = "mouse"
			if KEYS_LEFT[kc] then
				held.left = true
			elseif KEYS_RIGHT[kc] then
				held.right = true
			elseif KEYS_JUMP[kc] then
				held.up = true
				pressed.jump = true
			elseif KEYS_DOWN[kc] then
				held.down = true
			elseif KEYS_THROW[kc] then
				pressed.throw = true
			elseif KEYS_ATTACK[kc] then
				held.attack = true
				pressed.attack = true
			elseif KEYS_BLOCK[kc] then
				held.block = true
			elseif kc == Enum.KeyCode.H then
				onToggleHelp()
			end
		elseif ut == Enum.UserInputType.MouseButton1 then
			if gpe then
				return
			end
			Input.mode = "mouse"
			held.attack = true
			pressed.attack = true
		elseif ut == Enum.UserInputType.MouseButton2 then
			if gpe then
				return
			end
			held.block = true
		elseif ut == Enum.UserInputType.Gamepad1 then
			Input.mode = "gamepad"
			if kc == Enum.KeyCode.ButtonA then
				held.up = true
				pressed.jump = true
			elseif kc == Enum.KeyCode.ButtonR2 or kc == Enum.KeyCode.ButtonR1 then
				gamepadAttack = true
				pressed.attack = true
			elseif kc == Enum.KeyCode.ButtonL2 or kc == Enum.KeyCode.ButtonL1 then
				gamepadBlock = true
			elseif kc == Enum.KeyCode.ButtonX or kc == Enum.KeyCode.ButtonB then
				pressed.throw = true
			elseif kc == Enum.KeyCode.ButtonSelect then
				onToggleHelp()
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(io: InputObject)
		local kc = io.KeyCode
		local ut = io.UserInputType
		if ut == Enum.UserInputType.Keyboard then
			if KEYS_LEFT[kc] then
				held.left = false
			elseif KEYS_RIGHT[kc] then
				held.right = false
			elseif KEYS_JUMP[kc] then
				held.up = false
			elseif KEYS_DOWN[kc] then
				held.down = false
			elseif KEYS_ATTACK[kc] then
				held.attack = false
			elseif KEYS_BLOCK[kc] then
				held.block = false
			end
		elseif ut == Enum.UserInputType.MouseButton1 then
			held.attack = false
		elseif ut == Enum.UserInputType.MouseButton2 then
			held.block = false
		elseif ut == Enum.UserInputType.Gamepad1 then
			if kc == Enum.KeyCode.ButtonA then
				held.up = false
			elseif kc == Enum.KeyCode.ButtonR2 or kc == Enum.KeyCode.ButtonR1 then
				gamepadAttack = false
			elseif kc == Enum.KeyCode.ButtonL2 or kc == Enum.KeyCode.ButtonL1 then
				gamepadBlock = false
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.Gamepad1 then
			if io.KeyCode == Enum.KeyCode.Thumbstick1 then
				stick1 = Vector2.new(io.Position.X, io.Position.Y)
				Input.mode = "gamepad"
			elseif io.KeyCode == Enum.KeyCode.Thumbstick2 then
				stick2 = Vector2.new(io.Position.X, io.Position.Y)
				Input.mode = "gamepad"
			end
		elseif io.UserInputType == Enum.UserInputType.MouseMovement then
			if Input.mode == "gamepad" and io.Delta.Magnitude > 2 then
				Input.mode = "mouse"
			end
		end
	end)

	UserInputService.WindowFocusReleased:Connect(function()
		for k in held do
			held[k] = false
		end
		gamepadAttack, gamepadBlock = false, false
	end)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		Input.mode = "touch"
	end
end

-- touch buttons call these
function Input.touchPress(name: string, down: boolean)
	Input.mode = "touch"
	if name == "jump" then
		held.up = down
		if down then
			pressed.jump = true
		end
	elseif name == "attack" then
		Input.touchAttack = down
		if down then
			pressed.attack = true
		end
	elseif name == "block" then
		Input.touchBlock = down
	elseif name == "throw" then
		if down then
			pressed.throw = true
		end
	end
end

-- Fill a fighter's input. `mouseWorld` is the world point under the cursor (mouse mode),
-- `autoTarget` is the nearest enemy position (used for gamepad/touch aim assist).
function Input.apply(input: any, neckX: number, neckY: number, facing: number, mouseWorld: Vector2?, autoTarget: Vector2?)
	local move = 0
	if held.left then
		move -= 1
	end
	if held.right then
		move += 1
	end
	local down = held.down
	if Input.mode == "gamepad" then
		if math.abs(stick1.X) > 0.3 then
			move = math.sign(stick1.X)
		end
		if stick1.Y < -0.65 then
			down = true
		end
	elseif Input.mode == "touch" then
		if math.abs(Input.touchMove) > 0.25 then
			move = math.sign(Input.touchMove)
		end
		down = down or Input.touchDown
	end
	input.moveX = move
	input.crouch = down
	input.jump = held.up
	input.attack = held.attack or gamepadAttack or Input.touchAttack
	input.block = held.block or gamepadBlock or Input.touchBlock

	if pressed.jump then
		input.jumpPressed = true
	end
	if pressed.attack then
		input.attackPressed = true
	end
	if pressed.throw then
		input.throwPressed = true
	end
	pressed.jump, pressed.attack, pressed.throw = false, false, false

	-- aim
	local aim: Vector2
	if Input.mode == "mouse" and mouseWorld then
		input.aimX, input.aimY = mouseWorld.X, mouseWorld.Y
		return
	elseif Input.mode == "gamepad" and stick2.Magnitude > 0.35 then
		aim = Vector2.new(stick2.X, stick2.Y).Unit
	elseif autoTarget then
		aim = (autoTarget - Vector2.new(neckX, neckY))
		if aim.Magnitude < 0.01 then
			aim = Vector2.new(facing, 0)
		else
			aim = aim.Unit
		end
	elseif move ~= 0 then
		aim = Vector2.new(move, 0)
	else
		aim = lastAim
	end
	lastAim = aim
	input.aimX = neckX + aim.X * 10
	input.aimY = neckY + aim.Y * 10
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Menu</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby / meta UI: profile chip, phase pill, dock, ready button, crates, locker, settings.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Maps = require(Shared:WaitForChild("Maps"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local UI = require(script.Parent:WaitForChild("UIKit"))
local Store = require(script.Parent:WaitForChild("Store"))
local Skins = require(script.Parent:WaitForChild("Skins"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local CrateUI = require(script.Parent:WaitForChild("CrateUI"))

local Menu = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local coinLabel: TextLabel
local coinShown = 0
local saveChip: TextLabel
local pill: Frame
local pillTitle: TextLabel
local pillSub: TextLabel
local pillBar: Frame
local dock: Frame
local readyBtn: TextButton
local adminBtn: TextButton
local windows: { [string]: UI.Window } = {}
local lockerPages: { [string]: ScrollingFrame } = {}
local oddsLists: { [string]: Frame } = {}
local rollButtons: { [string]: TextButton } = {}
local fpsLabel: TextLabel

Menu.onPreview = function(_id: string) end
Menu.onAdmin = function() end

local function request(kind: string, args: any): any
	local ok, res = pcall(function()
		return Remotes.Request:InvokeServer(kind, args)
	end)
	if not ok then
		return { ok = false, msg = "request failed" }
	end
	return res
end
Menu.request = request

-------------------------------------------------------------------------------
-- build

local function buildChip()
	local chip = UI.panel({ Size = UDim2.fromOffset(300, 74), Position = UDim2.fromOffset(16, 62) }, gui)
	local face = UI.new("ImageLabel", { Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(9, 9), BackgroundColor3 = UI.C.bg2, ZIndex = 2 }, chip)
	UI.round(face)
	UI.stroke(face, 2, UI.C.pink)
	UI.thumb(player.UserId, face)
	local nm = UI.text({ Size = UDim2.new(1, -80, 0, 26), Position = UDim2.fromOffset(74, 8), Text = player.DisplayName, FontFace = UI.HEAVY, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2 }, chip)
	UI.textStroke(nm, 1.5)
	UI.coin(chip, 24, 2).Position = UDim2.fromOffset(74, 40)
	coinLabel = UI.text({ Size = UDim2.new(0, 140, 0, 26), Position = UDim2.fromOffset(104, 39), Text = "0", FontFace = UI.TITLE, TextSize = 24, TextColor3 = UI.C.gold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 }, chip)
	UI.textStroke(coinLabel, 2)
	saveChip = UI.text({ Size = UDim2.fromOffset(300, 18), Position = UDim2.new(0, 0, 1, 6), Text = "", FontFace = UI.BOLD, TextSize = 13, TextColor3 = UI.C.dim, TextXAlignment = Enum.TextXAlignment.Left }, chip)
	fpsLabel = UI.text({ Size = UDim2.fromOffset(120, 18), Position = UDim2.new(0, 0, 1, 24), Text = "", FontFace = UI.BOLD, TextSize = 13, TextColor3 = UI.C.green, TextXAlignment = Enum.TextXAlignment.Left, Visible = false }, chip)
end

local function buildPill()
	pill = UI.panel({ Size = UDim2.fromOffset(380, 70), Position = UDim2.new(0.5, 0, 0, 58), AnchorPoint = Vector2.new(0.5, 0) }, gui)
	pillTitle = UI.text({ Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 6), FontFace = UI.TITLE, TextSize = 30, Text = "THE ARCADE", ZIndex = 2 }, pill)
	UI.textStroke(pillTitle, 2.5)
	pillSub = UI.text({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 40), FontFace = UI.BOLD, TextSize = 15, TextColor3 = UI.C.dim, Text = "", ZIndex = 2 }, pill)
	local track = UI.new("Frame", { Size = UDim2.new(1, -24, 0, 5), Position = UDim2.new(0, 12, 1, -9), BackgroundColor3 = UI.C.bg2, ZIndex = 2 }, pill)
	UI.round(track)
	pillBar = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UI.C.pink, ZIndex = 3 }, track)
	UI.round(pillBar)
	UI.gradient(pillBar, UI.C.pink, UI.C.cyan, 0)
end

local function openOnly(name: string)
	for n, w in windows do
		if n ~= name and w.frame.Visible then
			w.close()
		end
	end
	local w = windows[name]
	if w then
		if w.frame.Visible then
			w.close()
		else
			UI.open(w)
			Store.emit("panelOpened", name)
		end
	end
end
Menu.open = openOnly

local function buildDock()
	dock = UI.new("Frame", { Size = UDim2.fromOffset(170, 330), Position = UDim2.new(1, -16, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1 }, gui)
	UI.list(dock, false, 12, Enum.HorizontalAlignment.Right)
	UI.button(dock, { text = "CRATES", icon = "🎲", size = UDim2.fromOffset(170, 56), color = UI.C.pink, order = 1, onClick = function()
		openOnly("crates")
	end })
	UI.button(dock, { text = "LOCKER", icon = "🎒", size = UDim2.fromOffset(170, 56), color = UI.C.cyan, order = 2, onClick = function()
		openOnly("locker")
	end })
	UI.button(dock, { text = "SETTINGS", icon = "⚙️", size = UDim2.fromOffset(170, 56), color = Color3.fromRGB(120, 112, 170), order = 3, onClick = function()
		openOnly("settings")
	end })
	adminBtn = UI.button(dock, { text = "ADMIN", icon = "🛠️", size = UDim2.fromOffset(170, 56), color = Color3.fromRGB(255, 143, 60), order = 4, onClick = function()
		Menu.onAdmin()
	end })
	adminBtn.Visible = false
	readyBtn = UI.button(gui, {
		text = "READY UP",
		icon = "⚔️",
		size = UDim2.fromOffset(260, 66),
		position = UDim2.new(0.5, 0, 1, -28),
		anchor = Vector2.new(0.5, 1),
		color = UI.C.green,
		textSize = 30,
		onClick = function()
			Store.ready = not Store.ready
			request("ready", { on = Store.ready })
			UI.setButton(readyBtn, if Store.ready then "✓  READY!" else "⚔️  READY UP", if Store.ready then UI.C.gold else UI.C.green)
		end,
	})
end

-- crates window ---------------------------------------------------------------------
local function crateCard(parent: Instance, kind: string, order: number)
	local isFin = kind == "finisher"
	local col = if isFin then UI.C.pink else UI.C.cyan
	local card = UI.new("Frame", { Size = UDim2.new(0.5, -8, 1, 0), BackgroundColor3 = UI.C.bg2, BackgroundTransparency = 0.25, LayoutOrder = order, ZIndex = 22 }, parent)
	UI.corner(card, 14)
	UI.stroke(card, 2, col, 0.2)
	local t = UI.text({ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 8), Text = if isFin then "FINISHER CRATE" else "ENTRANCE CRATE", FontFace = UI.TITLE, TextSize = 28, TextColor3 = col, ZIndex = 23 }, card)
	UI.textStroke(t, 2)
	UI.text({ Size = UDim2.new(1, -20, 0, 18), Position = UDim2.fromOffset(10, 40), Text = if isFin then "plays when YOU knock someone out" else "plays when you spawn into a round", FontFace = UI.BODY, TextSize = 15, TextColor3 = UI.C.dim, ZIndex = 23 }, card)
	local vp = UI.new("ViewportFrame", { Size = UDim2.new(1, 0, 0, 150), Position = UDim2.fromOffset(0, 60), BackgroundTransparency = 1, Ambient = Color3.fromRGB(170, 160, 200), LightDirection = Vector3.new(-1, -1, -1), ZIndex = 23 }, card)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 2, 8.5), Vector3.zero)
	cam.Parent = vp
	vp.CurrentCamera = cam
	local function fill()
		vp:ClearAllChildren()
		cam.Parent = vp
		local m = Skins.clone(if isFin then "crate_finisher" else "crate_spawn", CFrame.new(), 1)
		if not m then
			m = Instance.new("Model")
			local b = Instance.new("Part")
			b.Size = Vector3.new(3, 3, 3)
			b.Color = if isFin then Color3.fromRGB(176, 40, 58) else Color3.fromRGB(30, 78, 140)
			b.Material = Enum.Material.WoodPlanks
			b.Parent = m
		end
		(m :: Model).Parent = vp
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			if not (m :: Model).Parent then
				conn:Disconnect()
				return
			end
			(m :: Model):PivotTo(CFrame.Angles(0.25, os.clock() * 0.8, 0))
		end)
	end
	fill()
	Store.on("skinsReady", fill)
	rollButtons[kind] = UI.button(card, {
		text = "ROLL  ·  " .. Config.CRATE_COST .. " ★",
		size = UDim2.new(1, -24, 0, 54),
		position = UDim2.new(0, 12, 0, 214),
		color = col,
		textSize = 24,
		z = 24,
		onClick = function()
			if CrateUI.busy() then
				return
			end
			local res = request("roll", { kind = kind })
			if res and res.ok then
				windows.crates.close()
				CrateUI.play(kind, res, function(id)
					local r = request("equip", { id = id })
					if r and r.ok then
						UI.toast("Equipped " .. Cosmetics.byId[id].name, UI.C.green)
					end
				end)
			else
				UI.toast(if res then res.msg or "can't roll" else "can't roll", UI.C.red)
				Audio.play("block")
			end
		end,
	})
	local odds = UI.new("ScrollingFrame", { Size = UDim2.new(1, -16, 1, -284), Position = UDim2.fromOffset(8, 278), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 23 }, card)
	UI.list(odds, false, 4)
	oddsLists[kind] = odds
end

local function refreshOdds()
	local prof = Store.profile
	for kind, list in oddsLists do
		list:ClearAllChildren()
		UI.list(list, false, 4)
		for i, it in Cosmetics.ofKind(kind) do
			if it.chance <= 0 then
				continue
			end
			local r = Cosmetics.rarity(it)
			local owned = if prof and prof.inventory then prof.inventory[it.id] or 0 else 0
			local row = UI.new("Frame", { Size = UDim2.new(1, -6, 0, 26), BackgroundColor3 = r.color, BackgroundTransparency = 0.82, LayoutOrder = i, ZIndex = 24 }, list)
			UI.corner(row, 8)
			UI.text({ Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.fromOffset(8, 0), Text = it.icon .. "  " .. (if owned > 0 or it.rarity <= 3 then it.name else "???"), FontFace = UI.BOLD, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = r.color:Lerp(Color3.new(1, 1, 1), 0.3), ZIndex = 25 }, row)
			UI.text({ Size = UDim2.new(0.4, -10, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), Text = Cosmetics.formatChance(it.chance) .. (if owned > 0 then "  ×" .. owned else ""), FontFace = UI.BOLD, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UI.C.dim, ZIndex = 25 }, row)
		end
	end
	for kind, b in rollButtons do
		local free = prof and prof.freeRolls
		UI.setButton(b, if free then "ROLL  ·  FREE" else "ROLL  ·  " .. Config.CRATE_COST .. " ★", nil)
		local _ = kind
	end
end

local function buildCrates()
	local w = UI.window(gui, "CRATES", UDim2.fromOffset(760, 560), UI.C.pink)
	windows.crates = w
	local row = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 21 }, w.body)
	UI.list(row, true, 16)
	crateCard(row, "finisher", 1)
	crateCard(row, "spawn", 2)
end

-- locker window ---------------------------------------------------------------------
local function refreshLocker()
	local prof = Store.profile
	for kind, page in lockerPages do
		for _, c in page:GetChildren() do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		local grid = page:FindFirstChildOfClass("UIListLayout")
		if grid then
			grid:Destroy()
		end
		if not page:FindFirstChildOfClass("UIGridLayout") then
			UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(150, 176), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, page)
		end
		for i, it in Cosmetics.ofKind(kind) do
			local r = Cosmetics.rarity(it)
			local owned = if prof and prof.inventory then prof.inventory[it.id] or 0 else (if it.chance == 0 then 1 else 0)
			local equipped = prof and prof.equipped and prof.equipped[kind] == it.id
			local card = UI.new("TextButton", { BackgroundColor3 = if owned > 0 then UI.C.bg2 else UI.C.dark, Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 23 }, page)
			UI.corner(card, 12)
			UI.stroke(card, if equipped then 4 else 2, if equipped then UI.C.green else r.color, if owned > 0 then 0 else 0.6)
			UI.text({ Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 8), Text = if owned > 0 then it.icon else "❔", TextSize = 46, FontFace = UI.BODY, ZIndex = 24 }, card)
			local nm = UI.text({ Size = UDim2.new(1, -10, 0, 40), Position = UDim2.fromOffset(5, 74), Text = if owned > 0 then it.name else "???", TextWrapped = true, FontFace = UI.HEAVY, TextSize = 16, TextColor3 = r.color:Lerp(Color3.new(1, 1, 1), 0.3), ZIndex = 24 }, card)
			UI.textStroke(nm, 1.5)
			UI.text({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 114), Text = r.name .. " · " .. Cosmetics.formatChance(it.chance), FontFace = UI.BOLD, TextSize = 12, TextColor3 = r.color, ZIndex = 24 }, card)
			local status = if equipped then "EQUIPPED" elseif owned > 0 then "×" .. owned else "LOCKED"
			UI.text({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 140), Text = status, FontFace = UI.TITLE, TextSize = 18, TextColor3 = if equipped then UI.C.green else UI.C.dim, ZIndex = 24 }, card)
			if it.rarity >= 5 and owned > 0 then
				UI.shimmer(nm, { r.color, Color3.new(1, 1, 1), r.color }, 0.7)
			end
			card.Activated:Connect(function()
				if owned <= 0 then
					UI.toast("Roll crates to unlock " .. Cosmetics.formatChance(it.chance) .. " items!", r.color)
					return
				end
				UI.click()
				Menu.onPreview(it.id)
				if not equipped then
					local res = request("equip", { id = it.id })
					if res and res.ok then
						UI.toast("Equipped " .. it.name, UI.C.green)
					else
						UI.toast(if res then res.msg or "can't equip" else "can't equip", UI.C.red)
					end
				end
			end)
		end
	end
end

local function buildLocker()
	local w = UI.window(gui, "LOCKER", UDim2.fromOffset(720, 540), UI.C.cyan)
	windows.locker = w
	local pages = UI.tabs(w.body, { "Finishers", "Entrances" }, UI.C.cyan)
	lockerPages.finisher = pages.Finishers
	lockerPages.spawn = pages.Entrances
	UI.text({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -18), Text = "click an item to equip it + preview it on your fighter", FontFace = UI.BODY, TextSize = 14, TextColor3 = UI.C.dim, ZIndex = 22 }, w.body)
end

-- settings ---------------------------------------------------------------------------
local function buildSettings()
	local w = UI.window(gui, "SETTINGS", UDim2.fromOffset(480, 470), Color3.fromRGB(120, 112, 170))
	windows.settings = w
	local list = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 21 }, w.body)
	UI.list(list, false, 6)
	local s = Store.settings
	UI.slider(list, "Sound volume", 0, 1.5, s.sfx, function(v)
		s.sfx = v
		Audio.volume = v
	end, function(v)
		return string.format("%d%%", math.floor(v * 100 + 0.5))
	end, 1)
	UI.toggle(list, "Screen shake", s.shake, function(v)
		s.shake = v
	end, 2)
	UI.toggle(list, "Damage numbers", s.numbers, function(v)
		s.numbers = v
	end, 3)
	UI.toggle(list, "Flashing effects (crate reveals)", s.flashing, function(v)
		s.flashing = v
	end, 4)
	UI.toggle(list, "Quick rolls for Common / Uncommon", s.quickRolls, function(v)
		s.quickRolls = v
	end, 5)
	UI.toggle(list, "Show FPS", s.fps, function(v)
		s.fps = v
		fpsLabel.Visible = v
	end, 6)
	UI.text({ Size = UDim2.new(1, 0, 0, 40), Text = "Tip: press H in a match for the controls", FontFace = UI.BODY, TextSize = 14, TextColor3 = UI.C.dim, LayoutOrder = 7, ZIndex = 22 }, list)
end

-------------------------------------------------------------------------------

function Menu.init(parent: Instance)
	gui = UI.new("ScreenGui", { Name = "RumbleMenu", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 10, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, parent)
	UI.toasts(gui)
	buildChip()
	buildPill()
	buildDock()
	buildCrates()
	buildLocker()
	buildSettings()
	Store.on("profile", function()
		refreshOdds()
		refreshLocker()
	end)
	Store.on("admin", function(isAdmin: boolean)
		adminBtn.Visible = isAdmin
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= player then
			return
		end
		local panel = prompt:GetAttribute("Panel")
		if type(panel) == "string" and windows[panel] then
			openOnly(panel)
		end
	end)
	UserInputService.InputBegan:Connect(function(io, gpe)
		if gpe then
			return
		end
		if io.KeyCode == Enum.KeyCode.Escape then
			for _, w in windows do
				if w.frame.Visible then
					w.close()
				end
			end
		end
	end)
	refreshOdds()
	refreshLocker()
end

function Menu.setProfile(p: any)
	if not p then
		return
	end
	local old = Store.profile
	Store.profile = p
	if old and old.coins ~= p.coins then
		UI.countTo(coinLabel, old.coins, p.coins, 0.6)
		UI.pop(coinLabel, 1.3, 0.3)
	else
		coinLabel.Text = UI.fmt(p.coins)
	end
	coinShown = p.coins
	saveChip.Text = if p.saving then "" else "⚠ progress isn't saving (Studio: enable API services)"
	Store.emit("profile", p)
end

function Menu.coinPopup(amount: number, reason: string)
	local t = UI.text({
		Size = UDim2.fromOffset(240, 28),
		Position = UDim2.fromOffset(104, 132),
		Text = string.format("+%d  %s", amount, reason),
		FontFace = UI.TITLE,
		TextSize = 22,
		TextColor3 = UI.C.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
	}, gui)
	UI.textStroke(t, 2)
	UI.pop(t, 0.5)
	UI.tween(t, 1.4, { Position = UDim2.fromOffset(104, 104), TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0.6)
	task.delay(2.1, function()
		t:Destroy()
	end)
	Audio.play("pickup", 0.6, 1.4)
end

local fpsAcc, fpsFrames = 0, 0

function Menu.update(dt: number, inLobby: boolean)
	local phase = workspace:GetAttribute("Phase") or "lobby"
	local t = workspace:GetServerTimeNow()
	dock.Visible = inLobby
	readyBtn.Visible = inLobby and phase == "lobby"
	if phase ~= "lobby" and Store.ready then
		Store.ready = false
		UI.setButton(readyBtn, "⚔️  READY UP", UI.C.green)
	end
	if phase == "lobby" then
		local pe = workspace:GetAttribute("PhaseEnd") or 0
		local hc = workspace:GetAttribute("HumanCount") or 0
		local rc = workspace:GetAttribute("ReadyCount") or 0
		if pe > 0 then
			local left = math.max(0, pe - t)
			pillTitle.Text = string.format("MATCH IN %d:%02d", math.floor(left / 60), math.floor(left % 60))
			pillBar.Size = UDim2.fromScale(math.clamp(1 - left / Config.INTERMISSION, 0, 1), 1)
		else
			pillTitle.Text = "THE ARCADE"
			pillBar.Size = UDim2.fromScale(0, 1)
		end
		pillSub.Text = string.format("%d/%d ready  ·  stand in the portal or hit READY", rc, hc)
	elseif phase == "match" then
		local mi = workspace:GetAttribute("MapIndex") or 0
		local map = if mi > 0 then Maps.get(mi) else nil
		pillTitle.Text = if map then "ROUND " .. tostring(workspace:GetAttribute("Round") or 1) else "MATCH"
		pillSub.Text = if map then map.name .. "  ·  first to " .. Config.WINS_TO_MATCH else ""
		local ink = workspace:GetAttribute("InkStart") or 0
		local ft = workspace:GetAttribute("FightTime") or 0
		if ink > 0 then
			pillBar.Size = UDim2.fromScale(1, 1)
			pillSub.Text = "SUDDEN DEATH · the ink is rising!"
		elseif ft > 0 and t > ft then
			pillBar.Size = UDim2.fromScale(math.clamp((t - ft) / Config.SUDDEN_DEATH_AT, 0, 1), 1)
		else
			pillBar.Size = UDim2.fromScale(0, 1)
		end
	elseif phase == "results" then
		pillTitle.Text = "RESULTS"
		local pe = workspace:GetAttribute("PhaseEnd") or 0
		pillSub.Text = string.format("back to the lobby in %d", math.max(0, math.ceil(pe - t)))
	end
	if Store.settings.fps then
		fpsAcc += dt
		fpsFrames += 1
		if fpsAcc >= 0.5 then
			fpsLabel.Text = string.format("%d FPS", math.floor(fpsFrames / fpsAcc + 0.5))
			fpsAcc, fpsFrames = 0, 0
		end
	end
	local _ = coinShown
end

function Menu.gui(): ScreenGui
	return gui
end

return Menu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Skins</string>
            <string name="Source"><![CDATA[--!strict
-- Turns the Blender mesh data (Shared/MeshData) into MeshParts at runtime with EditableMesh,
-- then "skins" any instance the server tagged with RumbleSkin. If mesh APIs are unavailable
-- the part-built fallback models simply stay visible.

local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MeshData = require(Shared:WaitForChild("MeshData")) :: any

local Skins = {}
Skins.ok = nil :: boolean?
Skins.err = nil :: string?
Skins.built = 0

type Template = { part: MeshPart, center: Vector3, size: Vector3 }
local templates: { [string]: { solid: Template?, glow: Template? } } = {}
local pending: { Instance } = {}
local ready = false

local function hexColor(h: number): Color3
	return Color3.fromRGB(bit32.rshift(h, 16) % 256, bit32.rshift(h, 8) % 256, h % 256)
end

local function buildSub(sub: any, glow: boolean): Template
	local v = sub.v
	local n = #v // 3
	local mn = Vector3.new(math.huge, math.huge, math.huge)
	local mx = -mn
	local pos = table.create(n)
	for i = 1, n do
		local p = Vector3.new(v[i * 3 - 2], v[i * 3 - 1], v[i * 3])
		pos[i] = p
		mn = mn:Min(p)
		mx = mx:Max(p)
	end
	local center = (mn + mx) * 0.5
	local size = (mx - mn):Max(Vector3.new(0.05, 0.05, 0.05))

	local em = (AssetService :: any):CreateEditableMesh()
	local colors = {}
	for i, hex in sub.pal do
		colors[i] = em:AddColor(hexColor(hex), 1)
	end
	local ids = table.create(n)
	for i = 1, n do
		ids[i] = em:AddVertex(pos[i] - center)
	end
	local t, c = sub.t, sub.c
	for k = 1, #c do
		local a, b, cc = t[k * 3 - 2], t[k * 3 - 1], t[k * 3]
		local pa, pb, pc = pos[a], pos[b], pos[cc]
		local nrm = (pb - pa):Cross(pc - pa)
		if nrm.Magnitude < 1e-9 then
			continue
		end
		local nid = em:AddNormal(nrm.Unit)
		local col = colors[c[k]]
		-- both windings, both using the outward normal: visible + correctly lit either way
		local f1 = em:AddTriangle(ids[a], ids[b], ids[cc])
		em:SetFaceNormals(f1, { nid, nid, nid })
		em:SetFaceColors(f1, { col, col, col })
		local f2 = em:AddTriangle(ids[a], ids[cc], ids[b])
		em:SetFaceNormals(f2, { nid, nid, nid })
		em:SetFaceColors(f2, { col, col, col })
	end
	local mp = (AssetService :: any):CreateMeshPartAsync((Content :: any).fromObject(em)) :: MeshPart
	mp.Size = size
	mp.Anchored = true
	mp.CanCollide = false
	mp.CanQuery = false
	mp.CanTouch = false
	mp.CastShadow = not glow
	mp.Massless = true
	mp.Color = Color3.new(1, 1, 1)
	mp.Material = if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	return { part = mp, center = center, size = size }
end

-- clone a mesh (solid + optional glow) into a Model placed at `cf` (the asset's origin)
function Skins.clone(name: string, cf: CFrame, scale: number?): Model?
	local tpl = templates[name]
	if not tpl then
		return nil
	end
	local s = scale or 1
	local m = Instance.new("Model")
	m.Name = "Skin_" .. name
	for _, key in { "solid", "glow" } do
		local sub = (tpl :: any)[key] :: Template?
		if sub then
			local p = sub.part:Clone()
			p.Size = sub.size * s
			p.CFrame = cf * CFrame.new(sub.center * s)
			p.Parent = m
			if key == "solid" then
				m.PrimaryPart = p
			end
		end
	end
	return m
end

function Skins.has(name: string): boolean
	return templates[name] ~= nil
end

-- dress one tagged anchor: weld the mesh onto it and hide the fallback siblings
local function apply(anchor: Instance)
	if not anchor:IsA("BasePart") or anchor:GetAttribute("Skinned") then
		return
	end
	local name = anchor:GetAttribute("Skin")
	if type(name) ~= "string" or not templates[name] then
		return
	end
	local scale = anchor:GetAttribute("SkinScale")
	local m = Skins.clone(name, anchor.CFrame, if type(scale) == "number" then scale else 1)
	if not m then
		return
	end
	anchor:SetAttribute("Skinned", true)
	for _, p in m:GetChildren() do
		if p:IsA("BasePart") then
			p.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = anchor
			w.Part1 = p
			w.Parent = p
		end
	end
	m.Parent = anchor
	local holder = anchor.Parent
	if holder then
		if holder:IsA("BasePart") and holder:GetAttribute("Fallback") then
			holder.Transparency = 1
		end
		for _, d in holder:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Fallback") then
				d.Transparency = 1
			end
		end
	end
end

local function onTagged(inst: Instance)
	if ready then
		task.defer(apply, inst)
	else
		table.insert(pending, inst)
	end
end

function Skins.init(onDone: ((boolean, string?) -> ())?)
	CollectionService:GetInstanceAddedSignal("RumbleSkin"):Connect(onTagged)
	for _, inst in CollectionService:GetTagged("RumbleSkin") do
		onTagged(inst)
	end
	task.spawn(function()
		local names = {}
		for name in MeshData do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in names do
			local data = MeshData[name]
			local ok, err = pcall(function()
				local entry = {}
				if data.solid then
					entry.solid = buildSub(data.solid, false)
				end
				if data.glow then
					entry.glow = buildSub(data.glow, true)
				end
				templates[name] = entry
			end)
			if not ok then
				Skins.ok = false
				Skins.err = tostring(err)
				warn("[Ragdoll Rumble] mesh models unavailable, using part models instead:", err)
				break
			end
			Skins.built += 1
			task.wait()
		end
		if Skins.ok ~= false then
			Skins.ok = true
		end
		ready = true
		for _, inst in pending do
			if inst.Parent then
				apply(inst)
			end
		end
		pending = {}
		if onDone then
			onDone(Skins.ok == true, Skins.err)
		end
	end)
end

return Skins
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!strict
-- Shared client state + a tiny event bus for the UI modules.

local Store = {}

Store.myFid = 0
Store.isAdmin = false
Store.profile = nil :: any
Store.scores = {} :: { any }
Store.phase = "lobby"
Store.mapIndex = 0
Store.ready = false
Store.settings = {
	sfx = 1,
	shake = true,
	numbers = true,
	flashing = true, -- turn off to calm down the crate flashing
	fps = false,
	quickRolls = false, -- skip the long reveal for Common / Uncommon
}

local listeners: { [string]: { (...any) -> () } } = {}

function Store.on(name: string, fn: (...any) -> ())
	listeners[name] = listeners[name] or {}
	table.insert(listeners[name], fn)
end

function Store.emit(name: string, ...: any)
	for _, fn in listeners[name] or {} do
		task.spawn(fn, ...)
	end
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Tags</string>
            <string name="Source"><![CDATA[--!strict
-- Per-fighter overlays: colored outline, name + health tag, launch trail.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Tags = {}

type Tag = {
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	gui: BillboardGui,
	name: TextLabel,
	hpBack: Frame,
	hpFill: Frame,
	trail: Trail?,
	lastHp: number,
	show: number,
	color: Color3,
	dead: boolean,
}

local tags: { [Model]: Tag } = {}

function Tags.color(model: Model): Color3
	local ci = model:GetAttribute("ColorIndex")
	local c = Config.COLORS[if type(ci) == "number" then ci else 1] or Config.COLORS[1]
	return c.main
end

function Tags.add(model: Model, isMe: boolean)
	if tags[model] then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = model:FindFirstChild("Head") :: BasePart?
	if not humanoid or not root or not head then
		return
	end
	local color = Tags.color(model)

	local hl = Instance.new("Highlight")
	hl.Name = "RumbleOutline"
	hl.Adornee = model
	hl.FillTransparency = 1
	hl.OutlineColor = color
	hl.OutlineTransparency = if isMe then 0 else 0.15
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Name = "RumbleTag"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(150, 46)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 22)
	name.Font = Enum.Font.FredokaOne
	name.TextSize = if isMe then 20 else 16
	name.Text = if isMe then "▼ YOU ▼" else (model:GetAttribute("FighterName") or model.Name) :: string
	name.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.2)
	name.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(15, 14, 24)
	stroke.Parent = name
	local back = Instance.new("Frame")
	back.Size = UDim2.new(0, 70, 0, 8)
	back.Position = UDim2.new(0.5, -35, 0, 26)
	back.BackgroundColor3 = Color3.fromRGB(20, 18, 30)
	back.BorderSizePixel = 0
	back.BackgroundTransparency = 1
	back.Parent = gui
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(1, 0)
	bc.Parent = back
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.BackgroundTransparency = 1
	fill.Parent = back
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1, 0)
	fc.Parent = fill
	gui.Parent = model

	-- launch trail (shows when sent flying)
	local trail: Trail? = nil
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		local a0 = Instance.new("Attachment")
		a0.Name = "TrailTop"
		a0.Position = Vector3.new(0, torso.Size.Y * 0.5, 0)
		a0.Parent = torso
		local a1 = Instance.new("Attachment")
		a1.Name = "TrailBottom"
		a1.Position = Vector3.new(0, -torso.Size.Y * 0.5, 0)
		a1.Parent = torso
		local t = Instance.new("Trail")
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.3
		t.LightEmission = 0.8
		t.FaceCamera = true
		t.Color = ColorSequence.new(color)
		t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		t.Enabled = false
		t.Parent = torso
		trail = t
	end

	tags[model] = {
		model = model,
		humanoid = humanoid,
		root = root,
		gui = gui,
		name = name,
		hpBack = back,
		hpFill = fill,
		trail = trail,
		lastHp = humanoid.Health,
		show = 0,
		color = color,
		dead = false,
	}
end

function Tags.remove(model: Model)
	tags[model] = nil
end

function Tags.update(dt: number)
	for model, tag in tags do
		if not model.Parent then
			tags[model] = nil
			continue
		end
		local hp = tag.humanoid.Health
		if hp ~= tag.lastHp then
			tag.lastHp = hp
			tag.show = 3
			local frac = math.clamp(hp / Config.MAX_HP, 0, 1)
			tag.hpFill.Size = UDim2.fromScale(frac, 1)
			tag.hpFill.BackgroundColor3 = if frac > 0.5 then tag.color elseif frac > 0.25 then Color3.fromRGB(255, 190, 60) else Color3.fromRGB(255, 70, 70)
		end
		local dead = hp <= 0
		if dead ~= tag.dead then
			tag.dead = dead
			tag.name.TextTransparency = if dead then 0.65 else 0
		end
		if tag.show > 0 and not dead then
			tag.show -= dt
			local tr = if tag.show < 0.5 then 1 - tag.show * 2 else 0
			tag.hpBack.BackgroundTransparency = 0.25 + tr * 0.75
			tag.hpFill.BackgroundTransparency = tr
		else
			tag.hpBack.BackgroundTransparency = 1
			tag.hpFill.BackgroundTransparency = 1
		end
		if tag.trail then
			local speed = tag.root.AssemblyLinearVelocity.Magnitude
			tag.trail.Enabled = speed > 55
		end
	end
end

return Tags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny UI kit: one consistent look (dark glass + neon accents) and animated components.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local UI = {}

UI.C = {
	bg = Color3.fromRGB(17, 15, 31),
	bg2 = Color3.fromRGB(30, 25, 54),
	line = Color3.fromRGB(92, 80, 150),
	text = Color3.fromRGB(241, 238, 255),
	dim = Color3.fromRGB(160, 152, 200),
	pink = Color3.fromRGB(255, 93, 207),
	cyan = Color3.fromRGB(91, 192, 255),
	gold = Color3.fromRGB(255, 211, 110),
	green = Color3.fromRGB(110, 230, 130),
	red = Color3.fromRGB(255, 77, 94),
	dark = Color3.fromRGB(10, 9, 18),
}

UI.TITLE = Font.fromEnum(Enum.Font.LuckiestGuy)
UI.ROUND = Font.fromEnum(Enum.Font.FredokaOne)
UI.BOLD = Font.fromName("BuilderSans", Enum.FontWeight.Bold)
UI.HEAVY = Font.fromName("BuilderSans", Enum.FontWeight.Heavy)
UI.BODY = Font.fromName("BuilderSans", Enum.FontWeight.Medium)

UI.click = function() end -- set by the main script (plays a sound)
UI.hover = function() end

function UI.new(className: string, props: { [string]: any }?, parent: Instance?): any
	local i = Instance.new(className)
	if props then
		for k, v in props do
			(i :: any)[k] = v
		end
	end
	if parent then
		i.Parent = parent
	end
	return i
end

function UI.corner(parent: Instance, r: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 12) }, parent)
end

function UI.round(parent: Instance): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(1, 0) }, parent)
end

function UI.stroke(parent: Instance, thickness: number?, color: Color3?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Thickness = thickness or 2,
		Color = color or UI.C.line,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function UI.textStroke(parent: Instance, thickness: number?, color: Color3?): UIStroke
	return UI.new("UIStroke", {
		Thickness = thickness or 2,
		Color = color or UI.C.dark,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}, parent)
end

function UI.pad(parent: Instance, all: number, x: number?)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, x or all),
		PaddingRight = UDim.new(0, x or all),
	}, parent)
end

function UI.list(parent: Instance, horizontal: boolean, padding: number, align: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, parent)
end

function UI.gradient(parent: Instance, a: Color3, b: Color3, rotation: number?): UIGradient
	return UI.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 90 }, parent)
end

function UI.tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?, delay: number?): Tween
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out, 0, false, delay or 0), props)
	tw:Play()
	return tw
end

function UI.scale(obj: Instance): UIScale
	local s = obj:FindFirstChildOfClass("UIScale")
	if not s then
		s = UI.new("UIScale", { Scale = 1 }, obj)
	end
	return s :: UIScale
end

function UI.pop(obj: Instance, from: number?, t: number?)
	local s = UI.scale(obj)
	s.Scale = from or 0.6
	UI.tween(s, t or 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- glassy panel
function UI.panel(props: { [string]: any }, parent: Instance?): Frame
	local f = UI.new("Frame", { BackgroundColor3 = UI.C.bg, BackgroundTransparency = 0.06, BorderSizePixel = 0 }, nil)
	for k, v in props do
		(f :: any)[k] = v
	end
	UI.corner(f, 16)
	UI.stroke(f, 2, UI.C.line, 0.25)
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 210)),
		Rotation = 90,
	}, f)
	if parent then
		f.Parent = parent
	end
	return f
end

function UI.text(props: { [string]: any }, parent: Instance?): TextLabel
	local t = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = UI.BOLD,
		TextColor3 = UI.C.text,
		TextSize = 18,
		Text = "",
	}, nil)
	for k, v in props do
		(t :: any)[k] = v
	end
	if parent then
		t.Parent = parent
	end
	return t
end

-- big friendly animated button
function UI.button(parent: Instance, o: { [string]: any }): TextButton
	local color: Color3 = o.color or UI.C.pink
	local b = UI.new("TextButton", {
		Name = o.name or "Button",
		Size = o.size or UDim2.fromOffset(160, 48),
		Position = o.position or UDim2.new(),
		AnchorPoint = o.anchor or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = o.order or 0,
		ZIndex = o.z or 1,
	}, parent)
	UI.corner(b, o.radius or 14)
	local st = UI.stroke(b, 2, color:Lerp(Color3.new(1, 1, 1), 0.45), 0.1)
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 205)),
		Rotation = 90,
	}, b)
	-- bottom "lip" for a chunky 3D feel
	local lip = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 1, -3),
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.45),
		BorderSizePixel = 0,
		ZIndex = (o.z or 1) - 1,
	}, b)
	UI.corner(lip, o.radius or 14)
	local label = UI.text({
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		Text = (if o.icon then o.icon .. "  " else "") .. (o.text or ""),
		FontFace = o.font or UI.TITLE,
		TextSize = o.textSize or 22,
		TextColor3 = o.textColor or Color3.new(1, 1, 1),
		ZIndex = (o.z or 1) + 1,
	}, b)
	UI.textStroke(label, 2, color:Lerp(Color3.new(0, 0, 0), 0.6))
	local sc = UI.scale(b)
	b.MouseEnter:Connect(function()
		UI.tween(sc, 0.15, { Scale = 1.05 }, Enum.EasingStyle.Back)
		UI.tween(st, 0.15, { Transparency = 0 })
		UI.hover()
	end)
	b.MouseLeave:Connect(function()
		UI.tween(sc, 0.15, { Scale = 1 })
		UI.tween(st, 0.15, { Transparency = 0.1 })
	end)
	b.MouseButton1Down:Connect(function()
		UI.tween(sc, 0.08, { Scale = 0.93 })
	end)
	b.MouseButton1Up:Connect(function()
		UI.tween(sc, 0.2, { Scale = 1.05 }, Enum.EasingStyle.Back)
	end)
	if o.onClick then
		b.Activated:Connect(function()
			UI.click()
			o.onClick()
		end)
	end
	return b
end

function UI.setButton(b: TextButton, text: string?, color: Color3?)
	local label = b:FindFirstChild("Label") :: TextLabel?
	if label and text then
		label.Text = text
	end
	if color then
		b.BackgroundColor3 = color
		local lip = b:FindFirstChildOfClass("Frame")
		if lip then
			lip.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.45)
		end
		local st = b:FindFirstChildOfClass("UIStroke")
		if st then
			st.Color = color:Lerp(Color3.new(1, 1, 1), 0.45)
		end
	end
end

-- endless shimmer across a gui object (rarity labels, legendary cards)
function UI.shimmer(obj: GuiObject, colors: { Color3 }, speed: number?): UIGradient
	local kp = {}
	for i, c in colors do
		table.insert(kp, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), c))
	end
	local g = UI.new("UIGradient", { Color = ColorSequence.new(kp), Rotation = 20 }, obj)
	local s = speed or 0.6
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if not g.Parent then
			conn:Disconnect()
			return
		end
		local t = (os.clock() * s) % 2
		g.Offset = Vector2.new(t - 1, 0)
	end)
	return g
end

-- spinning sunburst rays behind something special
function UI.rays(parent: GuiObject, color: Color3, count: number?, z: number?): Frame
	local holder = UI.new("Frame", {
		Size = UDim2.fromScale(2.2, 2.2),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = z or 0,
	}, parent)
	-- GUI rotation pivots around an object's center, so each ray is a full bar through
	-- the middle (one bar = two opposite rays)
	local n = math.max(1, math.floor((count or 12) / 2))
	for i = 1, n do
		local ray = UI.new("Frame", {
			Size = UDim2.new(0, 56, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Rotation = (i - 1) * (180 / n),
			ZIndex = z or 0,
		}, holder)
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) }),
			Rotation = 90,
		}, ray)
	end
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function(dt)
		if not holder.Parent then
			conn:Disconnect()
			return
		end
		holder.Rotation = (holder.Rotation + dt * 25) % 360
	end)
	return holder
end

-------------------------------------------------------------------------------
-- toasts

local toastHolder: Frame? = nil

function UI.toasts(parent: Instance)
	local h = UI.new("Frame", {
		Name = "Toasts",
		Size = UDim2.new(0, 520, 0, 300),
		Position = UDim2.new(0.5, 0, 0, 132),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 50,
	}, parent)
	UI.list(h, false, 6, Enum.HorizontalAlignment.Center)
	toastHolder = h
end

function UI.toast(text: string, color: Color3?, life: number?, rich: boolean?): Frame?
	local h = toastHolder
	if not h then
		return nil
	end
	local col = color or UI.C.cyan
	local f = UI.new("Frame", {
		Size = UDim2.new(0, 0, 0, 42),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = UI.C.bg,
		BackgroundTransparency = 0.05,
		LayoutOrder = math.floor(os.clock() * 100),
		ZIndex = 50,
	}, h)
	UI.corner(f, 21)
	UI.stroke(f, 2, col, 0)
	UI.pad(f, 0, 18)
	local t = UI.text({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = text,
		RichText = rich == true,
		TextSize = 19,
		FontFace = UI.HEAVY,
		TextColor3 = col:Lerp(Color3.new(1, 1, 1), 0.35),
		ZIndex = 51,
	}, f)
	UI.textStroke(t, 1.5)
	UI.pop(f, 0.5)
	task.delay(life or 3, function()
		if f.Parent then
			UI.tween(f, 0.3, { BackgroundTransparency = 1 })
			UI.tween(t, 0.3, { TextTransparency = 1 })
			local st = f:FindFirstChildOfClass("UIStroke")
			if st then
				UI.tween(st, 0.3, { Transparency = 1 })
			end
			task.wait(0.32)
			f:Destroy()
		end
	end)
	return f
end

-------------------------------------------------------------------------------
-- windows

export type Window = { frame: Frame, body: Frame, close: () -> (), title: TextLabel }

function UI.window(parent: Instance, title: string, size: UDim2, accent: Color3?, onClose: (() -> ())?): Window
	local acc = accent or UI.C.pink
	local f = UI.panel({
		Name = title,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 20,
	}, parent)
	local bar = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = acc, BorderSizePixel = 0, ZIndex = 21 }, f)
	UI.corner(bar, 16)
	UI.new("Frame", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16), BackgroundColor3 = acc, BorderSizePixel = 0, ZIndex = 21 }, bar)
	UI.gradient(bar, Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 170), 90)
	local tl = UI.text({ Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(20, 0), Text = title, FontFace = UI.TITLE, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 22 }, bar)
	UI.textStroke(tl, 3, acc:Lerp(Color3.new(0, 0, 0), 0.6))
	local body = UI.new("Frame", { Name = "Body", Size = UDim2.new(1, -28, 1, -72), Position = UDim2.fromOffset(14, 64), BackgroundTransparency = 1, ZIndex = 21 }, f)
	local function close()
		UI.tween(UI.scale(f), 0.15, { Scale = 0.85 })
		task.delay(0.15, function()
			f.Visible = false
			UI.scale(f).Scale = 1
		end)
		if onClose then
			onClose()
		end
	end
	UI.button(bar, {
		text = "✕",
		size = UDim2.fromOffset(40, 40),
		position = UDim2.new(1, -48, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		color = UI.C.red,
		textSize = 22,
		z = 23,
		onClick = close,
	})
	-- drag by the title bar
	local dragging, start, origin = false, Vector2.zero, UDim2.new()
	bar.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			start = Vector2.new(io.Position.X, io.Position.Y)
			origin = f.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(io)
		if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
			local d = Vector2.new(io.Position.X, io.Position.Y) - start
			f.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	f.Visible = false
	return { frame = f, body = body, close = close, title = tl }
end

function UI.open(w: Window)
	w.frame.Visible = true
	UI.pop(w.frame, 0.85, 0.3)
end

-- tab strip: returns pages[name]
function UI.tabs(parent: Frame, names: { string }, accent: Color3?): { [string]: ScrollingFrame }
	local acc = accent or UI.C.cyan
	local strip = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, ZIndex = 22 }, parent)
	UI.list(strip, true, 6)
	local pages: { [string]: ScrollingFrame } = {}
	local buttons: { [string]: TextButton } = {}
	local function select(name: string)
		for n, p in pages do
			p.Visible = n == name
			UI.setButton(buttons[n], nil, if n == name then acc else UI.C.bg2)
		end
	end
	for i, n in names do
		buttons[n] = UI.button(strip, {
			text = n,
			size = UDim2.fromOffset(math.max(96, #n * 13 + 30), 36),
			color = UI.C.bg2,
			textSize = 17,
			order = i,
			z = 23,
			onClick = function()
				select(n)
			end,
		})
		local page = UI.new("ScrollingFrame", {
			Name = n,
			Size = UDim2.new(1, 0, 1, -50),
			Position = UDim2.fromOffset(0, 50),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = acc,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			ZIndex = 22,
		}, parent)
		UI.list(page, false, 8)
		UI.pad(page, 4)
		pages[n] = page
	end
	select(names[1])
	return pages
end

function UI.section(parent: Instance, title: string, order: number): Frame
	local f = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UI.C.bg2, BackgroundTransparency = 0.3, LayoutOrder = order, ZIndex = 22 }, parent)
	UI.corner(f, 12)
	UI.pad(f, 10)
	UI.list(f, false, 8)
	local t = UI.text({ Size = UDim2.new(1, 0, 0, 22), Text = title, FontFace = UI.HEAVY, TextSize = 18, TextColor3 = UI.C.gold, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = -1, ZIndex = 23 }, f)
	UI.textStroke(t, 1.5)
	return f
end

function UI.row(parent: Instance, order: number?): Frame
	local r = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = order or 0, ZIndex = 22 }, parent)
	UI.list(r, true, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	return r
end

function UI.toggle(parent: Instance, label: string, value: boolean, onChange: (boolean) -> (), order: number?): Frame
	local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, LayoutOrder = order or 0, ZIndex = 22 }, parent)
	UI.text({ Size = UDim2.new(1, -80, 1, 0), Text = label, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23 }, row)
	local track = UI.new("TextButton", { Size = UDim2.fromOffset(62, 32), Position = UDim2.new(1, -62, 0.5, -16), BackgroundColor3 = if value then UI.C.green else UI.C.bg2, Text = "", AutoButtonColor = false, ZIndex = 23 }, row)
	UI.round(track)
	UI.stroke(track, 2, UI.C.line, 0.3)
	local knob = UI.new("Frame", { Size = UDim2.fromOffset(26, 26), Position = if value then UDim2.new(1, -29, 0.5, -13) else UDim2.new(0, 3, 0.5, -13), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 24 }, track)
	UI.round(knob)
	local v = value
	track.Activated:Connect(function()
		v = not v
		UI.click()
		UI.tween(knob, 0.2, { Position = if v then UDim2.new(1, -29, 0.5, -13) else UDim2.new(0, 3, 0.5, -13) }, Enum.EasingStyle.Back)
		UI.tween(track, 0.2, { BackgroundColor3 = if v then UI.C.green else UI.C.bg2 })
		onChange(v)
	end)
	return row
end

function UI.slider(parent: Instance, label: string, min: number, max: number, value: number, onChange: (number) -> (), fmt: ((number) -> string)?, order: number?): Frame
	local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, LayoutOrder = order or 0, ZIndex = 22 }, parent)
	local lbl = UI.text({ Size = UDim2.new(1, 0, 0, 20), TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23 }, row)
	local track = UI.new("Frame", { Size = UDim2.new(1, -10, 0, 10), Position = UDim2.new(0, 5, 0, 32), BackgroundColor3 = UI.C.bg2, ZIndex = 23 }, row)
	UI.round(track)
	local fill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UI.C.cyan, ZIndex = 24 }, track)
	UI.round(fill)
	local knob = UI.new("Frame", { Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 25 }, track)
	UI.round(knob)
	UI.stroke(knob, 2, UI.C.cyan)
	local function set(v: number, fire: boolean)
		v = math.clamp(v, min, max)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		lbl.Text = label .. ":  " .. (if fmt then fmt(v) else string.format("%.2f", v))
		if fire then
			onChange(v)
		end
	end
	set(value, false)
	local dragging = false
	local function fromX(x: number)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		set(min + (max - min) * a, true)
	end
	track.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(io.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(io)
		if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
			fromX(io.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return row
end

-------------------------------------------------------------------------------
-- misc

function UI.fmt(n: number): string
	local s = tostring(math.floor(n))
	local neg = string.sub(s, 1, 1) == "-"
	if neg then
		s = string.sub(s, 2)
	end
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return (if neg then "-" else "") .. out
end

function UI.coin(parent: Instance, size: number, z: number?): Frame
	local c = UI.new("Frame", { Size = UDim2.fromOffset(size, size), BackgroundColor3 = UI.C.gold, ZIndex = z or 1 }, parent)
	UI.round(c)
	UI.stroke(c, math.max(1, size / 12), Color3.fromRGB(200, 140, 30))
	local inner = UI.new("Frame", { Size = UDim2.fromScale(0.62, 0.62), Position = UDim2.fromScale(0.19, 0.19), BackgroundColor3 = Color3.fromRGB(255, 230, 150), ZIndex = (z or 1) + 1 }, c)
	UI.round(inner)
	UI.text({ Size = UDim2.fromScale(1, 1), Text = "★", TextSize = size * 0.5, TextColor3 = Color3.fromRGB(210, 150, 30), FontFace = UI.HEAVY, ZIndex = (z or 1) + 2 }, inner)
	return c
end

function UI.thumb(userId: number, image: ImageLabel)
	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok and content and image.Parent then
			image.Image = content
		end
	end)
end

-- count a label up/down to a number
function UI.countTo(label: TextLabel, from: number, to: number, t: number, prefix: string?)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - start) / t, 0, 1)
		a = 1 - (1 - a) ^ 3
		label.Text = (prefix or "") .. UI.fmt(from + (to - from) * a)
		if a >= 1 then
			conn:Disconnect()
		end
	end)
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="44">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">165</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>