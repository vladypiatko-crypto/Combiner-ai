			{ x = -40, y = 10, w = 9, h = 1.5, style = "ledge", depth = 10 },
			{ x = 41, y = 1, w = 6, h = 6, style = "crate", depth = 8 },
			{ x = -22, y = 1.25, w = 3, h = 2.5, style = "crate", depth = 4 },
