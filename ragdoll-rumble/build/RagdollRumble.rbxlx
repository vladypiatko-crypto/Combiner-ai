      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Motion</string>
          <string name="Source"><![CDATA[--!strict
-- Time-driven motion for moving platforms / saws. Pure math so the server (physics) and
-- every client (visuals, hazards) agree exactly when given the same round time.

local Motion = {}

local sin, cos, pi = math.sin, math.cos, math.pi

-- returns x, y, angle (radians, about Z)
function Motion.pose(m: any?, bx: number, by: number, ba: number, t: number): (number, number, number)
	if not m then
		return bx, by, ba
	end
	local period = m.period or 4
	local w = 2 * pi / period
	local ph = m.phase or 0
	if m.type == "sine" then
		local k = sin(t * w + ph)
		return bx + (m.ax or 0) * k, by + (m.ay or 0) * k, ba
	elseif m.type == "orbit" then
		local a = t * w + ph
		local r = m.radius or 10
		return (m.cx or bx) + cos(a) * r, (m.cy or by) + sin(a) * r, ba
	elseif m.type == "pendulum" then
		local th = (m.amp or 0.5) * sin(t * w + ph)
		local len = m.len or 10
		return (m.px or bx) + sin(th) * len, (m.py or by) - cos(th) * len, ba
	elseif m.type == "spin" then
		return bx, by, ba + (m.speed or 1) * t
	end
	return bx, by, ba
end

return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Remote events (created by the server, awaited by clients).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local function get(name: string, className: string): any
	local folder = ReplicatedStorage:FindFirstChild("RumbleRemotes")
	if RunService:IsServer() then
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "RumbleRemotes"
			folder.Parent = ReplicatedStorage
		end
		local r = (folder :: Instance):FindFirstChild(name)
		if not r then
			r = Instance.new(className)
			r.Name = name
			r.Parent = folder
		end
		return r
	end
	folder = ReplicatedStorage:WaitForChild("RumbleRemotes")
	return (folder :: Instance):WaitForChild(name)
end

-- reliable game events (both directions), tables with a `t` field
Remotes.Event = get("Event", "RemoteEvent") :: RemoteEvent
-- unreliable aim / flag stream (both directions)
Remotes.State = get("State", "UnreliableRemoteEvent") :: UnreliableRemoteEvent
-- request / response for menus (crate rolls, equipping, admin actions)
Remotes.Request = get("Request", "RemoteFunction") :: RemoteFunction

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rig</string>
          <string name="Source"><![CDATA[--!strict
-- Character rig helpers: ragdoll joints, facing / knockback movers, plane lock.
-- Works on any Humanoid rig (players' own R15 avatars and the bot mannequins).

local Rig = {}

-- ragdoll cone limits per joint (degrees)
local LIMITS: { [string]: { number } } = {
	Neck = { 40, 35 },
	Waist = { 30, 30 },
	LeftShoulder = { 110, 70 },
	RightShoulder = { 110, 70 },
	LeftElbow = { 100, 10 },
	RightElbow = { 100, 10 },
	LeftWrist = { 35, 20 },
	RightWrist = { 35, 20 },
	LeftHip = { 85, 30 },
	RightHip = { 85, 30 },
	LeftKnee = { 100, 10 },
	RightKnee = { 100, 10 },
	LeftAnkle = { 35, 15 },
	RightAnkle = { 35, 15 },
	-- R6 names
	["Left Shoulder"] = { 110, 70 },
	["Right Shoulder"] = { 110, 70 },
	["Left Hip"] = { 85, 30 },
	["Right Hip"] = { 85, 30 },
}

function Rig.motors(model: Model): { [string]: Motor6D }
	local out = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			out[d.Name] = d
		end
	end
	return out
end

local function isRootJoint(m: Motor6D): boolean
	return m.Name == "Root" or m.Name == "RootJoint"
end

-- server: add (disabled) ragdoll sockets + movers to a freshly spawned character
function Rig.setup(model: Model)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.AutoRotate = false

	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d:SetAttribute("BaseCollide", d.CanCollide)
		end
		if d:IsA("Motor6D") and not isRootJoint(d) and d.Part0 and d.Part1 then
			local a0 = Instance.new("Attachment")
			a0.Name = "Rag0_" .. d.Name
			a0.CFrame = d.C0
			a0.Parent = d.Part0
			local a1 = Instance.new("Attachment")
			a1.Name = "Rag1_" .. d.Name
			a1.CFrame = d.C1
			a1.Parent = d.Part1
			local lim = LIMITS[d.Name] or { 45, 30 }
			local s = Instance.new("BallSocketConstraint")
			s.Name = "Rag_" .. d.Name
			s.Attachment0 = a0
			s.Attachment1 = a1
			s.LimitsEnabled = true
			s.UpperAngle = lim[1]
			s.TwistLimitsEnabled = true
			s.TwistLowerAngle = -lim[2]
			s.TwistUpperAngle = lim[2]
			s.Restitution = 0.1
			s.Enabled = false
			s.Parent = d.Parent
			local nc = Instance.new("NoCollisionConstraint")
			nc.Name = "RagNC_" .. d.Name
			nc.Part0 = d.Part0
			nc.Part1 = d.Part1
			nc.Parent = d.Parent
		end
	end

	local att = Instance.new("Attachment")
	att.Name = "RumbleAttachment"
	att.Parent = root

	local facing = Instance.new("AlignOrientation")
	facing.Name = "Facing"
	facing.Mode = Enum.OrientationAlignmentMode.OneAttachment
	facing.Attachment0 = att
	facing.MaxTorque = 1e7
	facing.Responsiveness = 60
	facing.CFrame = CFrame.Angles(0, -math.pi / 2, 0)
	facing.Parent = root

	local knock = Instance.new("LinearVelocity")
	knock.Name = "Knock"
	knock.Attachment0 = att
	knock.MaxForce = 1e7
	knock.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	knock.RelativeTo = Enum.ActuatorRelativeTo.World
	knock.VectorVelocity = Vector3.zero
	knock.Enabled = false
	knock.Parent = root
end

-- server: switch ragdoll on / off (replicates to everyone)
function Rig.setRagdoll(model: Model, on: boolean)
	if model:GetAttribute("Ragdoll") == on then
		return
	end
	model:SetAttribute("Ragdoll", on)
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and not isRootJoint(d) then
			d.Enabled = not on
		elseif d:IsA("BallSocketConstraint") and string.sub(d.Name, 1, 4) == "Rag_" then
			d.Enabled = on
		end
	end
	-- only the body parts themselves collide while floppy (not hats / weapons)
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") then
			if on and d.Name == "HumanoidRootPart" then
				d.CanCollide = false
			elseif on then
				d.CanCollide = true
			else
				d.CanCollide = d:GetAttribute("BaseCollide") == true
			end
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		local facing = root:FindFirstChild("Facing") :: AlignOrientation?
		if facing then
			facing.Enabled = not on
		end
	end
end

-- facing: +1 = looking toward +X (screen right), -1 = toward -X
function Rig.facingCFrame(facing: number): CFrame
	return CFrame.Angles(0, if facing > 0 then -math.pi / 2 else math.pi / 2, 0)
end

-- owner side: keep the whole body on the Z = 0 plane
function Rig.lockPlane(model: Model, root: BasePart, parts: { BasePart }?)
	local p = root.Position
	if math.abs(p.Z) > 0.04 then
		model:PivotTo(model:GetPivot() + Vector3.new(0, 0, -p.Z))
	end
	if parts then
		for _, part in parts do
			local v = part.AssemblyLinearVelocity
			if math.abs(v.Z) > 0.05 then
				part.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, v.Z * 0.3)
			end
		end
	else
		local v = root.AssemblyLinearVelocity
		if math.abs(v.Z) > 0.05 then
			root.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, 0)
		end
	end
end

function Rig.bodyParts(model: Model): { BasePart }
	local out = {}
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") then
			table.insert(out, d)
		end
	end
	return out
end

-- owner side: throw every body part (used when a ragdoll starts)
function Rig.fling(model: Model, vel: Vector3, spin: number)
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = vel + Vector3.new((math.random() - 0.5) * 6, (math.random() - 0.5) * 6, 0)
			d.AssemblyAngularVelocity = Vector3.new(0, 0, spin + (math.random() - 0.5) * 4)
		end
	end
end

return Rig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
-- Small math helpers + a deterministic PRNG (no Roblox APIs so tests can run anywhere).

local Util = {}

local sqrt, atan2, cos, sin, floor = math.sqrt, math.atan2, math.cos, math.sin, math.floor

function Util.clamp(x: number, a: number, b: number): number
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Util.len(x: number, y: number): number
	return sqrt(x * x + y * y)
end

function Util.norm(x: number, y: number): (number, number, number)
	local l = sqrt(x * x + y * y)
	if l < 1e-9 then
		return 0, 0, 0
	end
	return x / l, y / l, l
end

function Util.angle(x: number, y: number): number
	return atan2(y, x)
end

function Util.dir(a: number): (number, number)
	return cos(a), sin(a)
end

function Util.sign(x: number): number
	if x > 0 then
		return 1
	elseif x < 0 then
		return -1
	end
	return 0
end

-- wrap angle to (-pi, pi]
function Util.wrap(a: number): number
	a = (a + math.pi) % (2 * math.pi)
	if a < 0 then
		a += 2 * math.pi
	end
	return a - math.pi
end

-- distance from point P to segment AB, plus closest point and parameter t
function Util.pointSegment(px: number, py: number, ax: number, ay: number, bx: number, by: number): (number, number, number, number)
	local abx, aby = bx - ax, by - ay
	local l2 = abx * abx + aby * aby
	local t = 0
	if l2 > 1e-9 then
		t = Util.clamp(((px - ax) * abx + (py - ay) * aby) / l2, 0, 1)
	end
	local cx, cy = ax + abx * t, ay + aby * t
	local dx, dy = px - cx, py - cy
	return sqrt(dx * dx + dy * dy), cx, cy, t
end

-- ray (origin + dir * s, s in [0, maxS]) vs circle. returns s or nil
function Util.rayCircle(ox: number, oy: number, dx: number, dy: number, maxS: number, cx: number, cy: number, r: number): number?
	local fx, fy = ox - cx, oy - cy
	local b = fx * dx + fy * dy
	local c = fx * fx + fy * fy - r * r
	if c <= 0 then
		return 0
	end
	if b > 0 then
		return nil
	end
	local disc = b * b - c
	if disc < 0 then
		return nil
	end
	local s = -b - sqrt(disc)
	if s < 0 or s > maxS then
		return nil
	end
	return s
end

-- ray vs capsule (segment AB with radius r): approximated by sampling the closest approach
function Util.rayCapsule(ox: number, oy: number, dx: number, dy: number, maxS: number, ax: number, ay: number, bx: number, by: number, r: number): number?
	-- solve closest points between the ray segment and AB
	local ex, ey = ox + dx * maxS, oy + dy * maxS
	-- segment-segment closest distance using parametric clamp
	local ux, uy = ex - ox, ey - oy
	local vx, vy = bx - ax, by - ay
	local wx, wy = ox - ax, oy - ay
	local a = ux * ux + uy * uy
	local b = ux * vx + uy * vy
	local c = vx * vx + vy * vy
	local d = ux * wx + uy * wy
	local e = vx * wx + vy * wy
	local D = a * c - b * b
	local sc, tc
	if D < 1e-9 then
		sc = 0
		tc = if c > 1e-9 then Util.clamp(e / c, 0, 1) else 0
	else
		sc = Util.clamp((b * e - c * d) / D, 0, 1)
		tc = if c > 1e-9 then Util.clamp((b * sc + e) / c, 0, 1) else 0
		-- recompute sc for the clamped tc
		sc = if a > 1e-9 then Util.clamp((tc * b - d) / a, 0, 1) else 0
	end
	local px, py = ox + ux * sc, oy + uy * sc
	local qx, qy = ax + vx * tc, ay + vy * tc
	local ddx, ddy = px - qx, py - qy
	if ddx * ddx + ddy * ddy > r * r then
		return nil
	end
	-- step back to the surface roughly: hit distance along ray
	return math.max(0, sc * maxS - r * 0.5)
end

-- xorshift32 PRNG -------------------------------------------------------------
export type Rng = { state: number, next: (Rng) -> number, range: (Rng, number, number) -> number, int: (Rng, number, number) -> number }

local function rngNext(self: Rng): number
	local x = self.state
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self.state = x
	return x / 4294967296
end

local function rngRange(self: Rng, a: number, b: number): number
	return a + (b - a) * rngNext(self)
end

local function rngInt(self: Rng, a: number, b: number): number
	return a + floor(rngNext(self) * (b - a + 1))
end

function Util.rng(seed: number): Rng
	local s = floor(seed) % 4294967296
	if s == 0 then
		s = 0x9E3779B9
	end
	return { state = s, next = rngNext, range = rngRange, int = rngInt }
end

function Util.hexToRGB(hex: number): (number, number, number)
	return bit32.rshift(hex, 16) % 256, bit32.rshift(hex, 8) % 256, hex % 256
end

function Util.shuffle<T>(list: { T }, rng: Rng): { T }
	for i = #list, 2, -1 do
		local j = rng:int(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- silence unused warnings for helpers only used in some builds
local _ = cos
local _ = sin

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!strict
-- Weapon definitions. Models are built from boxes in weapon space:
-- +X = barrel / blade direction, +Y = up, origin = the grip (held in the right hand).

export type Part = { x: number, y: number, z: number?, w: number, h: number, d: number?, color: number, neon: boolean?, shape: string? }

export type Weapon = {
	id: number,
	key: string,
	name: string,
	kind: string, -- "gun" | "melee" | "throwable" | "launcher"
	weight: number,
	ammo: number,
	rate: number,
	auto: boolean,
	pellets: number,
	spread: number,
	range: number,
	speed: number,
	damage: number,
	knock: number,
	ragdoll: number,
	recoil: number,
	twoHanded: boolean,
	length: number,
	swingTime: number,
	deflect: boolean,
	fuse: number,
	radius: number,
	headMult: number,
	sound: string,
	tracer: number,
	parts: { Part },
}

local Weapons = {}
Weapons.list = {} :: { Weapon }
Weapons.byKey = {} :: { [string]: Weapon }

local function def(w: any)
	w.ammo = w.ammo or 1
	w.rate = w.rate or 0.3
	w.auto = w.auto or false
	w.pellets = w.pellets or 1
	w.spread = w.spread or 0
	w.range = w.range or 140
	w.speed = w.speed or 0
	w.damage = w.damage or 10
	w.knock = w.knock or 15
	w.ragdoll = w.ragdoll or 0
	w.recoil = w.recoil or 0
	w.twoHanded = w.twoHanded or false
	w.length = w.length or 1.2
	w.swingTime = w.swingTime or 0.25
	w.deflect = w.deflect or false
	w.fuse = w.fuse or 0
	w.radius = w.radius or 0
	w.headMult = w.headMult or 1.5
	w.sound = w.sound or "pistol"
	w.tracer = w.tracer or 0xfff4aa
	w.weight = w.weight or 1
	table.insert(Weapons.list, w)
	w.id = #Weapons.list
	Weapons.byKey[w.key] = w
end

local METAL = 0x2b2f3a
local DARK = 0x16181f
local WOOD = 0x9a6233

def({
	key = "popper",
	name = "Popper",
	kind = "gun",
	weight = 1.3,
	ammo = 10,
	rate = 0.2,
	damage = 20,
	knock = 26,
	spread = 0.015,
	recoil = 6,
	length = 1.5,
	sound = "pistol",
	parts = {
		{ x = 0.55, y = 0.15, w = 1.4, h = 0.42, d = 0.32, color = METAL },
		{ x = 0.05, y = -0.25, w = 0.36, h = 0.7, d = 0.3, color = DARK },
		{ x = 1.15, y = 0.15, w = 0.2, h = 0.26, d = 0.34, color = 0xffd34d, neon = true },
	},
})

def({
	key = "scatter",
	name = "Scattergun",
	kind = "gun",
	weight = 1,
	ammo = 4,
	rate = 0.7,
	pellets = 7,
	spread = 0.2,
	range = 42,
	damage = 11,
	knock = 32,
	recoil = 48,
	twoHanded = true,
	length = 2.6,
	sound = "shotgun",
	tracer = 0xffc86b,
	parts = {
		{ x = 1.1, y = 0.12, w = 2.8, h = 0.4, d = 0.36, color = METAL },
		{ x = 1.3, y = -0.18, w = 1.3, h = 0.3, d = 0.4, color = WOOD },
		{ x = -0.6, y = -0.05, w = 1.1, h = 0.5, d = 0.34, color = WOOD },
	},
})

def({
	key = "buzzer",
	name = "Buzzer",
	kind = "gun",
	weight = 1,
	ammo = 34,
	rate = 0.075,
	auto = true,
	damage = 6,
	knock = 11,
	spread = 0.08,
	recoil = 3,
	twoHanded = true,
	length = 2,
	sound = "smg",
	tracer = 0x7df9ff,
	parts = {
		{ x = 0.7, y = 0.12, w = 2, h = 0.46, d = 0.36, color = DARK },
		{ x = 0.4, y = -0.42, w = 0.3, h = 0.75, d = 0.3, color = METAL },
		{ x = -0.45, y = 0.05, w = 0.6, h = 0.36, d = 0.3, color = METAL },
		{ x = 1.6, y = 0.12, w = 0.22, h = 0.24, d = 0.38, color = 0x3cf2e0, neon = true },
	},
})

def({
	key = "longshot",
	name = "Longshot",
	kind = "gun",
	weight = 0.7,
	ammo = 3,
	rate = 1.0,
	damage = 95,
	knock = 85,
	ragdoll = 1.6,
	range = 400,
	recoil = 30,
	twoHanded = true,
	length = 3.6,
	sound = "sniper",
	tracer = 0xff4d5e,
	parts = {
		{ x = 1.5, y = 0.1, w = 4, h = 0.3, d = 0.3, color = DARK },
		{ x = 0.7, y = 0.5, w = 1.1, h = 0.3, d = 0.3, color = METAL, shape = "cyl" },
		{ x = -0.6, y = -0.02, w = 1.1, h = 0.52, d = 0.34, color = 0x3d4a5e },
		{ x = 3.45, y = 0.1, w = 0.2, h = 0.2, d = 0.32, color = 0xff4d5e, neon = true },
	},
})

def({
	key = "edge",
	name = "Edge",
	kind = "melee",
	weight = 1,
	rate = 0.4,
	swingTime = 0.22,
	damage = 38,
	knock = 48,
	ragdoll = 0.8,
	length = 3.6,
	deflect = true,
	sound = "slash",
	parts = {
		{ x = 2.05, y = 0, w = 3.2, h = 0.28, d = 0.12, color = 0xdfe8ff, neon = true },
		{ x = 0.3, y = 0, w = 0.2, h = 0.95, d = 0.35, color = 0xffc93c },
		{ x = -0.1, y = 0, w = 0.75, h = 0.24, d = 0.24, color = DARK },
	},
})

def({
	key = "bonker",
	name = "Bonker",
	kind = "melee",
	weight = 1,
	rate = 0.6,
	swingTime = 0.3,
	damage = 18,
	knock = 125,
	ragdoll = 1.8,
	length = 3.4,
	sound = "bonk",
	parts = {
		{ x = 0.7, y = 0, w = 1.9, h = 0.32, d = 0.32, color = WOOD, shape = "cyl" },
		{ x = 2.4, y = 0, w = 1.7, h = 0.62, d = 0.62, color = 0xc07a3f, shape = "cyl" },
	},
})

def({
	key = "fizz",
	name = "Fizzbomb",
	kind = "throwable",
	weight = 0.9,
	ammo = 3,
	rate = 0.65,
	speed = 75,
	fuse = 1.8,
	radius = 11,
	damage = 60,
	knock = 120,
	ragdoll = 1.8,
	length = 0.8,
	sound = "throw",
	parts = {
		{ x = 0.15, y = 0, w = 0.9, h = 0.9, d = 0.9, color = 0x2f9e44, shape = "ball" },
		{ x = 0.15, y = 0.55, w = 0.3, h = 0.25, d = 0.3, color = 0xffd34d, neon = true },
	},
})

def({
	key = "boomtube",
	name = "Boomtube",
	kind = "launcher",
	weight = 0.6,
	ammo = 2,
	rate = 0.9,
	speed = 95,
	radius = 10,
	damage = 70,
	knock = 130,
	ragdoll = 2,
	recoil = 34,
	twoHanded = true,
	length = 3.2,
	sound = "rocket",
	parts = {
		{ x = 0.9, y = 0.2, w = 3.4, h = 0.75, d = 0.75, color = 0x4c6b3a, shape = "cyl" },
		{ x = 2.65, y = 0.2, w = 0.3, h = 0.9, d = 0.9, color = DARK, shape = "cyl" },
		{ x = 0.3, y = -0.4, w = 0.3, h = 0.6, d = 0.3, color = DARK },
		{ x = -0.85, y = 0.2, w = 0.2, h = 0.6, d = 0.6, color = 0xff8f3c, neon = true },
	},
})

-- thrown weapon hitting someone
Weapons.THROWN = { damage = 16, knock = 60, ragdoll = 1.0 }

function Weapons.get(id: number?): Weapon?
	if id == nil or id == 0 then
		return nil
	end
	return Weapons.list[id]
end

function Weapons.pick(r: number): Weapon
	local total = 0
	for _, w in Weapons.list do
		total += w.weight
	end
	local x = r * total
	for _, w in Weapons.list do
		x -= w.weight
		if x <= 0 then
			return w
		end
	end
	return Weapons.list[1]
end

-- deterministic pellet directions so every client draws the same spread
function Weapons.angles(w: Weapon, aim: number, seed: number): { number }
	local out = {}
	local s = seed
	for i = 1, w.pellets do
		-- small LCG constants keep every product exact in doubles (identical on all machines)
		s = (s * 1664525 + 1013904223) % 4294967296
		local r = s / 4294967296 - 0.5
		if w.pellets > 1 then
			out[i] = aim + ((i - 0.5) / w.pellets - 0.5) * 2 * w.spread + r * w.spread * 0.3
		else
			out[i] = aim + r * 2 * w.spread
		end
	end
	return out
end

return Weapons
]]></string>
        </Properties>
